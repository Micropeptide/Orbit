#!/usr/bin/env python3
"""Claude Code hook that makes a lead model actually use delegation (see bin/delegate.py).

  delegation-hook prompt <eagerness>        UserPromptSubmit: put the triage rule in front of every new request
  delegation-hook tool <state-file> <at>    PostToolUse: after <at> direct tool calls in a row, remind the lead to hand work on

Anything that goes wrong is silent: a hook must never get in the way of the chat."""
import json, os, sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))


def say(event, text):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": event, "additionalContext": text}}))


def main(argv):
    import delegate as D
    try: ev = json.load(sys.stdin)
    except Exception: ev = {}
    kind = argv[1] if len(argv) > 1 else ""
    if kind == "prompt":
        eag = argv[2] if len(argv) > 2 else "high"
        t = D.triage(eag)
        if t: say("UserPromptSubmit", t)
        if len(argv) > 3: _reset(argv[3], ev.get("session_id"))
    elif kind == "tool":
        path, at = argv[2], int(argv[3]) if len(argv) > 3 else D.STREAK_AT
        sid = ev.get("session_id") or "?"
        try: state = json.load(open(path))
        except Exception: state = {}
        k = D.Streak(at); k.n = int(state.get(sid, 0))
        note = k.call(ev.get("tool_name"))
        state[sid] = k.n
        if len(state) > 200: state = dict(list(state.items())[-100:])
        tmp = path + ".tmp"
        with open(tmp, "w") as f: json.dump(state, f)
        os.replace(tmp, path)
        if note: say("PostToolUse", note)


def _reset(path, sid):
    try: state = json.load(open(path))
    except Exception: state = {}
    state[sid or "?"] = 0
    tmp = path + ".tmp"
    with open(tmp, "w") as f: json.dump(state, f)
    os.replace(tmp, path)


if __name__ == "__main__":
    try: main(sys.argv)
    except Exception: pass
