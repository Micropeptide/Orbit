  const MAXEL = 120, MAXTXT = 6000;
  const vw = innerWidth, vh = innerHeight;
  const sel = 'a[href],button,input:not([type=hidden]),select,textarea,summary,[role=button],[role=link],[role=tab],' +
    '[role=menuitem],[role=checkbox],[role=switch],[role=radio],[role=option],[role=textbox],[role=combobox],' +
    '[onclick],[contenteditable=""],[contenteditable="true"]';
  const clean = s => (s || '').replace(/\s+/g, ' ').trim();
  const rectOf = e => {
    const r = e.getBoundingClientRect();
    if (r.width < 1 || r.height < 1) return null;
    const cs = getComputedStyle(e);
    if (cs.visibility === 'hidden' || cs.display === 'none' || +cs.opacity === 0) return null;
    return r;
  };
  const roleOf = e => {
    const t = e.tagName.toLowerCase(), ar = e.getAttribute('role');
    if (ar) return ar;
    if (t === 'a') return 'link';
    if (t === 'button' || t === 'summary') return 'button';
    if (t === 'select') return 'select';
    if (t === 'textarea') return 'textbox';
    if (t === 'input') {
      const ty = (e.type || 'text').toLowerCase();
      if (ty === 'checkbox' || ty === 'radio') return ty;
      if (['submit', 'button', 'reset', 'image'].includes(ty)) return 'button';
      return 'input:' + ty;
    }
    return 'clickable';
  };
  const labelOf = e => {
    let s = e.getAttribute('aria-label') || '';
    if (!s && e.labels && e.labels[0]) s = e.labels[0].innerText;
    if (!s && e.tagName === 'INPUT' && ['submit', 'button', 'reset'].includes(e.type)) s = e.value;
    if (!s && e.tagName !== 'SELECT' && e.tagName !== 'INPUT' && e.tagName !== 'TEXTAREA') s = e.innerText || e.textContent;
    if (!s) s = e.placeholder || e.title || e.alt || e.name || e.id || '';
    return clean(s).slice(0, 80);
  };
  const els = [], seen = new Set();
  const add = (e) => {
    if (seen.has(e)) return;
    const r = rectOf(e); if (!r) return;
    seen.add(e);
    const o = {role: roleOf(e), label: labelOf(e), x: Math.round(r.x), y: Math.round(r.y), w: Math.round(r.width), h: Math.round(r.height), el: e};
    if (e.tagName === 'A') o.href = (e.getAttribute('href') || '').slice(0, 100);
    if (e.tagName === 'SELECT') o.value = clean(Array.from(e.selectedOptions).map(x => x.text).join(', ')).slice(0, 60);
    else if ('value' in e && e.type !== 'checkbox' && e.type !== 'radio' && e.value && !['submit', 'button', 'reset'].includes(e.type))
      o.value = e.type === 'password' ? '(set)' : clean(e.value).slice(0, 60);
    if (e.type === 'checkbox' || e.type === 'radio') o.checked = !!e.checked;
    if (e.disabled) o.disabled = true;
    o.off = r.bottom < 0 ? 'above' : r.top > vh ? 'below' : r.right < 0 ? 'left' : r.left > vw ? 'right' : '';
    els.push(o);
  };
  document.querySelectorAll(sel).forEach(add);
  let scanned = 0;
  for (const e of document.body ? document.body.querySelectorAll('*') : []) {       // pointer-cursor things with no role
    if (++scanned > 3000 || els.length >= MAXEL) break;
    if (seen.has(e) || e.children.length > 6) continue;
    if (getComputedStyle(e).cursor !== 'pointer') continue;
    if (e.parentElement && getComputedStyle(e.parentElement).cursor === 'pointer') continue;
    if (els.some(o => o.el.contains(e) || e.contains(o.el))) continue;
    add(e);
  }
  const total = els.length;
  const kept = els.slice(0, MAXEL);
  window.__orbitLook = kept.map(o => o.el);
  let text = document.body ? (document.body.innerText || '') : '';
  text = text.replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
  const cut = Math.max(0, text.length - MAXTXT);
  if (cut) text = text.slice(0, MAXTXT) + '\n...[' + cut + ' more characters not shown]';
  return {title: document.title, url: location.href, text: text,
          scroll: {x: Math.round(scrollX), y: Math.round(scrollY), w: document.documentElement.scrollWidth, h: document.documentElement.scrollHeight, vw: vw, vh: vh},
          total: total, elements: kept.map(o => { const c = Object.assign({}, o); delete c.el; return c; })};
})()"""

