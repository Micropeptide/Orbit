    return sim_input("drag", device, "Dragged %s,%s to %s,%s." % (fmt_num(x1), fmt_num(y1), fmt_num(x2), fmt_num(y2)),
                     x1=x1, y1=y1, x2=x2, y2=y2, duration=duration)


@tool("simulator_key", "Press a key on the hardware keyboard: return, delete, tab, space, escape, the arrows, a letter or digit; add modifiers (cmd, shift, ctrl, alt) for shortcuts such as cmd+a. Needs AXe. Returns the new screen.",
      {"key": P("string", "return, delete, tab, space, escape, up, down, left, right, or one letter/digit."),
       "modifiers": P("array", "Held while the key is pressed: cmd, shift, ctrl, alt.", items={"type": "string"}),
       "device": P("string", "Device name or UDID; default = the booted simulator.")}, ["key"], timeout=90)
def simulator_key(key, modifiers=None, device=None):
    code = KEYCODES.get(str(key).strip().lower())
    if code is None: raise ToolError("Unknown key %r. Use return, delete, tab, space, escape, up, down, left, right, or one letter or digit." % key)
    mods = []
    for m in modifiers or []:
        if str(m).strip().lower() not in MODIFIERS: raise ToolError("Unknown modifier %r. Use cmd, shift, ctrl or alt." % m)
        mods.append(MODIFIERS[str(m).strip().lower()])
    if mods: return sim_input("key_combo", device, "Pressed %s+%s." % ("+".join(str(m) for m in modifiers), key), modifiers=mods, code=code)
    return sim_input("key", device, "Pressed %s." % key, code=code)


@tool("simulator_gesture", "A common gesture without coordinates: scroll-up/down/left/right, or swipe-from-left-edge (back), -right-edge, -top-edge (notifications), -bottom-edge (home or the app switcher). Needs AXe. Returns the new screen.",
      {"preset": P("string", "One of: " + ", ".join(GESTURES) + "."),
       "device": P("string", "Device name or UDID; default = the booted simulator.")}, ["preset"], timeout=90)
def simulator_gesture(preset, device=None):
    preset = str(preset).strip().lower()
    if preset not in GESTURES: raise ToolError("Unknown gesture %r. Use one of: %s." % (preset, ", ".join(GESTURES)))
    backend, d = input_backend(), booted_device(device)
    rc, out, err = run_cmd(describe_cmd(backend, d["udid"]), timeout=30)       # the gesture needs the screen's size in points
    screen = flatten_ui(out)[1] if rc == 0 else None
    return sim_input("gesture", device, "Did %s." % preset, preset=preset, screen=screen)


@tool("simulator_ui", "The simulator's accessibility tree as text: numbered elements with type, label, id and frame in device points. Needs AXe or idb.",
      {"device": P("string", "Device name or UDID; default = the booted simulator.")}, timeout=60)
def simulator_ui(device=None):
    backend = input_backend()
    d = booted_device(device)
    rc, out, err = run_cmd(describe_cmd(backend, d["udid"]), timeout=30)
    need_ok(rc, out, err, "%s describe" % backend[0])
    lines, screen = flatten_ui(out)
    head = "%s: %s elements%s" % (d["name"], len(lines), ", screen %dx%d points" % screen if screen else "")
    return head + "\n" + "\n".join(lines) if lines else head + "\n(nothing reported; is an app in the foreground?)"


# --------------------------------------------------------------------- Mac windows

WINDOWS_JS = r"""ObjC.import('CoreGraphics');
function run() {
  const arr = ObjC.deepUnwrap(ObjC.castRefToObject($.CGWindowListCopyWindowInfo(
    $.kCGWindowListOptionOnScreenOnly | $.kCGWindowListExcludeDesktopElements, $.kCGNullWindowID)));
  const out = [];
  for (const w of arr) {
    if (w.kCGWindowLayer !== 0) continue;
    const b = w.kCGWindowBounds || {};
    out.push({id: w.kCGWindowNumber, app: w.kCGWindowOwnerName || '', pid: w.kCGWindowOwnerPID, title: w.kCGWindowName || '',
              x: b.X, y: b.Y, w: b.Width, h: b.Height});
  }
  return JSON.stringify(out);
}"""

AX_JS = r"""function run(argv) {
  const se = Application('System Events');
  const procs = se.processes.whose({unixId: parseInt(argv[0])});
  if (!procs.length) return '[]';
  const out = [], t0 = Date.now();
  const walk = (el, depth) => {
    if (out.length >= 80 || depth > 6 || Date.now() - t0 > 5000) return;
    let kids = [];
    try { kids = el.uiElements(); } catch (e) {}
    for (const k of kids) {
      if (out.length >= 80 || Date.now() - t0 > 5000) return;
      let role = '', title = '', desc = '', val = '';
      try { role = String(k.role()); } catch (e) {}
      try { title = String(k.title() || ''); } catch (e) {}
      try { desc = String(k.description() || ''); } catch (e) {}
      try { val = String(k.value() == null ? '' : k.value()); } catch (e) {}
      if (title || val || /button|text|field|checkbox|menu|tab/i.test(role)) out.push([role.replace(/^AX/, ''), title || desc, val.slice(0, 80)]);
      walk(k, depth + 1);
    }
  };
  walk(procs[0].windows[0], 0);
  return JSON.stringify(out);
}"""


def mac_window_list():
    rc, out, err = run_cmd(["osascript", "-l", "JavaScript", "-e", WINDOWS_JS], timeout=20)
    if rc != 0:
        if rc == 127: raise ToolError("osascript is missing; the mac_* tools only work on macOS.")
        raise ToolError("Could not list windows: %s" % tail(err or out))
    try: return json.loads(out)
    except ValueError: raise ToolError("Unreadable window list from macOS: %s" % tail(out, 200))


def select_windows(wins, app=None, title_contains=None, window_id=None):
    out = wins
    if window_id is not None: return [w for w in out if w["id"] == int(window_id)]
    if app: out = [w for w in out if app.lower() in w["app"].lower()]
    if title_contains: out = [w for w in out if title_contains.lower() in w["title"].lower()]
    return [w for w in out if w["w"] >= 20 and w["h"] >= 20]


def fmt_windows(wins):
    if not wins: return "(no on-screen windows)"
    return "\n".join('id=%s app="%s" title="%s" pid=%s bounds=%s,%s %sx%s' % (
        w["id"], w["app"], w["title"], w["pid"], fmt_num(w["x"]), fmt_num(w["y"]), fmt_num(w["w"]), fmt_num(w["h"])) for w in wins)


@tool("mac_windows", "List on-screen Mac windows (frontmost first): app, title, window id, bounds and pid. Titles of other apps' windows need Screen Recording permission.",
      {"app": P("string", "Only windows whose app name contains this (case-insensitive).")}, timeout=30)
def mac_windows(app=None):
    allw = mac_window_list()
    wins = select_windows(allw, app=app)
    if wins: return fmt_windows(wins)
    return "No on-screen window for %r.\nAll windows:\n%s" % (app, fmt_windows(allw)) if app else "(no on-screen windows)"


def bundle_names(path):
    names = {os.path.basename(path.rstrip("/"))[:-4]}
    for key in ("CFBundleName", "CFBundleDisplayName", "CFBundleExecutable"):
        rc, out, _ = run_cmd(["plutil", "-extract", key, "raw", "-o", "-", os.path.join(path, "Contents", "Info.plist")], timeout=10)
        if rc == 0 and out.strip(): names.add(out.strip())
    return names


@tool("mac_launch", "Launch a Mac app (a .app path, or an app name) as a new instance, wait for its window and list it. Use mac_screenshot next.",
      {"app_path_or_name": P("string", "Path to a .app bundle, or an installed app's name."),
       "args": P("array", "Command-line arguments for the app.", items={"type": "string"}),
       "wait_for_window_seconds": P("number", "How long to wait for a window (default 10).")},
      ["app_path_or_name"], timeout=90)
def mac_launch(app_path_or_name, args=None, wait_for_window_seconds=10):
    target = os.path.expanduser(app_path_or_name.strip())
    if target.endswith(".app") or os.path.isdir(target):
        if not os.path.isdir(target): raise ToolError("%s does not exist. Build the app first, or pass its name." % app_path_or_name)
        names = bundle_names(os.path.abspath(target))
        cmd = ["open", "-n", os.path.abspath(target)]
    else:
        names = {target}
        cmd = ["open", "-n", "-a", target]
    if args: cmd += ["--args"] + [str(a) for a in args]
    before = {w["id"] for w in mac_window_list()}
    rc, out, err = run_cmd(cmd, timeout=30)
    if rc != 0:
        raise ToolError("Could not launch %s: %s" % (app_path_or_name, tail(err or out) or "open failed"))
    end = time.time() + max(0.0, min(float(wait_for_window_seconds), 60.0))
    fresh = []
    while True:
        fresh = [w for w in mac_window_list() if w["id"] not in before and w["w"] >= 20 and w["h"] >= 20
                 and any(n.lower() == w["app"].lower() for n in names)]
        if fresh or time.time() >= end: break
        time.sleep(0.5)
    if fresh:
        return "Launched %s. Window(s):\n%s\nNext: mac_screenshot(window_id=%s)." % (app_path_or_name, fmt_windows(fresh), fresh[0]["id"])
    return ("Launched %s but no window appeared within %ss (it may be a menu-bar app, still starting, or crashed). "
            "Current windows of that app:\n%s" % (app_path_or_name, wait_for_window_seconds,
                                                 fmt_windows([w for w in mac_window_list() if w["app"] in names]) ))


def ax_text(pid):
    """Best-effort text of the app's first window via Accessibility; None when not permitted."""
    rc, out, err = run_cmd(["osascript", "-l", "JavaScript", "-e", AX_JS, str(pid)], timeout=12)
    if rc != 0: return None
    try: items = json.loads(out)
    except ValueError: return None
    return ["[%d] %s \"%s\"%s" % (i, r, t, " value=%r" % v if v else "") for i, (r, t, v) in enumerate(items)]


@tool("mac_screenshot",
      "Capture ONE Mac window (no shadow) as an image saved to disk, with the window's facts and, when Accessibility is allowed, its text. Pick it by app name, title text or window id.",
      {"app": P("string", "App name contains (case-insensitive)."), "window_id": P("integer", "Exact window id from mac_windows."),
       "title_contains": P("string", "Window title contains (case-insensitive)."),
       "ui_text": P("boolean", "Also read the window's labels/buttons through Accessibility (default true).")},
      timeout=60)
def mac_screenshot(app=None, window_id=None, title_contains=None, ui_text=True):
    if app is None and window_id is None and title_contains is None:
        raise ToolError("Say which window: app=, title_contains= or window_id= (mac_windows lists them).")
    allw = mac_window_list()
    wins = select_windows(allw, app=app, title_contains=title_contains, window_id=window_id)
    if not wins:
        raise ToolError("No on-screen window matches. Windows that exist:\n%s" % fmt_windows(allw))
    w = wins[0]
    path = new_shot_path("mac")
    rc, out, err = run_cmd(["screencapture", "-x", "-o", "-l", str(w["id"]), path], timeout=30)
    if rc != 0 or not os.path.isfile(path) or os.path.getsize(path) == 0:
        msg = tail(err or out, 200)
        raise ToolError("screencapture failed (%s). If it mentions permission or could not create image, the app that started "
                        "this server (Orbit or Terminal) needs Screen Recording permission: System Settings > Privacy & Security > "
                        "Screen Recording, enable it, then restart that app." % (msg or "exit %s" % rc))
    path, pw, ph = finish_shot(path)
    text = ["Window id=%s app=\"%s\" title=\"%s\" pid=%s bounds=%s,%s %sx%s points. Screenshot saved: %s (%dx%d px)." % (
        w["id"], w["app"], w["title"], w["pid"], fmt_num(w["x"]), fmt_num(w["y"]), fmt_num(w["w"]), fmt_num(w["h"]), path, pw, ph)]
    if len(wins) > 1 and window_id is None:
        text.append("%d windows matched; this is the frontmost. Others:\n%s" % (len(wins) - 1, fmt_windows(wins[1:6])))
    if not w["title"] and w["app"]:
        text.append("(Window titles are hidden without Screen Recording permission for the app that started this server.)")
    if ui_text:
        ax = ax_text(w["pid"])
        text.append("Window text and controls:\n" + "\n".join(ax) if ax else
                    "(Window text unavailable: Accessibility permission for the app that started this server would enable it.)")
    return [text_part("\n".join(text)), image_part(path)]


@tool("mac_quit", "Politely quit a running Mac app by name (no force kill).",
      {"app": P("string", "App name, or a .app path.")}, ["app"], timeout=40)
def mac_quit(app):
    name = os.path.basename(app.strip().rstrip("/"))
    name = name[:-4] if name.endswith(".app") else name
    rc, out, err = run_cmd(["osascript", "-l", "JavaScript", "-e",
                            'function run(a){try{return Application(a[0]).running()?"yes":"no"}catch(e){return "missing"}}', name], timeout=15)
    state = out.strip()
    if state == "missing": raise ToolError("No installed app is named %r. mac_windows shows running app names." % name)
    if state != "yes": return "%s is not running." % name
    rc, out, err = run_cmd(["osascript", "-e", "on run argv", "-e", "tell application (item 1 of argv) to quit", "-e", "end run", name], timeout=25)
    need_ok(rc, out, err, "Quitting %s" % name)
    return "Asked %s to quit. (If it had unsaved work it may be showing a dialog; check mac_windows.)" % name


# --------------------------------------------------------------------- JSON-RPC over stdio

_wlock = threading.Lock()


def send(msg):
    line = json.dumps(msg) + "\n"
    with _wlock:
        try:
            sys.stdout.write(line)
            sys.stdout.flush()
        except (BrokenPipeError, OSError, ValueError):
            shutdown(0)


# --------------------------------------------------------------------- screen control (group "screen")
# The whole main display, seen and driven the way the desktop app's computer-use does it. Off unless
# Orbit's "Screen control" setting is on (the server then lists the group); every action but
# screen_look asks the person first (see claude_engine.decide).

CLICLICK_PATHS = ("/opt/homebrew/bin/cliclick", "/usr/local/bin/cliclick")


def cliclick_path():
    for p in CLICLICK_PATHS:
        if os.path.exists(p): return p
    p = shutil.which("cliclick")
    if p: return p
    raise ToolError("cliclick is not installed (brew install cliclick); screen control needs it.")


def cliclick(*cmds):
    rc, out, err = run_cmd([cliclick_path(), *cmds], timeout=20)
    if rc != 0:
        msg = tail(err or out, 300)
        if not msg or "not allowed" in msg.lower() or "accessib" in msg.lower():
            raise ToolError("macOS refused the action. Allow Accessibility for the app that started this server (Orbit, or "
                            "Terminal) in System Settings > Privacy & Security > Accessibility, then restart that app.")
        raise ToolError(msg)
    return out.strip()


def screen_points():
    """(width, height) of the main display in points -- the unit the click tools use."""
    rc, out, _ = run_cmd(["osascript", "-l", "JavaScript", "-e",
                          "ObjC.import('AppKit'); var f=$.NSScreen.mainScreen.frame.size; f.width+','+f.height"], timeout=10)
    try:
        w, h = [int(float(v)) for v in out.strip().split(",")]
        if w > 0 and h > 0: return w, h
    except ValueError:
        pass
    return None


def screen_xy(x, y):
    size = screen_points()
    x, y = int(round(float(x))), int(round(float(y)))
    if size and not (0 <= x < size[0] and 0 <= y < size[1]):
        raise ToolError("(%d,%d) is off the screen, which is %dx%d points (0,0 is the top-left). Take a screen_look "
                        "and read the coordinates from it." % (x, y, size[0], size[1]))
    return x, y


@tool("screen_look",
      "Screenshot the whole main display of this Mac. The image is exactly the screen's size in points, so a pixel in it is the "
      "coordinate screen_click and the other screen_* tools take. Look before you click, and again after.",
      timeout=60)
def screen_look():
    path = new_shot_path("screen")
    rc, out, err = run_cmd(["screencapture", "-x", "-m", "-t", "png", path], timeout=30)
    if rc != 0 or not os.path.isfile(path) or os.path.getsize(path) < 100:
        raise ToolError("screencapture failed (%s). The app that started this server (Orbit or Terminal) needs Screen Recording "
                        "permission: System Settings > Privacy & Security > Screen Recording, enable it, then restart that app."
                        % (tail(err or out, 200) or "exit %s" % rc))
    size = screen_points()
    if size and png_size(path) != size and shutil.which("sips"):
        run_cmd(["sips", "-z", str(size[1]), str(size[0]), path], timeout=30)      # a retina capture -> point size
    path, pw, ph = finish_shot(path)
    note = ""
    if size and (pw, ph) != size:
        note = " The image is scaled: multiply its pixel coordinates by %.3f to get screen points." % (size[0] / float(pw))
    return [text_part("Main display %s points. Screenshot saved: %s (%dx%d px).%s"
                      % ("%dx%d" % size if size else "(size unknown)", path, pw, ph, note)), image_part(path)]


@tool("screen_click",
      "Click at screen coordinates (points, 0,0 = top-left of the main display). Take a screen_look afterwards to see what happened.",
      {"x": P("integer", "Horizontal position."), "y": P("integer", "Vertical position."),
       "button": P("string", "left (default) or right."), "clicks": P("integer", "1 (default) or 2 for a double click.")},
      ["x", "y"], timeout=30)
def screen_click(x, y, button="left", clicks=1):
    x, y = screen_xy(x, y)
    cmd = {("left", 1): "c", ("left", 2): "dc", ("right", 1): "rc"}.get((str(button).lower(), int(clicks)))
    if not cmd: raise ToolError("button is left or right; clicks is 1 or 2 (a right double click does not exist).")
    cliclick("%s:%d,%d" % (cmd, x, y))
    return "Clicked %s%s at %d,%d." % (button, " twice" if int(clicks) == 2 else "", x, y)


@tool("screen_move", "Move the mouse to screen coordinates without clicking (hover, to open a menu or tooltip).",
      {"x": P("integer", "Horizontal position."), "y": P("integer", "Vertical position.")}, ["x", "y"], timeout=30)
def screen_move(x, y):
    x, y = screen_xy(x, y)
    cliclick("m:%d,%d" % (x, y))
    return "Moved the pointer to %d,%d." % (x, y)


@tool("screen_drag", "Press at one point, drag to another and release: select text, move a window, drag a file.",
      {"x1": P("integer", "Start x."), "y1": P("integer", "Start y."), "x2": P("integer", "End x."), "y2": P("integer", "End y.")},
      ["x1", "y1", "x2", "y2"], timeout=30)
def screen_drag(x1, y1, x2, y2):
    x1, y1 = screen_xy(x1, y1)
    x2, y2 = screen_xy(x2, y2)
    cliclick("dd:%d,%d" % (x1, y1), "dm:%d,%d" % (x2, y2), "du:%d,%d" % (x2, y2))
    return "Dragged %d,%d to %d,%d." % (x1, y1, x2, y2)


@tool("screen_type", "Type text into whatever has keyboard focus (click the field first).",
      {"text": P("string", "The text to type.")}, ["text"], timeout=60)
def screen_type(text):
    if not text: raise ToolError("Nothing to type.")
    cliclick("t:" + text)
    return "Typed %d characters." % len(text)


SCREEN_KEYS = {"enter": "enter", "return": "return", "escape": "esc", "esc": "esc", "tab": "tab", "space": "space",
               "delete": "delete", "backspace": "delete", "up": "arrow-up", "down": "arrow-down", "left": "arrow-left",
               "right": "arrow-right", "pageup": "page-up", "pagedown": "page-down", "home": "home", "end": "end"}
SCREEN_MODS = {"cmd": "cmd", "command": "cmd", "ctrl": "ctrl", "control": "ctrl", "alt": "alt", "option": "alt",
               "shift": "shift", "fn": "fn"}


@tool("screen_key", "Press a key or a chord: return, escape, tab, space, delete, arrows, or e.g. cmd+a, cmd+shift+4, ctrl+c.",
      {"key": P("string", "The key or chord, joined with +.")}, ["key"], timeout=30)
def screen_key(key):
    parts = [p.strip().lower() for p in str(key).split("+") if p.strip()]
    if not parts: raise ToolError("No key given.")
    *mods, main = parts
    bad = [m for m in mods if m not in SCREEN_MODS]
    if bad: raise ToolError("Unknown modifier %s; use cmd, ctrl, alt, shift or fn." % ", ".join(bad))
    mods = [SCREEN_MODS[m] for m in mods]
    main = SCREEN_KEYS.get(main, main)
    cmds = (["kd:" + ",".join(mods)] if mods else []) + [("t:" + main) if len(main) == 1 else ("kp:" + main)] \
        + (["ku:" + ",".join(mods)] if mods else [])
    cliclick(*cmds)
    return "Pressed %s." % key


SCROLL_JS = ("ObjC.import('ApplicationServices');"
             "var e=$.CGEventCreateScrollWheelEvent(null,0,1,%d);$.CGEventPost(0,e);'ok'")


@tool("screen_scroll", "Scroll with the mouse wheel at a point (moves the pointer there first). Positive amount scrolls down.",
      {"amount": P("integer", "Wheel lines; positive = down, negative = up (default 5)."),
       "x": P("integer", "Horizontal position of the pane to scroll."), "y": P("integer", "Vertical position of the pane.")},
      timeout=30)
def screen_scroll(amount=5, x=None, y=None):
    if (x is None) != (y is None): raise ToolError("Give both x and y, or neither.")
    if x is not None:
        x, y = screen_xy(x, y)
        cliclick("m:%d,%d" % (x, y))
    n = max(-50, min(50, int(amount)))
    rc, out, err = run_cmd(["osascript", "-l", "JavaScript", "-e", SCROLL_JS % -n], timeout=15)
    if rc != 0: raise ToolError("Scrolling failed: %s" % tail(err or out, 200))
    return "Scrolled %s by %d." % ("down" if n >= 0 else "up", abs(n))


def enabled_tools():
    """ORBIT_LOOK_GROUPS ("browser,simulator,mac", the default) limits what is offered: every
    tool listed is a definition the model reads on every message."""
    want = {g.strip() for g in os.environ.get("ORBIT_LOOK_GROUPS", "browser,simulator,mac").split(",") if g.strip()}
    return [n for n in TOOLS if n.split("_", 1)[0] in want]


def listed_tools():
    return [{"name": TOOLS[n]["name"], "description": TOOLS[n]["description"], "inputSchema": TOOLS[n]["inputSchema"]}
            for n in enabled_tools()]


def handle(req):
    """One JSON-RPC message -> its response dict, or None for notifications."""
    if not isinstance(req, dict): return {"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "invalid request"}}
    mid, method, params = req.get("id"), req.get("method"), req.get("params") or {}
    if mid is None: return None                                   # a notification
    ok = lambda result: {"jsonrpc": "2.0", "id": mid, "result": result}
    err = lambda code, m: {"jsonrpc": "2.0", "id": mid, "error": {"code": code, "message": m}}
    try:
        if method == "initialize":
            return ok({"protocolVersion": PROTOCOL, "capabilities": {"tools": {}},
                       "serverInfo": {"name": "orbit-look", "version": VERSION}})
        if method == "ping": return ok({})
        if method == "tools/list": return ok({"tools": listed_tools()})
        if method == "tools/call":
            name = params.get("name")
            if name not in TOOLS or name not in enabled_tools(): return err(-32602, "unknown tool %r" % name)
            return ok(call_tool(name, params.get("arguments") or {}))
        return err(-32601, "no method %s" % method)
    except Exception as e:
        return err(-32000, "%s: %s" % (type(e).__name__, e))


def serve_one(req):
    resp = handle(req)
    if resp is not None: send(resp)


def shutdown(code=0):
    try: B.stop()
    finally: os._exit(code)


def watch_parent():
    """Exit when whoever started us is gone, so no browser is ever left running."""
    ppid = os.getppid()
    if ppid <= 1: return
    while True:
        time.sleep(1.0)
        if os.getppid() != ppid: shutdown(0)


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if "--selftest" in argv:
        print("orbit-look %s: %d tools" % (VERSION, len(TOOLS)))
        for n in TOOLS: print(n)
        return 0
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, lambda *_: shutdown(0))
    atexit.register(B.stop)
    threading.Thread(target=watch_parent, daemon=True).start()
    for line in sys.stdin:
        line = line.strip()
        if not line: continue
        try: req = json.loads(line)
        except ValueError:
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}})
            continue
        if isinstance(req, dict) and req.get("method") == "tools/call":
            threading.Thread(target=serve_one, args=(req,), daemon=True).start()
        else:
            serve_one(req)
    shutdown(0)                                                    # stdin closed: take the browser with us


if __name__ == "__main__":
    sys.exit(main())
