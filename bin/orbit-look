       "device": P("string", "Device name or UDID; default = the booted simulator.")}, ["x", "y"], timeout=90)
def simulator_tap(x, y, device=None):
    return sim_input("tap", device, "Tapped %s,%s." % (fmt_num(x), fmt_num(y)), x=x, y=y)


