#!/usr/bin/env python3
"""Eyes for a coding agent: a browser, the iOS Simulator and Mac app windows, as an MCP server.

An agent that builds a page or an app cannot see it. Started over stdio by any MCP
client (Claude Code, Codex CLI, OpenCode, Orbit's own agent), this gives it screenshots
it can look at AND the same screen as plain text (visible text, a numbered list of what
can be clicked, an accessibility tree), because some models cannot read images.

The browser is a headless Chromium-family browser on a throwaway profile, driven over
the DevTools Protocol with a small WebSocket client written here; it is never the user's
own profile. The simulator goes through `xcrun simctl` (no Simulator.app needed); taps
need AXe or idb. Mac windows go through CoreGraphics and screencapture. Whatever
this process started is killed with it, on EOF, a signal, or its parent dying. Standard
library only.

Env: ORBIT_LOOK_DIR (screenshots, default ~/Library/Caches/orbit-look), ORBIT_LOOK_CHROME
(browser to use), ORBIT_LOOK_HEADED=1 (show the browser window).
"""
import atexit, base64, hashlib, json, os, re, shutil, signal, socket, struct
import subprocess, sys, tempfile, threading, time, traceback, urllib.parse, urllib.request

VERSION = "1.0.0"
PROTOCOL = "2024-11-05"
MAX_SIDE = 1568                       # longest edge of any screenshot handed to a model
KEEP_SHOTS = 60
AXE_MISSING = "Tapping needs AXe: brew install cameroncooke/axe/axe"
MOBILE_UA = ("Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 "
             "(KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1")


class ToolError(Exception):
    """A failure the agent can act on: the message says what failed and how to fix it."""


# --------------------------------------------------------------------- small helpers

def run_cmd(cmd, timeout=30, env=None):
    """Run a command to completion -> (returncode, stdout, stderr). Never raises, never reads our stdin."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, errors="replace", timeout=timeout,
                           stdin=subprocess.DEVNULL, env=env)
        return p.returncode, p.stdout or "", p.stderr or ""
    except subprocess.TimeoutExpired:
        return 124, "", "timed out after %ss" % timeout
    except FileNotFoundError:
        return 127, "", "%s: command not found" % cmd[0]
    except OSError as e:
        return 126, "", str(e)


def tail(s, n=600):
    s = (s or "").strip()
    return s if len(s) <= n else "..." + s[-n:]


def fmt_num(v):
    v = float(v)
    return str(int(v)) if v == int(v) else "%.1f" % v


def text_part(s):
    return {"type": "text", "text": s}


def image_part(path):
    with open(path, "rb") as f:
        return {"type": "image", "data": base64.b64encode(f.read()).decode("ascii"), "mimeType": "image/png"}


def out_dir():
    d = os.path.expanduser(os.environ.get("ORBIT_LOOK_DIR") or "~/Library/Caches/orbit-look")
    os.makedirs(d, exist_ok=True)
    return d


def prune_shots(d, keep=KEEP_SHOTS):
    """Keep the newest `keep` screenshots of ours; never touch other files in the folder."""
    try:
        files = [os.path.join(d, n) for n in os.listdir(d) if n.startswith("orbit-look-") and n.endswith(".png")]
        files.sort(key=lambda p: os.path.getmtime(p), reverse=True)
        for p in files[keep:]:
            try: os.remove(p)
            except OSError: pass
    except OSError:
        pass


_shot_seq = [0]


def png_size(path):
    with open(path, "rb") as f:
        head = f.read(24)
    if head[:8] != b"\x89PNG\r\n\x1a\n" or head[12:16] != b"IHDR":
        raise ToolError("The capture is not a PNG image (%s)." % path)
    return struct.unpack(">II", head[16:24])


def shrink(path, limit=MAX_SIDE):
    """Cap the longest edge at `limit` px with sips (macOS); only ever shrinks."""
    w, h = png_size(path)
    if max(w, h) > limit and shutil.which("sips"):
        run_cmd(["sips", "-Z", str(limit), path], timeout=30)
        w, h = png_size(path)
    return w, h


def new_shot_path(tag):
    _shot_seq[0] += 1
    return os.path.join(out_dir(), "orbit-look-%d-%03d-%s.png" % (int(time.time() * 1000), _shot_seq[0] % 1000, tag))


def finish_shot(path):
    """Cap the size, prune old captures -> (path, width, height)."""
    w, h = shrink(path)
    prune_shots(os.path.dirname(path))
    return path, w, h


def save_png_bytes(data, tag):
    path = new_shot_path(tag)
    with open(path, "wb") as f:
        f.write(data)
    return finish_shot(path)


# --------------------------------------------------------------------- WebSocket (RFC 6455)

WS_GUID = b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11"


def ws_mask(data, key):
    n = len(data)
    if not n: return b""
    k = (key * (n // 4 + 1))[:n]
    return (int.from_bytes(data, "big") ^ int.from_bytes(k, "big")).to_bytes(n, "big")


class WS:
    """Minimal client: handshake, masked frames out, fragmentation/ping/close in, big payloads."""

    def __init__(self, url, timeout=10):
        u = urllib.parse.urlparse(url)
        if u.scheme != "ws": raise ValueError("only ws:// URLs: %s" % url)
        host, port = u.hostname, u.port or 80
        path = (u.path or "/") + ("?" + u.query if u.query else "")
        self.sock = socket.create_connection((host, port), timeout)
        self.buf = bytearray()
        self.wlock = threading.Lock()
        self.closed = False
        key = base64.b64encode(os.urandom(16))
        req = ("GET %s HTTP/1.1\r\nHost: %s:%d\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
               "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n") % (path, host, port, key.decode())
        self.sock.sendall(req.encode())
        while b"\r\n\r\n" not in self.buf:
            chunk = self.sock.recv(4096)
            if not chunk: raise ConnectionError("connection closed during the WebSocket handshake")
            self.buf += chunk
        head, _, rest = bytes(self.buf).partition(b"\r\n\r\n")
        self.buf = bytearray(rest)
        lines = head.decode("latin-1").split("\r\n")
        if " 101" not in lines[0]: raise ConnectionError("WebSocket upgrade refused: " + lines[0])
        accept = base64.b64encode(hashlib.sha1(key + WS_GUID).digest()).decode()
        got = {l.split(":", 1)[0].strip().lower(): l.split(":", 1)[1].strip() for l in lines[1:] if ":" in l}
        if got.get("sec-websocket-accept") != accept: raise ConnectionError("bad Sec-WebSocket-Accept")

    def _send_frame(self, op, payload=b""):
        n = len(payload)
        head = bytearray([0x80 | op])
        if n < 126: head.append(0x80 | n)
        elif n < 65536: head += bytes([0x80 | 126]) + struct.pack(">H", n)
        else: head += bytes([0x80 | 127]) + struct.pack(">Q", n)
        key = os.urandom(4)
        with self.wlock:
            self.sock.sendall(bytes(head) + key + ws_mask(payload, key))

    def send(self, data):
        if isinstance(data, str): self._send_frame(0x1, data.encode("utf-8"))
        else: self._send_frame(0x2, bytes(data))

    def _frame(self):
        """One complete frame from the buffer -> (fin, opcode, payload) or None if more bytes are needed."""
        b = self.buf
        if len(b) < 2: return None
        fin, op = bool(b[0] & 0x80), b[0] & 0x0F
        masked, n, i = bool(b[1] & 0x80), b[1] & 0x7F, 2
        if n == 126:
            if len(b) < 4: return None
            n, i = struct.unpack(">H", bytes(b[2:4]))[0], 4
        elif n == 127:
            if len(b) < 10: return None
            n, i = struct.unpack(">Q", bytes(b[2:10]))[0], 10
        key = b""
        if masked:
            if len(b) < i + 4: return None
            key, i = bytes(b[i:i + 4]), i + 4
        if len(b) < i + n: return None
        payload = bytes(b[i:i + n])
        del b[:i + n]
        return fin, op, (ws_mask(payload, key) if masked else payload)

    def recv(self, timeout=None):
        """Next whole message (str for text, bytes for binary). socket.timeout if none in time;
        ConnectionError once the peer closes. Partial frames survive a timeout."""
        parts, kind = [], None
        deadline = None if timeout is None else time.time() + timeout
        while True:
            fr = self._frame()
            if fr is None:
                left = None if deadline is None else max(0.0, deadline - time.time())
                if deadline is not None and left == 0.0 and not self.buf: raise socket.timeout()
                self.sock.settimeout(left)
                chunk = self.sock.recv(1 << 20)           # raises socket.timeout
                if not chunk:
                    self.closed = True
                    raise ConnectionError("WebSocket closed")
                self.buf += chunk
                continue
            fin, op, payload = fr
            if op == 0x9: self._send_frame(0xA, payload); continue          # ping -> pong
            if op == 0xA: continue
            if op == 0x8:
                self.closed = True
                try: self._send_frame(0x8, payload[:2])
                except OSError: pass
                raise ConnectionError("WebSocket closed by peer")
            if op in (0x1, 0x2): kind, parts = op, [payload]
            elif op == 0x0: parts.append(payload)
            if fin and kind is not None:
                data = b"".join(parts)
                return data.decode("utf-8", "replace") if kind == 0x1 else data

    def close(self):
        self.closed = True
        try: self._send_frame(0x8, struct.pack(">H", 1000))
        except OSError: pass
        try: self.sock.close()
        except OSError: pass


class CDP:
    """DevTools Protocol over one WebSocket: a reader thread routes replies and events."""

    def __init__(self, ws_url):
        self.ws = WS(ws_url)
        self.lock = threading.Lock()
        self.next_id = 0
        self.pending = {}
        self.handlers = {}
        self.closed = False
        threading.Thread(target=self._reader, daemon=True).start()

    def on(self, method, fn):
        self.handlers[method] = fn

    def _reader(self):
        try:
            while True:
                msg = self.ws.recv()
                try: data = json.loads(msg)
                except (TypeError, ValueError): continue
                if "id" in data:
                    slot = self.pending.pop(data["id"], None)
                    if slot: slot[1] = data; slot[0].set()
                else:
                    fn = self.handlers.get(data.get("method"))
                    if fn:
                        try: fn(data.get("params") or {})
                        except Exception: pass
        except Exception:
            pass
        finally:
            self.closed = True
            for slot in list(self.pending.values()):
                slot[1] = {"error": {"message": "browser connection closed"}}
                slot[0].set()

    def send(self, method, params=None, timeout=30, wait=True):
        if self.closed: raise ToolError("The browser connection is closed. Call browser_open again.")
        with self.lock:
            self.next_id += 1
            mid = self.next_id
            slot = [threading.Event(), None]
            if wait: self.pending[mid] = slot
        try: self.ws.send(json.dumps({"id": mid, "method": method, "params": params or {}}))
        except OSError: raise ToolError("The browser connection dropped. Call browser_open again.")
        if not wait: return None
        if not slot[0].wait(timeout):
            self.pending.pop(mid, None)
            raise ToolError("The browser did not answer %s within %ss. Try browser_close, then browser_open again." % (method, timeout))
        resp = slot[1]
        if "error" in resp:
            raise ToolError("Browser error in %s: %s" % (method, resp["error"].get("message", resp["error"])))
        return resp.get("result") or {}

    def close(self):
        self.closed = True
        self.ws.close()


# --------------------------------------------------------------------- the browser

CHROME_APPS = ["Google Chrome", "Chromium", "Brave Browser", "Microsoft Edge"]
CHROME_PATH_NAMES = ["google-chrome", "google-chrome-stable", "chromium", "chromium-browser", "brave-browser", "microsoft-edge", "chrome"]


def app_executable(app):
    macos = os.path.join(app, "Contents", "MacOS")
    if not os.path.isdir(macos): return None
    base = os.path.join(macos, os.path.basename(app)[:-4])
    if os.path.isfile(base): return base
    files = [f for f in os.listdir(macos) if os.path.isfile(os.path.join(macos, f))]
    return os.path.join(macos, files[0]) if len(files) == 1 else None


def find_chrome():
    want = os.environ.get("ORBIT_LOOK_CHROME", "").strip()
    if want:
        want = os.path.expanduser(want)
        if want.endswith(".app"): want = app_executable(want) or want
        if os.path.isfile(want) and os.access(want, os.X_OK): return want
        raise ToolError("ORBIT_LOOK_CHROME=%s is not an executable browser. Point it at a Chromium-family binary or .app, or unset it." % want)
    for name in CHROME_APPS:
        for root in ("/Applications", os.path.expanduser("~/Applications")):
            exe = app_executable(os.path.join(root, name + ".app"))
            if exe: return exe
    for n in CHROME_PATH_NAMES:
        p = shutil.which(n)
        if p: return p
    raise ToolError("No Chromium-family browser found. Install Google Chrome (brew install --cask google-chrome) "
                    "or set ORBIT_LOOK_CHROME to a Chrome, Chromium, Brave or Edge executable.")


def chrome_flags(profile, headed=False):
    flags = ["--remote-debugging-port=0", "--user-data-dir=" + profile, "--no-first-run",
             "--no-default-browser-check", "--disable-extensions", "--use-mock-keychain",
             "--password-store=basic", "--disable-sync", "--disable-background-networking",
             "--disable-search-engine-choice-screen", "--mute-audio", "--hide-scrollbars",
             "--window-size=1280,800", "about:blank"]
    if not headed: flags.insert(0, "--headless=new")
    return flags


# Watches from outside our process: if we are killed outright (SIGKILL), it still reaps Chrome.
GUARD_SH = ('while kill -0 "$1" 2>/dev/null && kill -0 "$2" 2>/dev/null; do sleep 1; done; '
            'kill -TERM -- "-$2" 2>/dev/null; sleep 1; kill -KILL -- "-$2" 2>/dev/null; '
            'case "$3" in */orbit-look-*) rm -rf "$3";; esac')

