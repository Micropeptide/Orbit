KEYS = {
    "enter": ("Enter", "Enter", 13, "\r"), "return": ("Enter", "Enter", 13, "\r"), "tab": ("Tab", "Tab", 9, ""),
    "escape": ("Escape", "Escape", 27, ""), "esc": ("Escape", "Escape", 27, ""),
    "backspace": ("Backspace", "Backspace", 8, ""), "delete": ("Delete", "Delete", 46, ""),
    "arrowup": ("ArrowUp", "ArrowUp", 38, ""), "arrowdown": ("ArrowDown", "ArrowDown", 40, ""),
    "arrowleft": ("ArrowLeft", "ArrowLeft", 37, ""), "arrowright": ("ArrowRight", "ArrowRight", 39, ""),
    "up": ("ArrowUp", "ArrowUp", 38, ""), "down": ("ArrowDown", "ArrowDown", 40, ""),
    "left": ("ArrowLeft", "ArrowLeft", 37, ""), "right": ("ArrowRight", "ArrowRight", 39, ""),
    "home": ("Home", "Home", 36, ""), "end": ("End", "End", 35, ""),
    "pageup": ("PageUp", "PageUp", 33, ""), "pagedown": ("PageDown", "PageDown", 34, ""),
    "space": (" ", "Space", 32, " "),
}
MODS = {"alt": 1, "option": 1, "ctrl": 2, "control": 2, "meta": 4, "cmd": 4, "command": 4, "shift": 8}
EDIT_COMMANDS = {"a": "selectAll", "c": "copy", "v": "paste", "x": "cut", "z": "undo"}


def parse_key(spec):
    """'Control+a' / 'Enter' / 'ArrowDown' -> dispatchKeyEvent fields."""
    parts = [p for p in re.split(r"\+(?=.)", str(spec).strip()) if p]
    if not parts: raise ToolError("browser_press needs a key such as Enter, Tab, Escape, ArrowDown or Control+a.")
    mods, name = 0, parts[-1]
    for m in parts[:-1]:
        if m.lower() not in MODS: raise ToolError("Unknown modifier %r in key %r. Use Control, Alt, Shift or Meta." % (m, spec))
        mods |= MODS[m.lower()]
    k = KEYS.get(name.lower())
    if k: key, code, vk, txt = k
    elif len(name) == 1:
        key, vk = name, ord(name.upper())
        code = ("Key" + name.upper()) if name.isalpha() else ("Digit" + name if name.isdigit() else "")
        txt = name
    else:
        raise ToolError("Unknown key %r. Try Enter, Tab, Escape, Backspace, Delete, ArrowUp/Down/Left/Right, Home, End, PageUp, PageDown, Space or one character." % name)
    ev = {"key": key, "code": code, "windowsVirtualKeyCode": vk, "nativeVirtualKeyCode": vk, "modifiers": mods}
    if txt and not (mods & 6): ev["text"] = txt
    if mods & 6 and name.lower() in EDIT_COMMANDS: ev["commands"] = [EDIT_COMMANDS[name.lower()]]
    return ev


def parse_ref(spec):
    """A snapshot number ('3', '[3]', 3) or a CSS selector -> ('n', 3) / ('css', '#go')."""
    if isinstance(spec, bool) or spec is None or spec == "":
        raise ToolError("Give element as a snapshot number (from browser_snapshot) or a CSS selector.")
    if isinstance(spec, int): return ("n", spec)
    if isinstance(spec, float) and spec == int(spec): return ("n", int(spec))
    s = str(spec).strip()
    m = re.fullmatch(r"\[?\s*(\d+)\s*\]?", s)
    return ("n", int(m.group(1))) if m else ("css", s)


def resolve_js(ref, focus=False):
    kind, val = ref
    spec = {"n": val} if kind == "n" else {"css": val}
    if focus: spec["focus"] = True
    return RESOLVE_JS.replace("__SPEC__", json.dumps(spec))


def check_url(url):
    u = urllib.parse.urlparse((url or "").strip())
    if u.scheme.lower() not in ("http", "https", "file"):
        hint = ""
        raw = (url or "").strip()
        if u.scheme.lower() in ("", ) or re.match(r"^[\w.\-]+:\d+", raw) or "." in raw.split("/")[0]:
            hint = " Did you mean http://%s ?" % raw.lstrip("/")
        raise ToolError("browser_open only opens http, https and file URLs (got %r).%s" % (raw[:80], hint))
    if u.scheme.lower() in ("http", "https") and not u.netloc:
        raise ToolError("That URL has no host: %r." % url)
    return url.strip()


def fmt_snapshot(s):
    sc = s.get("scroll") or {}
    lines = ["Title: %s" % (s.get("title") or "(none)"), "URL: %s" % s.get("url", "")]
    if sc:
        lines.append("Viewport: %sx%s, scrolled to %s,%s of a %sx%s page" % (
            sc.get("vw"), sc.get("vh"), sc.get("x"), sc.get("y"), sc.get("w"), sc.get("h")))
    lines += ["", "Visible text:", s.get("text") or "(no text)", ""]
    els = s.get("elements") or []
    total = s.get("total", len(els))
    if not els:
        lines.append("Interactive elements: none found.")
    else:
        lines.append("Interactive elements (%d%s), [n] role \"label\" @ x,y WxH in viewport pixels:" % (
            len(els), "" if total <= len(els) else " of %d, first shown" % total))
        for i, e in enumerate(els):
            bits = ["[%d] %s" % (i, e.get("role", "?"))]
            if e.get("label"): bits.append('"%s"' % e["label"])
            if e.get("href"): bits.append("-> %s" % e["href"])
            if e.get("value"): bits.append("value=%r" % e["value"])
            if "checked" in e: bits.append("checked" if e["checked"] else "unchecked")
            if e.get("disabled"): bits.append("disabled")
            bits.append("@ %s,%s %sx%s" % (e.get("x"), e.get("y"), e.get("w"), e.get("h")))
            if e.get("off"): bits.append("(%s the viewport; scrolls into view when used)" % e["off"])
            lines.append(" ".join(bits))
    return "\n".join(lines)


class Browser:
    def __init__(self):
        self.lock = threading.RLock()
        self.vp = {"width": 1280, "height": 800, "mobile": False}
        self._clear()

    def _clear(self):
        self.proc = self.guard = self.cdp = self.tmp = None
        self.main_frame = None
        self.console = []
        self.requests = {}
        self.inflight = set()
        self.loading = False
        self.status = None
        self.opened = False
        self.crashed = False

    # -- lifecycle
    def running(self):
        return bool(self.cdp and not self.cdp.closed and self.proc and self.proc.poll() is None and not self.crashed)

    def ensure(self):
        if self.running(): return
        self.stop()
        self.start()

    def start(self):
        exe = find_chrome()
        self.tmp = tempfile.mkdtemp(prefix="orbit-look-")
        try:
            log = open(os.path.join(self.tmp, "browser.log"), "wb")
            try:
                self.proc = subprocess.Popen([exe] + chrome_flags(self.tmp, os.environ.get("ORBIT_LOOK_HEADED") == "1"),
                                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log,
                                             start_new_session=True)
            finally:
                log.close()
            try:
                self.guard = subprocess.Popen(["/bin/sh", "-c", GUARD_SH, "sh", str(os.getpid()), str(self.proc.pid), self.tmp],
                                              stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                              start_new_session=True)
            except OSError:
                self.guard = None
            port = self._wait_port()
            ws_url = self._page_ws(port)
            self.cdp = CDP(ws_url)
            self._wire()
            self._setup()
        except ToolError:
            self.stop(); raise
        except Exception as e:
            self.stop()
            raise ToolError("Could not start the browser: %s: %s. Check ORBIT_LOOK_CHROME or reinstall Chrome." % (type(e).__name__, e))

    def _wait_port(self):
        portfile = os.path.join(self.tmp, "DevToolsActivePort")
        end = time.time() + 25
        while time.time() < end:
            rc = self.proc.poll()
            if rc is not None:
                try:
                    with open(os.path.join(self.tmp, "browser.log"), errors="replace") as f: log = tail(f.read(), 400)
                except OSError: log = ""
                raise ToolError("The browser exited while starting (code %s). %s" % (rc, log))
            try:
                with open(portfile) as f: first = f.read().split("\n")[0].strip()
                if first.isdigit(): return int(first)
            except OSError:
                pass
            time.sleep(0.1)
        raise ToolError("The browser did not report its DevTools port within 25s (machine busy or browser blocked). Try again.")

    def _page_ws(self, port):
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        base = "http://127.0.0.1:%d" % port
        end = time.time() + 10
        while time.time() < end:
            try:
                with opener.open(base + "/json/list", timeout=5) as r: targets = json.load(r)
                for t in targets:
                    if t.get("type") == "page" and t.get("webSocketDebuggerUrl"): return t["webSocketDebuggerUrl"]
                req = urllib.request.Request(base + "/json/new?about:blank", method="PUT")
                with opener.open(req, timeout=5) as r: t = json.load(r)
                if t.get("webSocketDebuggerUrl"): return t["webSocketDebuggerUrl"]
            except (OSError, ValueError):
                pass
            time.sleep(0.2)
        raise ToolError("The browser started but offered no page to control.")

    def _wire(self):
        c = self.cdp

        def stack(p):
            fr = ((p.get("stackTrace") or {}).get("callFrames") or [{}])[0]
            return " (%s:%s)" % (fr["url"], fr.get("lineNumber", 0) + 1) if fr.get("url") else ""

        def arg_text(a):
            if "value" in a: return a["value"] if isinstance(a["value"], str) else json.dumps(a["value"])
            return a.get("unserializableValue") or a.get("description") or a.get("type", "")

        def note(kind, text):
            self.console.append("[%s] %s" % (kind, text))
            del self.console[:-500]

        def console_api(p):
            note(p.get("type", "log"), " ".join(str(arg_text(a)) for a in p.get("args", []))[:1000] + stack(p))

        def exception(p):
            d = p.get("exceptionDetails") or {}
            ex = (d.get("exception") or {}).get("description") or d.get("text", "exception")
            note("exception", ex.split("\n")[0][:400] + (" (%s:%s)" % (d["url"], d.get("lineNumber", 0) + 1) if d.get("url") else ""))

        def log_entry(p):
            e = p.get("entry") or {}
            if e.get("source") == "network": return                  # reported with its status below
            note(e.get("level", "info"), "%s%s" % (e.get("text", "")[:600], " (%s)" % e["url"] if e.get("url") else ""))

        def req_sent(p):
            self.requests[p["requestId"]] = (p.get("request", {}).get("method", "GET"), p.get("request", {}).get("url", ""))
            if p.get("type") not in ("WebSocket", "EventSource", "Ping", "Prefetch"): self.inflight.add(p["requestId"])

        def resp(p):
            r = p.get("response") or {}
            if p.get("type") == "Document" and p.get("frameId") == self.main_frame: self.status = r.get("status")
            if (r.get("status") or 0) >= 400:
                note("network", "HTTP %s %s %s" % (r.get("status"), self.requests.get(p.get("requestId"), ("GET",))[0], r.get("url", "")))

        def finished(p):
            self.inflight.discard(p.get("requestId"))

        def failed(p):
            self.inflight.discard(p.get("requestId"))
            if p.get("canceled"): return
            m, u = self.requests.get(p.get("requestId"), ("GET", "?"))
            note("network", "FAILED %s %s: %s%s" % (m, u, p.get("errorText", ""),
                                                   " (blocked: %s)" % p["blockedReason"] if p.get("blockedReason") else ""))

        def started(p):
            if p.get("frameId") == self.main_frame: self.loading = True

        def stopped(p):
            if p.get("frameId") == self.main_frame: self.loading = False

        def dialog(p):
            note("dialog", "%s: %s (auto-accepted)" % (p.get("type", "alert"), p.get("message", "")[:300]))
            c.send("Page.handleJavaScriptDialog", {"accept": True, "promptText": p.get("defaultPrompt", "")}, wait=False)

        def crashed(p):
            self.crashed = True

        for name, fn in (("Runtime.consoleAPICalled", console_api), ("Runtime.exceptionThrown", exception),
                         ("Log.entryAdded", log_entry), ("Network.requestWillBeSent", req_sent),
                         ("Network.responseReceived", resp), ("Network.loadingFinished", finished),
                         ("Network.loadingFailed", failed), ("Page.frameStartedLoading", started),
                         ("Page.frameStoppedLoading", stopped), ("Page.javascriptDialogOpening", dialog),
                         ("Inspector.targetCrashed", crashed)):
            c.on(name, fn)

    def _setup(self):
        for d in ("Page", "Runtime", "Network", "Log"):
            self.call(d + ".enable")
        self.main_frame = self.call("Page.getFrameTree")["frameTree"]["frame"]["id"]
        self.call("Page.addScriptToEvaluateOnNewDocument", {"source": INIT_JS})
        try: self.call("Emulation.setFocusEmulationEnabled", {"enabled": True})
        except ToolError: pass
        self.apply_viewport()

    def apply_viewport(self):
        v = self.vp
        self.call("Emulation.setDeviceMetricsOverride", {
            "width": v["width"], "height": v["height"], "deviceScaleFactor": 2 if v["mobile"] else 1,
            "mobile": bool(v["mobile"])})
        try:
            self.call("Emulation.setTouchEmulationEnabled", {"enabled": bool(v["mobile"])})
            self.call("Emulation.setUserAgentOverride", {"userAgent": MOBILE_UA if v["mobile"] else ""})
        except ToolError:
            pass

    def stop(self):
        cdp, proc, guard, tmp = self.cdp, self.proc, self.guard, self.tmp
        self._clear()
        if cdp:
            try: cdp.close()
            except Exception: pass
        if guard:
            try: guard.kill(); guard.wait(2)
            except Exception: pass
        if proc:
            kill_group(proc)
        if tmp:
            sweep_profile(tmp)
            shutil.rmtree(tmp, ignore_errors=True)

    # -- plumbing
    def call(self, method, params=None, timeout=30):
        cdp = self.cdp
        if not cdp: raise ToolError("The browser is not running. Call browser_open(url) first.")
        return cdp.send(method, params, timeout)

    def evaluate(self, expr, timeout=30):
        r = self.call("Runtime.evaluate", {"expression": expr, "returnByValue": True, "awaitPromise": True,
                                           "userGesture": True}, timeout)
        if r.get("exceptionDetails"):
            d = r["exceptionDetails"]
            msg = (d.get("exception") or {}).get("description") or d.get("text", "error")
            raise ToolError("JavaScript error: " + msg.split("\n")[0][:500])
        return r.get("result") or {}

    def need_page(self):
        if not self.opened or not self.running():
            raise ToolError("No page is open. Call browser_open(url) first.")

    def wait_loaded(self, timeout=30):
        time.sleep(0.1)
        end = time.time() + timeout
        while self.loading and time.time() < end:
            time.sleep(0.05)
        return not self.loading

    def settle(self, maxwait=3.0, quiet=0.4):
        end = time.time() + maxwait
        quiet_since = None
        while time.time() < end:
            if self.loading or self.inflight: quiet_since = None
            else:
                quiet_since = quiet_since or time.time()
                if time.time() - quiet_since >= quiet: return
            time.sleep(0.05)

    def after_action(self, pause=0.3):
        """Let an action's effects land: a navigation it started, then the network going quiet."""
        time.sleep(pause)
        self.wait_loaded(15)
        self.settle(2.5)

    # -- page operations
    def snapshot(self):
        s = self.evaluate(SNAP_JS).get("value")
        if not isinstance(s, dict): raise ToolError("Could not read the page. Is it still open? Try browser_open again.")
        return s

    def resolve(self, spec, focus=False):
        ref = parse_ref(spec)
        r = self.evaluate(resolve_js(ref, focus)).get("value") or {}
        if r.get("ok"): return r
        why = r.get("why")
        if why == "stale":
            raise ToolError("Element [%s] is not on the page any more (numbers reset on every snapshot and navigation). Call browser_snapshot for a fresh list." % ref[1])
        if why == "nomatch": raise ToolError("No element matches the selector %r. Check it against browser_snapshot." % ref[1])
        if why == "hidden": raise ToolError("That element has no size on screen (hidden). Pick another or scroll/open whatever hides it.")
        raise ToolError("Could not use that element: %s" % (r.get("msg") or why))

    def capture(self, full_page=False, clip=None, tag="browser"):
        params = {"format": "png"}
        note = ""
        if clip:
            params.update(clip=dict(clip, scale=1), captureBeyondViewport=True)
        elif full_page:
            m = self.call("Page.getLayoutMetrics")
            size = m.get("cssContentSize") or m.get("contentSize") or {}
            w, h = int(size.get("width", self.vp["width"])), int(size.get("height", self.vp["height"]))
            if h > 8000: note, h = " (page is %dpx tall; the first 8000px are captured)" % h, 8000
            params.update(clip={"x": 0, "y": 0, "width": max(w, 1), "height": max(h, 1), "scale": 1}, captureBeyondViewport=True)
        data = self.call("Page.captureScreenshot", params, timeout=45).get("data")
        if not data: raise ToolError("The browser returned no image.")
        path, w, h = save_png_bytes(base64.b64decode(data), tag)
        return path, w, h, note

    def observe(self, header, full=True):
        """The standard answer after an action: what happened, the page as text, and a screenshot."""
        parts = []
        try:
            text = fmt_snapshot(self.snapshot())
        except ToolError as e:
            text = "(page text unavailable: %s)" % e
        shot = None
        try:
            path, w, h, note = self.capture()
            shot = path
            header += "\nScreenshot saved: %s (%dx%d px)%s" % (path, w, h, note)
        except ToolError as e:
            header += "\n(screenshot failed: %s)" % e
        parts.append(text_part(header + "\n\n" + text))
        if shot: parts.append(image_part(shot))
        return parts

    def key(self, ev):
        base = dict(ev)
        cmds = base.pop("commands", None)
        down = dict(base, type="keyDown" if "text" in base else "rawKeyDown")
        if cmds: down["commands"] = cmds
        self.call("Input.dispatchKeyEvent", down)
        self.call("Input.dispatchKeyEvent", dict(base, type="keyUp"))

    def click_at(self, x, y):
        self.call("Input.dispatchMouseEvent", {"type": "mouseMoved", "x": x, "y": y})
        self.call("Input.dispatchMouseEvent", {"type": "mousePressed", "x": x, "y": y, "button": "left", "clickCount": 1})
        self.call("Input.dispatchMouseEvent", {"type": "mouseReleased", "x": x, "y": y, "button": "left", "clickCount": 1})


def kill_group(proc, grace=3):
    """Terminate a whole process group (the browser and its helpers), then make sure."""
    try: os.killpg(proc.pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError, OSError): pass
    try: proc.wait(grace)
    except subprocess.TimeoutExpired:
        try: os.killpg(proc.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError, OSError): pass
        try: proc.wait(grace)
        except subprocess.TimeoutExpired: pass
    try: os.killpg(proc.pid, signal.SIGKILL)               # helpers that outlived the leader
    except (ProcessLookupError, PermissionError, OSError): pass


def sweep_profile(tmp):
    """Anything still running on this throwaway profile is ours: kill it."""
    rc, out, _ = run_cmd(["ps", "-axo", "pid=,command="], timeout=10)
    if rc != 0: return
    needle = "--user-data-dir=" + tmp
    for line in out.splitlines():
        pid, _, cmd = line.strip().partition(" ")
        if needle in cmd and pid.isdigit() and int(pid) != os.getpid():
            try: os.kill(int(pid), signal.SIGKILL)
            except OSError: pass


B = Browser()


# --------------------------------------------------------------------- tool registry

TOOLS = {}


def P(typ, desc, **extra):
    d = {"type": typ, "description": desc}
    d.update(extra)
    return d


def tool(name, desc, props=None, required=(), timeout=60, browser=False):
    def deco(fn):
        TOOLS[name] = {"name": name, "description": desc, "fn": fn, "timeout": timeout, "browser": browser,
                       "inputSchema": {"type": "object", "properties": props or {}, "required": list(required)}}
        return fn
    return deco


def coerce(args, schema):
    """Models send "800" for 800 and "true" for true; accept that, and enforce required."""
    props, out = schema.get("properties", {}), {}
    for k, v in (args or {}).items():
        if v is None: continue
        t = (props.get(k) or {}).get("type")
        try:
            if t == "integer" and not isinstance(v, bool): v = int(float(v))
            elif t == "number" and not isinstance(v, bool): v = float(v)
            elif t == "boolean" and isinstance(v, str): v = v.strip().lower() in ("1", "true", "yes", "on")
            elif t == "string" and not isinstance(v, str): v = str(v)
            elif t == "array" and isinstance(v, str): v = json.loads(v) if v.strip().startswith("[") else [v]
            elif t == "object" and isinstance(v, str): v = json.loads(v)
        except (ValueError, TypeError):
            raise ToolError("Argument %r must be of type %s." % (k, t))
        out[k] = v
    for k in schema.get("required", []):
        if k not in out: raise ToolError("Missing required argument %r." % k)
    return out


def call_tool(name, arguments):
    """Run one tool -> MCP result. Always returns, whatever the tool does."""
    t = TOOLS[name]
    box = {}

    def work():
        try:
            args = coerce(arguments, t["inputSchema"])
            if t["browser"]:
                with B.lock: res = t["fn"](**args)
            else:
                res = t["fn"](**args)
            box["res"] = [text_part(res)] if isinstance(res, str) else res
        except ToolError as e:
            box["err"] = str(e)
        except Exception as e:
            sys.stderr.write(traceback.format_exc())
            box["err"] = "%s failed unexpectedly: %s: %s" % (name, type(e).__name__, e)

    th = threading.Thread(target=work, daemon=True)
    th.start()
    th.join(t["timeout"])
    if th.is_alive():
        if t["browser"]: threading.Thread(target=B.stop, daemon=True).start()     # unwedge it; the next call starts fresh
        box = {"err": "%s timed out after %ss.%s" % (name, t["timeout"], " The browser was reset; call browser_open again." if t["browser"] else "")}
    if "err" in box:
        return {"content": [text_part(box["err"])], "isError": True}
    return {"content": box["res"]}


# --------------------------------------------------------------------- browser tools

@tool("browser_open",
      "Open a URL (http, https or file) in a private headless browser and return the page title, final URL, HTTP status, a screenshot and the page as text with numbered clickable elements.",
      {"url": P("string", "http://, https:// or file:// URL to open."),
       "width": P("integer", "Viewport width in CSS px (default 1280; omit to keep the current size)."),
       "height": P("integer", "Viewport height in CSS px (default 800; omit to keep the current size)."),
       "mobile": P("boolean", "Emulate a phone: touch, 2x pixels, mobile user agent (default false).")},
      ["url"], timeout=120, browser=True)
def browser_open(url, width=None, height=None, mobile=None):
    url = check_url(url)
    B.ensure()
    if width or height or mobile is not None:
        B.vp = {"width": max(100, min(int(width or B.vp["width"]), 4000)),
                "height": max(100, min(int(height or B.vp["height"]), 4000)),
                "mobile": B.vp["mobile"] if mobile is None else bool(mobile)}
        B.apply_viewport()
    B.status = None
    r = B.call("Page.navigate", {"url": url}, 40)
    if r.get("errorText"):
        raise ToolError("Could not load %s: %s. Is the server running and the URL right?" % (url, r["errorText"]))
    B.opened = True
    done = B.wait_loaded(30)
    B.settle()
    head = "Opened %s" % url
    if not done: head += "\n(the page was still loading after 30s; showing what is there)"
    snap_url = (B.evaluate("location.href").get("value") or url)
    head += "\nFinal URL: %s" % snap_url
    if B.status: head += "\nHTTP status: %s" % B.status
    head += "\nViewport: %dx%d%s" % (B.vp["width"], B.vp["height"], " (mobile)" if B.vp["mobile"] else "")
    return B.observe(head)


@tool("browser_snapshot",
      "The current page as text only: title, URL, visible text and a numbered list of clickable/typable elements with positions. Numbers are valid until the next snapshot or navigation.",
      timeout=60, browser=True)
def browser_snapshot():
    B.need_page()
    return fmt_snapshot(B.snapshot())


@tool("browser_screenshot",
      "Screenshot the page (or one element) as an image saved to disk, plus the page as text.",
      {"full_page": P("boolean", "Capture the whole scrollable page instead of the viewport (default false)."),
       "element": P(["integer", "string"], "Snapshot number or CSS selector to capture just that element.")},
      timeout=90, browser=True)
def browser_screenshot(full_page=False, element=None):
    B.need_page()
    clip = None
    if element not in (None, ""):
        r = B.resolve(element)
        clip = {"x": r["px"] + r["left"], "y": r["py"] + r["top"], "width": max(r["w"], 1), "height": max(r["h"], 1)}
    path, w, h, note = B.capture(full_page=bool(full_page), clip=clip)
    text = "Screenshot saved: %s (%dx%d px)%s\n\n%s" % (path, w, h, note, fmt_snapshot(B.snapshot()))
    return [text_part(text), image_part(path)]


@tool("browser_click",
      "Click an element (snapshot number or CSS selector; it is scrolled into view and its centre clicked) or viewport coordinates, then return the new page.",
      {"element": P(["integer", "string"], "Snapshot number or CSS selector."),
       "x": P("number", "Viewport x in CSS px (with y)."), "y": P("number", "Viewport y in CSS px (with x).")},
      timeout=120, browser=True)
def browser_click(element=None, x=None, y=None):
    B.need_page()
    if element not in (None, ""):
        r = B.resolve(element)
        cx, cy = r["x"], r["y"]
    elif x is not None and y is not None:
        cx, cy = float(x), float(y)
    else:
        raise ToolError("browser_click needs element (snapshot number or CSS selector) or both x and y.")
    hit = B.evaluate("(() => { const e = document.elementFromPoint(%f, %f); return e ? '<' + e.tagName.toLowerCase() + '> ' + "
                     "(e.innerText || e.value || e.getAttribute('aria-label') || '').trim().slice(0, 40) : 'nothing'; })()" % (cx, cy)).get("value")
    B.click_at(cx, cy)
    B.after_action()
    return B.observe("Clicked %s at %s,%s" % (hit, fmt_num(cx), fmt_num(cy)))


@tool("browser_type",
      "Focus an input (snapshot number or CSS selector) and type text into it; for a <select>, picks the option by its label or value. Optionally press Enter after.",
      {"element": P(["integer", "string"], "Snapshot number or CSS selector of the field."),
       "text": P("string", "Text to type."),
       "submit": P("boolean", "Press Enter afterwards (default false)."),
       "clear": P("boolean", "Replace what is in the field instead of appending (default true).")},
      ["element", "text"], timeout=90, browser=True)
def browser_type(element, text, submit=False, clear=True):
    B.need_page()
    B.resolve(element, focus=True)
    res = B.evaluate(TYPE_JS.replace("__SPEC__", json.dumps({"text": text, "clear": bool(clear)}))).get("value") or {}
    if not res.get("ok"):
        if res.get("why") == "nooption":
            raise ToolError("No option matches %r. Options: %s" % (text, ", ".join(res.get("options") or [])))
        raise ToolError("That element cannot take text (focused: %s). Pick an input, textarea or select." % (res.get("tag") or res.get("why")))
    if res.get("insert"):
        if text: B.call("Input.insertText", {"text": text})
        elif clear: B.key(parse_key("Backspace"))
    if submit: B.key(parse_key("Enter"))
    B.after_action()
    what = "Selected %r" % res["selected"] if res.get("selected") else "Typed %d characters" % len(text)
    return B.observe(what + (" and pressed Enter" if submit else ""))


@tool("browser_press",
      "Press a key on the focused element: Enter, Tab, Escape, Backspace, Delete, Arrow keys, Home, End, PageUp, PageDown, Space, one character, or a combination like Control+a.",
      {"key": P("string", "Key name, e.g. Enter or Control+a.")}, ["key"], timeout=90, browser=True)
def browser_press(key):
    B.need_page()
    B.key(parse_key(key))
    B.after_action()
    return B.observe("Pressed %s" % key)


@tool("browser_scroll",
      "Scroll the page (or the scrollable area under x,y) with the mouse wheel and return the new view.",
      {"dy": P("number", "Pixels to scroll down (negative = up). Default 600."),
       "dx": P("number", "Pixels to scroll right (negative = left). Default 0."),
       "x": P("number", "Viewport x of the wheel (default: centre)."), "y": P("number", "Viewport y of the wheel (default: centre).")},
      timeout=90, browser=True)
def browser_scroll(dy=600, dx=0, x=None, y=None):
    B.need_page()
    px = float(x) if x is not None else B.vp["width"] / 2
    py = float(y) if y is not None else B.vp["height"] / 2
    B.call("Input.dispatchMouseEvent", {"type": "mouseWheel", "x": px, "y": py, "deltaX": float(dx), "deltaY": float(dy)})
    time.sleep(0.4)
    return B.observe("Scrolled by %s,%s" % (fmt_num(dx), fmt_num(dy)))


@tool("browser_back", "Go back one page in the browser history and return the page.", timeout=90, browser=True)
def browser_back():
    B.need_page()
    h = B.call("Page.getNavigationHistory")
    i = h["currentIndex"]
    if i <= 0: raise ToolError("There is no earlier page in the history.")
    B.call("Page.navigateToHistoryEntry", {"entryId": h["entries"][i - 1]["id"]})
    B.after_action()
    return B.observe("Went back")


@tool("browser_reload", "Reload the current page and return it.", timeout=90, browser=True)
def browser_reload():
    B.need_page()
    B.call("Page.reload")
    B.after_action()
    return B.observe("Reloaded")


@tool("browser_eval",
      "Evaluate a JavaScript expression or IIFE in the page (awaits promises) and return the JSON result, e.g. document.querySelectorAll('li').length.",
      {"js": P("string", "Expression to evaluate; wrap statements in an IIFE to return a value.")},
      ["js"], timeout=60, browser=True)
def browser_eval(js):
    B.need_page()
    r = B.evaluate(js)
    if r.get("type") == "undefined": return "undefined"
    if "value" in r:
        out = json.dumps(r["value"], ensure_ascii=False, default=str, indent=None)
    else:
        out = r.get("unserializableValue") or r.get("description") or "(not serializable: %s)" % r.get("subtype", r.get("type"))
    return out if len(out) <= 8000 else out[:8000] + "\n...[%d more characters not shown]" % (len(out) - 8000)


@tool("browser_console",
      "Console messages, uncaught exceptions and failed or 4xx/5xx network requests collected since the last call.",
      {"clear": P("boolean", "Forget what is returned (default true).")}, timeout=30, browser=True)
def browser_console(clear=True):
    if not B.running(): return "No browser is open, so there is nothing to report. Call browser_open(url)."
    lines = list(B.console)
    if clear: del B.console[:len(lines)]
    return "\n".join(lines) if lines else "No new console messages, exceptions or failed requests."


@tool("browser_resize",
      "Change the viewport size (and optionally phone emulation); the next browser_snapshot/screenshot reflects it.",
      {"width": P("integer", "Width in CSS px."), "height": P("integer", "Height in CSS px."),
       "mobile": P("boolean", "Emulate a phone (default false).")},
      ["width", "height"], timeout=60, browser=True)
def browser_resize(width, height, mobile=False):
    B.vp = {"width": max(100, min(int(width), 4000)), "height": max(100, min(int(height), 4000)), "mobile": bool(mobile)}
    if B.running():
        B.apply_viewport()
        time.sleep(0.3)
        if B.opened: return B.observe("Viewport is now %dx%d%s" % (B.vp["width"], B.vp["height"], " (mobile)" if mobile else ""))
    return "Viewport will be %dx%d%s when the browser opens." % (B.vp["width"], B.vp["height"], " (mobile)" if mobile else "")


@tool("browser_close", "Close the browser and delete its throwaway profile.", timeout=30)
def browser_close():
    B.stop()
    return "Browser closed."


# --------------------------------------------------------------------- iOS Simulator

POINT_SIZES = {   # screenshot pixels (w, h) -> scale; points = pixels / scale
    (1320, 2868): 3, (1206, 2622): 3, (1260, 2736): 3, (1290, 2796): 3, (1179, 2556): 3, (1284, 2778): 3, (1170, 2532): 3,
    (1125, 2436): 3, (1242, 2688): 3, (1080, 2340): 3, (828, 1792): 2, (750, 1334): 2, (640, 1136): 2, (1242, 2208): 3,
    (2048, 2732): 2, (2064, 2752): 2, (1668, 2388): 2, (1668, 2224): 2, (1640, 2360): 2, (1620, 2160): 2, (1488, 2266): 2,
}


def guess_points(w, h):
    """Device points for a screenshot size when AXe is not there to say; the table covers shipped devices."""
    for (a, b), s in POINT_SIZES.items():
        if (w, h) == (a, b) or (w, h) == (b, a): return round(w / s), round(h / s), s
    s = 2 if min(w, h) >= 1500 or min(w, h) < 1000 else 3
    return round(w / s), round(h / s), s


def runtime_name(key):
    m = re.search(r"SimRuntime\.([A-Za-z]+)-(\d+)-(\d+)(?:-(\d+))?", key or "")
    if not m: return key or "unknown", (0, 0, 0)
    parts = [int(x) for x in m.groups()[1:] if x is not None]
    return "%s %s" % (m.group(1), ".".join(str(x) for x in parts)), tuple(parts + [0] * (3 - len(parts)))


def sim_list():
    rc, out, err = run_cmd(["xcrun", "simctl", "list", "devices", "available", "-j"], timeout=30)
    if rc == 127:
        raise ToolError("xcrun was not found. Install Xcode or the command line tools (xcode-select --install).")
    if rc != 0: raise ToolError("simctl could not list devices: %s" % tail(err or out))
    try: data = json.loads(out)
    except ValueError: raise ToolError("simctl returned unreadable device data: %s" % tail(out, 200))
    devs = []
    for key, items in (data.get("devices") or {}).items():
        label, ver = runtime_name(key)
        for d in items:
            if d.get("isAvailable", True):
                devs.append({"udid": d["udid"], "name": d["name"], "state": d.get("state", ""), "runtime": label, "ver": ver})
    return devs


def pick_device(spec, devs):
    booted = [d for d in devs if d["state"] == "Booted"]
    s = (spec or "").strip()
    if not s or s.lower() == "booted":
        if len(booted) == 1: return booted[0]
        if not booted:
            raise ToolError("No simulator is booted. Call simulator_boot(device) first; simulator_devices lists the names.")
        raise ToolError("Several simulators are booted (%s). Pass device= with a name or UDID." % "; ".join(
            "%s [%s] %s" % (d["name"], d["runtime"], d["udid"]) for d in booted))
    low = s.lower()
    for d in devs:
        if d["udid"].lower() == low: return d
    exact = [d for d in devs if d["name"].lower() == low]
    pool = exact or [d for d in devs if low in d["name"].lower()]
    if not pool:
        raise ToolError("No simulator matches %r. simulator_devices lists the names and UDIDs." % s)
    if len({d["name"] for d in pool}) > 1:
        raise ToolError("%r matches several devices: %s. Use a full name or a UDID." % (
            s, "; ".join(sorted({d["name"] for d in pool})[:8])))
    pool.sort(key=lambda d: (d["state"] == "Booted", d["ver"]), reverse=True)
    return pool[0]


def booted_device(spec):
    d = pick_device(spec, sim_list())
    if d["state"] != "Booted":
        raise ToolError("%s (%s) is %s. Call simulator_boot(%r) first." % (d["name"], d["runtime"], d["state"].lower() or "not booted", d["name"]))
    return d


def simctl(*args, timeout=60, env=None):
    return run_cmd(["xcrun", "simctl"] + list(args), timeout=timeout, env=env)


def need_ok(rc, out, err, what):
    if rc != 0:
        raise ToolError("%s failed: %s" % (what, tail(err or out) or "exit code %s" % rc))


@tool("simulator_devices", "List the available iOS Simulator devices grouped by runtime, marking the booted ones.", timeout=60)
def simulator_devices():
    devs = sim_list()
    if not devs: return "No simulator devices are installed. Add a runtime in Xcode > Settings > Components."
    groups = {}
    for d in devs: groups.setdefault((d["ver"], d["runtime"]), []).append(d)
    lines = []
    for (ver, label) in sorted(groups, reverse=True):
        lines.append(label)
        for d in sorted(groups[(ver, label)], key=lambda d: d["name"]):
            lines.append("  %s %s  %s  %s" % ("*" if d["state"] == "Booted" else " ", d["name"], d["udid"], d["state"].upper() if d["state"] == "Booted" else d["state"]))
    nb = sum(1 for d in devs if d["state"] == "Booted")
    lines.append("")
    lines.append("%d booted (marked *)." % nb if nb else "None booted.")
    return "\n".join(lines)


@tool("simulator_boot",
      "Boot a simulator by name or UDID and wait until it is ready. Booted simulators use a lot of memory: call simulator_shutdown when done.",
      {"device": P("string", "Device name (e.g. iPhone 17 Pro) or UDID.")}, ["device"], timeout=330)
def simulator_boot(device):
    d = pick_device(device, sim_list())
    if d["state"] == "Booted": return "%s (%s) is already booted. UDID %s." % (d["name"], d["runtime"], d["udid"])
    rc, out, err = simctl("boot", d["udid"], timeout=60)
    if rc != 0 and "current state: Booted" not in err and "current state: Booting" not in err:
        raise ToolError("Could not boot %s: %s" % (d["name"], tail(err or out)))
    rc, out, err = simctl("bootstatus", d["udid"], timeout=240)
    if rc == 124:
        raise ToolError("%s is still booting after 4 minutes; this Mac is slow or busy. It keeps booting in the background: "
                        "wait a minute and call simulator_devices to see when it shows Booted." % d["name"])
    need_ok(rc, out, err, "Waiting for %s to boot" % d["name"])
    return "Booted %s (%s), UDID %s. Remember simulator_shutdown when finished." % (d["name"], d["runtime"], d["udid"])


@tool("simulator_install", "Install a built .app bundle into a booted simulator.",
      {"app_path": P("string", "Path to the .app (e.g. DerivedData/.../Debug-iphonesimulator/MyApp.app)."),
       "device": P("string", "Device name or UDID; default = the booted simulator.")}, ["app_path"], timeout=180)
def simulator_install(app_path, device=None):
    p = os.path.abspath(os.path.expanduser(app_path))
    if not (p.endswith(".app") and os.path.isdir(p)):
        raise ToolError("%s is not a .app bundle directory. Build for the iphonesimulator SDK and pass the .app inside Build/Products/Debug-iphonesimulator." % app_path)
    d = booted_device(device)
    rc, out, err = simctl("install", d["udid"], p, timeout=150)
    need_ok(rc, out, err, "Installing on %s" % d["name"])
    return "Installed %s on %s." % (os.path.basename(p), d["name"])


@tool("simulator_launch", "Launch an installed app by bundle id (restarting it if running) and report its pid.",
      {"bundle_id": P("string", "Bundle identifier, e.g. com.example.App."),
       "device": P("string", "Device name or UDID; default = the booted simulator."),
       "env": P("object", "Environment variables for the app.", additionalProperties={"type": "string"}),
       "args": P("array", "Launch arguments for the app.", items={"type": "string"}),
       "terminate_running": P("boolean", "Terminate an already running copy first (default true).")},
      ["bundle_id"], timeout=90)
def simulator_launch(bundle_id, device=None, env=None, args=None, terminate_running=True):
    d = booted_device(device)
    cmd = ["launch"] + (["--terminate-running-process"] if terminate_running else []) + [d["udid"], bundle_id] + [str(a) for a in (args or [])]
    e = dict(os.environ)
    for k, v in (env or {}).items(): e["SIMCTL_CHILD_" + str(k)] = str(v)
    rc, out, err = simctl(*cmd, timeout=60, env=e)
    if rc != 0:
        hint = " Is it installed? Use simulator_install first." if "not found" in (err + out).lower() or "NotFound" in err else ""
        raise ToolError("Launching %s failed: %s%s" % (bundle_id, tail(err or out), hint))
    return "Launched %s on %s (%s). Next: simulator_screenshot." % (bundle_id, d["name"], out.strip() or "no pid reported")


@tool("simulator_terminate", "Stop a running app in a simulator.",
      {"bundle_id": P("string", "Bundle identifier."), "device": P("string", "Device name or UDID; default = the booted simulator.")},
      ["bundle_id"], timeout=60)
def simulator_terminate(bundle_id, device=None):
    d = booted_device(device)
    rc, out, err = simctl("terminate", d["udid"], bundle_id, timeout=30)
    need_ok(rc, out, err, "Terminating %s" % bundle_id)
    return "Terminated %s on %s." % (bundle_id, d["name"])


@tool("simulator_open_url", "Open a URL or deep link in a booted simulator (web URLs open Safari; app schemes open the app).",
      {"url": P("string", "URL or custom-scheme deep link."), "device": P("string", "Device name or UDID; default = the booted simulator.")},
      ["url"], timeout=60)
def simulator_open_url(url, device=None):
    d = booted_device(device)
    rc, out, err = simctl("openurl", d["udid"], url, timeout=30)
    need_ok(rc, out, err, "Opening %s" % url)
    return "Opened %s on %s." % (url, d["name"])


def sim_screen_text(d, w, h):
    """Screenshot facts a text-only model needs: what coordinates mean, plus the on-screen elements."""
    pw, ph, scale = guess_points(w, h) if w and h else (0, 0, 0)
    lines = []
    try:
        backend = input_backend()
        rc, out, err = run_cmd(describe_cmd(backend, d["udid"]), timeout=20)
        elements, frame = flatten_ui(out) if rc == 0 else ([], None)
        if frame: pw, ph = frame
        if elements:
            lines.append("On-screen elements, [n] type \"label\" @ x,y WxH in device points:")
            lines += elements
        else:
            lines.append("(no accessibility elements reported%s)" % ("" if rc == 0 else ": " + tail(err, 120)))
    except ToolError:
        lines.append("(on-screen element list unavailable without AXe: brew install cameroncooke/axe/axe)")
    return pw, ph, lines


def sim_observe(d, header):
    path = new_shot_path("sim")
    rc, out, err = simctl("io", d["udid"], "screenshot", "--type=png", path, timeout=45)
    need_ok(rc, out, err, "Screenshot of %s" % d["name"])
    full_w, full_h = png_size(path)                    # device pixels, before any shrinking
    path, w, h = finish_shot(path)
    pw, ph, lines = sim_screen_text(d, full_w, full_h)
    info = "%s\nDevice: %s (%s), %d x %d points. Screenshot saved: %s (%dx%d px)." % (header, d["name"], d["runtime"], pw, ph, path, w, h)
    if pw and w:
        info += " Multiply image pixel coordinates by %.2f to get device points." % (pw / float(w))
    return [text_part(info + "\n" + "\n".join(lines)), image_part(path)]


@tool("simulator_screenshot", "Screenshot a booted simulator (works without Simulator.app); also returns the on-screen element list when AXe is installed.",
      {"device": P("string", "Device name or UDID; default = the only booted simulator.")}, timeout=90)
def simulator_screenshot(device=None):
    return sim_observe(booted_device(device), "Simulator screen.")


@tool("simulator_shutdown", "Shut down one simulator, or every simulator with device=\"all\". Leaving them booted slows the Mac.",
      {"device": P("string", "Name, UDID, or \"all\" (default: the only booted simulator).")}, timeout=90)
def simulator_shutdown(device=None):
    if (device or "").strip().lower() == "all":
        rc, out, err = simctl("shutdown", "all", timeout=80)
        need_ok(rc, out, err, "Shutting down all simulators")
        return "All simulators shut down."
    d = pick_device(device, sim_list())
    if d["state"] != "Booted": return "%s is already shut down." % d["name"]
    rc, out, err = simctl("shutdown", d["udid"], timeout=60)
    if rc != 0 and "current state: Shutdown" not in err: need_ok(rc, out, err, "Shutting down %s" % d["name"])
    return "Shut down %s." % d["name"]


@tool("simulator_logs", "Recent log lines for an app (bundle id) or process in a booted simulator; errors only by default. Returns the last ~60 lines.",
      {"bundle_id_or_process": P("string", "Bundle id (com.example.App) or process name."),
       "seconds": P("integer", "How many seconds of history to search (default 5)."),
       "errors_only": P("boolean", "Only error and fault messages (default true)."),
       "device": P("string", "Device name or UDID; default = the booted simulator.")},
      ["bundle_id_or_process"], timeout=90)
def simulator_logs(bundle_id_or_process, seconds=5, errors_only=True, device=None):
    name = bundle_id_or_process.strip()
    if not re.fullmatch(r"[\w.\- ]{1,120}", name):
        raise ToolError("Give a bundle id or process name using only letters, digits, dots, dashes and underscores.")
    d = booted_device(device)
    secs = max(1, min(int(seconds), 3600))
    exe = name
    if "." in name:
        rc, out, err = simctl("get_app_container", d["udid"], name, "app", timeout=15)
        if rc == 0:
            rc2, out2, _ = run_cmd(["plutil", "-extract", "CFBundleExecutable", "raw", "-o", "-", os.path.join(out.strip(), "Info.plist")], timeout=10)
            if rc2 == 0 and out2.strip(): exe = out2.strip()
    pred = '(process == "%s" OR subsystem == "%s")' % (exe, name)
    if errors_only: pred += " AND (messageType == error OR messageType == fault)"
    rc, out, err = simctl("spawn", d["udid"], "log", "show", "--last", "%ds" % secs, "--style", "compact", "--predicate", pred, timeout=60)
    need_ok(rc, out, err, "Reading logs")
    lines = [l for l in out.splitlines() if l.strip() and not l.startswith(("Timestamp", "Filtering the log", "Log -"))]
    if not lines: return "No %s log lines for %s in the last %ds on %s." % ("error" if errors_only else "", name, secs, d["name"])
    return "%d line(s) for %s (last %ds), newest last:\n%s" % (len(lines[-60:]), name, secs, "\n".join(lines[-60:]))


# input goes through AXe or idb: simctl cannot tap

def input_backend():
    for exe in ("axe", "idb"):
        p = shutil.which(exe)
        if not p:
            for root in ("/opt/homebrew/bin", "/usr/local/bin"):
                if os.access(os.path.join(root, exe), os.X_OK): p = os.path.join(root, exe)
        if p: return (exe, p)
    raise ToolError(AXE_MISSING)


def describe_cmd(backend, udid):
    kind, exe = backend
    return [exe, "describe-ui", "--udid", udid] if kind == "axe" else [exe, "ui", "describe-all", "--udid", udid, "--json"]


def input_cmd(backend, action, udid, **a):
    kind, exe = backend
    n = fmt_num
    if kind == "axe":
        if action == "tap": return [exe, "tap", "-x", n(a["x"]), "-y", n(a["y"]), "--udid", udid]
        if action == "swipe":
            return [exe, "swipe", "--start-x", n(a["x1"]), "--start-y", n(a["y1"]), "--end-x", n(a["x2"]), "--end-y", n(a["y2"]),
                    "--duration", str(a["duration"]), "--udid", udid]
        if action == "type": return [exe, "type", "--udid", udid, "--", a["text"]]
        if action == "button": return [exe, "button", a["name"], "--udid", udid]
        if action == "tap_element":
            c = [exe, "tap"]
            for flag, key in (("--label", "label"), ("--id", "id"), ("--value", "value"), ("--element-type", "element_type")):
                if a.get(key): c += [flag, str(a[key])]
            return c + ["--udid", udid]
        if action == "long_press":
            return [exe, "touch", "-x", n(a["x"]), "-y", n(a["y"]), "--down", "--up", "--delay", str(a["seconds"]), "--udid", udid]
        if action == "drag":
            return [exe, "drag", "--start-x", n(a["x1"]), "--start-y", n(a["y1"]), "--end-x", n(a["x2"]), "--end-y", n(a["y2"]),
                    "--duration", str(a["duration"]), "--udid", udid]
        if action == "key": return [exe, "key", str(a["code"]), "--udid", udid]
        if action == "key_combo": return [exe, "key-combo", "--modifiers", ",".join(str(m) for m in a["modifiers"]), "--key", str(a["code"]), "--udid", udid]
        if action == "gesture":
            c = [exe, "gesture", a["preset"]]
            if a.get("screen"): c += ["--screen-width", str(a["screen"][0]), "--screen-height", str(a["screen"][1])]
            return c + ["--udid", udid]
    else:
        if action in ("tap_element", "long_press", "drag", "key", "key_combo", "gesture"):
            raise ToolError("%s needs AXe: brew install cameroncooke/axe/axe (idb does not have it)." % action.replace("_", " "))
        if action == "tap": return [exe, "ui", "tap", n(a["x"]), n(a["y"]), "--udid", udid]
        if action == "swipe":
            return [exe, "ui", "swipe", n(a["x1"]), n(a["y1"]), n(a["x2"]), n(a["y2"]), "--duration", str(a["duration"]), "--udid", udid]
        if action == "type": return [exe, "ui", "text", "--udid", udid, a["text"]]
        if action == "button": return [exe, "ui", "button", a["name"].upper().replace("-", "_"), "--udid", udid]
    raise ToolError("Unsupported input action %s." % action)


def num_list(s):
    return [float(x) for x in re.findall(r"-?\d+(?:\.\d+)?", s)]


def frame_of(node):
    f = node.get("frame") or node.get("AXFrame")
    if isinstance(f, dict):
        try: return float(f["x"]), float(f["y"]), float(f["width"]), float(f["height"])
        except (KeyError, TypeError, ValueError): return None
    if isinstance(f, str):
        v = num_list(f)
        return tuple(v[:4]) if len(v) >= 4 else None
    return None


INTERACTIVE = {"button", "textfield", "securetextfield", "searchfield", "switch", "slider", "link", "cell", "tab", "tabbutton",
               "textview", "stepper", "picker", "segmentedcontrol", "toggle", "menuitem", "checkbox", "image", "statictext", "tabbar"}


def flatten_ui(raw, limit=200):
    """AXe/idb accessibility JSON -> (numbered lines, (screen width, height) in points). Only what is on the screen: a long
    list (a chat of hundreds of messages) reports every row it has, most far above or below, and the first 150 were all
    off-screen ones, so the composer and the buttons you can actually tap never made the list."""
    try: data = json.loads(raw)
    except ValueError: return ([l for l in raw.splitlines() if l.strip()][:limit], None)
    roots = data if isinstance(data, list) else [data]
    lines, screen, off = [], [None], [0]

    def visible(fr):
        if not screen[0]: return True
        w, h = screen[0]
        return fr[0] < w and fr[0] + fr[2] > 0 and fr[1] < h and fr[1] + fr[3] > 0

    def walk(n):
        if not isinstance(n, dict): return
        typ = str(n.get("type") or n.get("role") or n.get("role_description") or "").replace("AX", "")
        label = n.get("AXLabel") or n.get("label") or n.get("title") or n.get("name") or ""
        val = n.get("AXValue") if n.get("AXValue") is not None else n.get("value")
        ident = n.get("AXUniqueId") or n.get("identifier") or ""
        fr = frame_of(n)
        if fr and typ.lower() in ("application", "window") and screen[0] is None: screen[0] = (round(fr[2]), round(fr[3]))
        if (label or val or ident or typ.lower() in INTERACTIVE) and typ.lower() not in ("application", "window") and fr and not visible(fr):
            off[0] += 1
        elif (label or val or ident or typ.lower() in INTERACTIVE) and typ.lower() not in ("application", "window") and fr and len(lines) < limit:
            bits = ["[%d] %s" % (len(lines), typ or "element")]
            if label: bits.append('"%s"' % str(label).replace("\n", " ")[:80])
            if val not in (None, "", label): bits.append("value=%r" % str(val)[:60])
            if ident and ident != label: bits.append("id=%s" % ident)
            if n.get("enabled") is False: bits.append("disabled")
            bits.append("@ %s,%s %sx%s" % tuple(fmt_num(x) for x in fr))
            lines.append(" ".join(bits))
        for c in n.get("children") or []: walk(c)

    for r in roots: walk(r)
    if off[0]: lines.append("(%d more elements are off-screen: scroll to reach them)" % off[0])
    return lines, screen[0]


def sim_input(action, device, header, **a):
    backend = input_backend()
    d = booted_device(device)
    rc, out, err = run_cmd(input_cmd(backend, action, d["udid"], **a), timeout=30)
    need_ok(rc, out, err, "%s %s" % (backend[0], action))
    time.sleep(0.7)
    return sim_observe(d, header)


