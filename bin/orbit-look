BUTTONS = {"home": "home", "lock": "lock", "side": "side-button", "side-button": "side-button", "side_button": "side-button",
           "siri": "siri", "apple-pay": "apple-pay", "applepay": "apple-pay", "apple_pay": "apple-pay"}


@tool("simulator_button", "Press a hardware button: home, lock, side-button, siri or apple-pay. Needs AXe or idb. Returns the new screen.",
      {"name": P("string", "home, lock, side-button, siri or apple-pay."), "device": P("string", "Device name or UDID; default = the booted simulator.")},
      ["name"], timeout=90)
def simulator_button(name, device=None):
    b = BUTTONS.get(name.strip().lower())
    if not b: raise ToolError("Unknown button %r. Use home, lock, side-button, siri or apple-pay." % name)
    return sim_input("button", device, "Pressed %s." % b, name=b)


KEYCODES = {"return": 40, "enter": 40, "escape": 41, "esc": 41, "delete": 42, "backspace": 42, "tab": 43, "space": 44,
            "right": 79, "left": 80, "down": 81, "up": 82, "home": 74, "end": 77, "pageup": 75, "pagedown": 78}
KEYCODES.update({c: 4 + i for i, c in enumerate("abcdefghijklmnopqrstuvwxyz")})
KEYCODES.update({c: 30 + i for i, c in enumerate("123456789")}); KEYCODES["0"] = 39
MODIFIERS = {"ctrl": 224, "control": 224, "shift": 225, "alt": 226, "option": 226, "cmd": 227, "command": 227}
GESTURES = ("scroll-up", "scroll-down", "scroll-left", "scroll-right", "swipe-from-left-edge", "swipe-from-right-edge",
            "swipe-from-top-edge", "swipe-from-bottom-edge")


@tool("simulator_tap_element", "Tap a control by its accessibility label, id or value instead of coordinates (find them with simulator_ui). More robust than simulator_tap: no scaling, it follows the element. Needs AXe. Returns the new screen.",
      {"label": P("string", "The element's accessibility label, e.g. the button's text."),
       "id": P("string", "Its accessibilityIdentifier."), "value": P("string", "Its current value."),
       "element_type": P("string", "Narrow the match: Button, TextField, Switch, Cell..."),
       "device": P("string", "Device name or UDID; default = the booted simulator.")}, timeout=90)
def simulator_tap_element(label=None, id=None, value=None, element_type=None, device=None):
    if not (label or id or value): raise ToolError("Give a label, an id or a value to find the element by (simulator_ui lists them).")
    return sim_input("tap_element", device, "Tapped %s." % (label or id or value), label=label, id=id, value=value, element_type=element_type)


