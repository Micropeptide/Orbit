@tool("simulator_drag", "Drag from one point to another with explicit touch moves (reorder a list, move a slider, pull a sheet). Slower and more exact than a swipe. Needs AXe. Returns the new screen.",
      {"x1": P("number", "Start x in device points."), "y1": P("number", "Start y."), "x2": P("number", "End x."), "y2": P("number", "End y."),
       "duration": P("number", "Seconds (default 0.6)."), "device": P("string", "Device name or UDID; default = the booted simulator.")},
      ["x1", "y1", "x2", "y2"], timeout=90)
