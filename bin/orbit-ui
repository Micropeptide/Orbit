        if p == "/api/truncate":
            idx = int(d.get("index", 0))
            # edits belong to the chat the browser names, not to whatever chat the
            # server happens to have open
            want = d.get("id")
            if want and want != S.sid:
                return self._send(409, jdump({"error": "open that chat first"}))
            # a client counting from a stale copy must not cut the wrong turn:
            # if it says what the message starts with, hold it to that
            check = str(d.get("check") or "").strip()[:80]
            with LOCK:
                keep, seen = [], 0
                for m in S.msgs:
                    if m.get("role") == "user":
                        if seen == idx:
                            if check and not _msg_text(m).strip().startswith(check):
                                return self._send(409, jdump({
                                    "error": "that chat changed elsewhere — reopen it and try again"}))
                            break
                        seen += 1
                    keep.append(m)
                S.msgs = keep
                save_session()
            return self._send(200, jdump({"ok": True, "n": len(S.msgs)}))
        if p == "/api/files/delete":
            return self._send(200, jdump({"ok": q.delete_file(d.get("rel",""))}))
