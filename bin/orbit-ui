        if p == "/api/session/assign":
            q.session_meta(d.get("id"), project=d.get("project"))
            with LOCK:
                other = STATES.get(d.get("id"))
                if other is not None and other is not S:
                    other.project = d.get("project")
                if S.sid == d.get("id"):
                    S.project = d.get("project")
                    q.ACTIVE_PROJECT["id"] = S.project
                    S.msgs[0]["content"] = q.system_prompt_for(S.agent, S.project)
            return self._send(200, jdump({"ok": True}))
        if p == "/api/session/reorder":
            ids = d.get("order") or []
            for i, sid in enumerate(ids):
                q.session_meta(sid, order=i)
            return self._send(200, jdump({"ok": True, "reordered": len(ids)}))
        if p == "/api/session/sort_recent":
            for s_ in q.session_list():
                if s_.get("order") is not None:
                    raw = json.load(open(q.session_path(s_["id"])))
                    if isinstance(raw, dict):
                        raw.pop("order", None)
                        q._atomic_write(q.session_path(s_["id"]), raw)
            q._SESS_CACHE["key"] = None
            return self._send(200, jdump({"ok": True}))
        if p == "/api/remote/mode":
            _HOSTS["at"] = 0.0          # the cached host list belongs to the old mode
            want = (d.get("mode") or "off").strip()
            if want not in ("off", "tailscale", "lan"):
                return self._send(400, jdump({"error": "mode must be off, tailscale or lan"}))
            if want == "tailscale" and not REMOTE.tailscale_ip():
                return self._send(409, jdump({
                    "error": "Tailscale is not running — start it, then try again"}))
            cfg = dict(q.S.get("remote_access") or {})
            cfg["mode"] = want
            q.S["remote_access"] = cfg
            q.save_settings(q.S)
            if want != "off": REMOTE.load_token(q.ROOT, create=True)
            return self._send(200, jdump({"ok": True, "mode": want,
                                          "restart_required": True}))
        if p == "/api/remote/rotate":
            REMOTE.rotate_token(q.ROOT)
            return self._send(200, jdump({"ok": True,
                                          "note": "every paired device must scan again"}))
        if p == "/api/model/select":
            # per chat, so a Claude answer and a local one can sit side by side
            mid = (d.get("id") or "").strip() or None
            st = get_state(d.get("sid")) if d.get("sid") else S
            if mid and mid.startswith("local-dir:"):
                return self._send(409, jdump({
                    "error": "that local model is not loaded",
                    "switch": mid.split(":", 1)[1]}))
            with LOCK:
                st.model = mid
                if not st.temp and os.path.exists(q.session_path(st.sid)): save_session(st)
                else: st.flags["model"] = mid
                if st is S: q.ACTIVE_MODEL["id"] = mid
            spec = q.current_model(mid)
            codex_on = q.S.get("codex_mode") and mid and spec and q.CX.is_engine(spec)
            if (q.S.get("harness_mode") and mid and spec and q.CE.is_engine(spec)) or codex_on:
                # in Claude Code (or Codex) mode the last model chosen is where new chats start
                reg = q.MODELS.load(q.ROOT)
                if reg.get("default") != mid:
                    reg["default"] = mid; q.MODELS.save(q.ROOT, reg)
                key = "codex_recent" if codex_on else "harness_recent"
                with LOCK:
                    cur = q.load_settings()
                    recent = [r for r in (cur.get(key) or []) if r.get("id") != mid]
                    cur[key] = ([{"id": mid, "label": spec.get("label") or mid}] + recent)[:6]
                    q.save_settings(cur); q.reload_settings()
            return self._send(200, jdump({"ok": True, "id": mid,
                                          "resolved": spec and spec["id"]}))
        if p == "/api/model/default":
            cfg = q.MODELS.load(q.ROOT); cfg["default"] = (d.get("id") or "").strip()
            q.MODELS.save(q.ROOT, cfg)
            return self._send(200, jdump({"default": cfg["default"]}))
        if p == "/api/model/local_switch":
            # restarting the server takes a while; the UI polls status after
            return self._send(200, jdump(q.switch_local_model(d.get("name") or "")))
        if p == "/api/model/fetch":
            cfg = q.MODELS.load(q.ROOT)
            pid = d.get("provider") or ""
            prov = cfg["providers"].get(pid)
            if not prov: return self._send(404, jdump({"error": "no such provider"}))
            sec = q.secrets_load()
            key = sec.get(prov.get("key") or "") or os.environ.get(prov.get("key") or "") or ""
            res = q.MODELS.fetch_models(prov, key)
            if res.get("error"): return self._send(200, jdump(res))
            have = {(m["provider"], m["model"]) for m in cfg["models"]}
            for m in res["models"]:
                if (pid, m["model"]) not in have:
                    cfg["models"].append({**m, "provider": pid})
            q.MODELS.save(q.ROOT, cfg)
            return self._send(200, jdump({"found": len(res["models"]),
                                          "models": q.model_catalogue()}))
        if p == "/api/model/forget":
            cfg = q.MODELS.load(q.ROOT)
            mid = d.get("id") or ""
            cfg["models"] = [m for m in cfg["models"]
                             if q.MODELS.model_id(m["provider"], m["model"]) != mid]
            if mid not in cfg["hidden"]: cfg["hidden"].append(mid)
            q.MODELS.save(q.ROOT, cfg)
            return self._send(200, jdump({"ok": True, "models": q.model_catalogue()}))
        if p == "/api/model/provider":
            cfg = q.MODELS.load(q.ROOT)
            pid = (d.get("id") or "").strip()
            if not pid: return self._send(400, jdump({"error": "a provider needs an id"}))
            cfg["providers"][pid] = {**cfg["providers"].get(pid, {}),
                                     **{k: v for k, v in (d.get("provider") or {}).items()
                                        if k in ("label","kind","base_url","key","note")}}
            q.MODELS.save(q.ROOT, cfg)
            return self._send(200, jdump({"ok": True, "providers": cfg["providers"]}))
        if p == "/api/project/select":
            with LOCK:
                S.project = d.get("id") or None
                q.ACTIVE_PROJECT["id"] = S.project
                S.msgs[0]["content"] = q.system_prompt_for(S.agent, S.project)
                save_session()
            return self._send(200, jdump({"project": S.project}))
        if p == "/api/temp":
            with LOCK:
                q.reload_settings()
            fresh_state(temp=bool(d.get("on", True)))
            return self._send(200, jdump({"temp": S.temp, "sid": S.sid}))
        if p == "/api/burn":
            # erases only a TEMPORARY chat. It used to delete whichever chat was
            # current, file and all, bypassing the bin -- so a page that still
            # thought it was in temporary mode erased a real chat on reload
            with LOCK:
                was = S.sid
                if not S.temp or (d.get("sid") and d.get("sid") != was):
                    return self._send(409, jdump({"ok": False, "error":
                        "not a temporary chat — nothing erased (use Delete to move a chat to the bin)"}))
                try:
                    if os.path.exists(q.session_path(was)): os.remove(q.session_path(was))
                except OSError: pass
            fresh_state(temp=True)
            return self._send(200, jdump({"ok": True, "erased": was, "sid": S.sid}))
        if p == "/api/sysprompt":
            with LOCK:
                S.sys_override = (d.get("text") or "").strip() or None
                q.CE.set_chat_pref(S.sid, instructions=S.sys_override)   # a Claude Code chat's own instructions
                base = q.system_prompt_for(S.agent)
                S.msgs[0]["content"] = (base + "\n\n## This chat\n" + S.sys_override
                                        if S.sys_override else base)
                save_session()
            return self._send(200, jdump({"ok": True}))
        if p == "/api/branch":
            new = q.session_branch(d.get("id") or S.sid, int(d.get("index", 0)), d.get("title"))
            return self._send(200, jdump({"sid": new}))
        if p == "/api/tag":
            sid = d.get("id") or S.sid
            tags = d.get("tags") or []
            if not os.path.exists(q.session_path(sid)):
                get_state(sid).flags["tags"] = tags
                return self._send(200, jdump({"ok": True, "pending": True}))
            raw = q.session_meta(sid, tags=tags)
            return self._send(200, jdump({"ok": bool(raw)}))
        if p == "/api/trash/restore":
            return self._send(200, jdump({"ok": q.trash_restore(d.get("name",""))}))
        if p == "/api/trash/purge":
            return self._send(200, jdump({"purged": q.trash_purge(d.get("name") or None)}))
        if p == "/api/secrets/save":
            # merged into what is saved: sending one provider's key used to replace
            # the whole file, erasing every other key. An empty value removes a key.
            merged = dict(q.secrets_load())
            for k, v in (d.get("secrets") or {}).items():
                if not _re.match(r"^[A-Z][A-Z0-9_]{1,63}$", str(k)): continue
                # a key or token never contains spaces: one copied across a wrapped terminal
                # line comes with a space (or line break) inside it, and is then rejected
                if v: merged[k] = re.sub(r"\s+", "", str(v)) if k.endswith(("_KEY", "_TOKEN")) else str(v).strip()
                else: merged.pop(k, None); os.environ.pop(k, None)
            return self._send(200, jdump(q.secrets_save(merged)))
        if p == "/api/schedule/save":
            cfg, err = schedule_save(d.get("job") or {})
            if err: return self._send(400, jdump({"error": err}))
            return self._send(200, jdump(cfg))
        if p == "/api/schedule/delete":
            cfg = q.sched_load()
            cfg["jobs"] = [j for j in cfg.get("jobs", []) if j.get("id") != d.get("id")]
            q.sched_save(cfg)
            return self._send(200, jdump(cfg))
        if p == "/api/schedule/run":
            jid = d.get("id")
            job = next((j for j in q.sched_load().get("jobs", []) if j["id"] == jid), None)
            if not job: return self._send(404, jdump({"error": "no such job"}))
            threading.Thread(target=run_job, args=(job,), daemon=True).start()
            return self._send(200, jdump({"started": jid}))
        if p == "/api/skill/capture":
            # a Claude Code chat's procedure becomes a Claude skill (~/.claude/skills)
            writer = q.CE.write_claude_skill if q.CE.is_engine(q.current_model(S.model)) else None
            with LOCK: name = q.capture_skill(S.msgs, d.get("name") or "captured-skill", writer)
            return self._send(200, jdump({"ok": bool(name), "name": name}))
        if p == "/api/support":
            return self._send(200, jdump({"rows": q.support_check(d.get("answer",""),
                                                                  d.get("sources") or [])}))
        if p == "/api/citations":
            return self._send(200, jdump({"rows": q.check_citations(d.get("text",""))}))
        if p == "/api/backup":
            return self._send(200, jdump(q.export_setup()))
        if p == "/api/backup/now":
            return self._send(200, jdump(q.backup_now("manual")))
        if p == "/api/backup/settings":
            return self._send(200, jdump(q.backup_set(d if isinstance(d, dict) else {})))
        if p == "/api/backup/restore_missing":
            return self._send(200, jdump(q.backup_restore_missing(d.get("name"))))
        if p == "/api/restore":
            return self._send(200, jdump(q.import_setup(d.get("path",""), d.get("what"))))
        if p == "/api/h2/jobs":
            return self._send(200, jdump(q.cluster_jobs_detailed()))
        if p == "/api/h2/log":
            return self._send(200, jdump({"log": q.cluster_job_log(d.get("id"), d.get("lines", 80))}))
        if p == "/api/h2/estimate":
            return self._send(200, jdump(q.cluster_estimate(d.get("name","")) or {}))
        if p == "/api/h2/poll":
            return self._send(200, jdump(q.cluster_poll()))
        if p == "/api/knowledge/from_upload":
            rel = d.get("rel","")
            src = os.path.normpath(os.path.join(q.WORKSPACE, rel))
            if not os.path.exists(src): return self._send(404, jdump({"error":"missing"}))
            q.know_add_bytes(os.path.basename(src), open(src,"rb").read())
            return self._send(200, jdump(q.know_reindex()))
        if p == "/api/files/rename":
            old = os.path.normpath(os.path.join(q.WORKSPACE, d.get("rel","")))
            new = os.path.normpath(os.path.join(os.path.dirname(old),
                                                os.path.basename(d.get("name","renamed"))))
            ok = (old.startswith(os.path.abspath(q.WORKSPACE)) and
                  new.startswith(os.path.abspath(q.WORKSPACE)) and os.path.isfile(old))
            if ok:
                try: os.replace(old, new)
                except OSError: ok = False
            return self._send(200, jdump({"ok": ok}))
        if p == "/api/queue":
            st = get_state(d.get("sid")) if d.get("sid") else None
            if st is None: return self._send(400, jdump({"error": "which chat?"}))
            op, iid = d.get("op", ""), d.get("id")
            find = lambda: next((it for it in st.queue if it["id"] == iid), None)
            if op == "add":
                try: _queue_add(st, d.get("text", ""), d.get("attachments"), d.get("effort"), at=d.get("at"),
                                repeat=d.get("repeat"), model=d.get("model"))
                except ValueError as e: return self._send(400, jdump({"error": str(e)}))
            elif op == "update":
                it, err = queue_update(st, iid, {k: d[k] for k in ("text", "at", "repeat", "model") if k in d})
                if err: return self._send(404 if "started" in err else 400, jdump({"error": err}))
            elif op == "schedule":
                # set, change or clear when a waiting message goes out
                it = find()
                if not it: return self._send(404, jdump({"error": "that message has already started"}))
                rp = d.get("repeat") or None
                if rp and rp not in REPEATS: return self._send(400, jdump({"error": "repeat must be daily, weekdays or weekly"}))
                if d.get("at"):
                    at = float(d["at"])
                    it["at"] = _next_time(at, rp) if rp and at <= time.time() else at
                    it.pop("missed", None)
                    if rp: it["repeat"] = rp
                    else: it.pop("repeat", None)
                else:
                    for k in ("at", "repeat", "missed", "skipped"): it.pop(k, None)
                _queue_saved(st)
            elif op == "edit":
                it = find()
                if not it: return self._send(404, jdump({"error": "that message has already started"}))
                it["text"] = str(d.get("text") or "")
                _queue_saved(st)
            elif op == "remove":
                st.queue = [it for it in st.queue if it["id"] != iid]; _queue_saved(st)
            elif op == "order":
                ids = [str(x) for x in d.get("ids") or []]
                pos = {x: i for i, x in enumerate(ids)}
                st.queue.sort(key=lambda it: pos.get(it["id"], len(pos)))
                _queue_saved(st)
            elif op == "now":
                # this one goes in right away: into the answer running now, as a note
                # it reads at its next step -- or, if nothing is running, it starts
                it = find()
                if not it: return self._send(404, jdump({"error": "that message has already started"}))
                st.queue = [x for x in st.queue if x["id"] != iid]
                if it.get("repeat") in REPEATS and it.get("at"):
                    # sending a repeating one early keeps the series, whichever way it goes in
                    st.queue.append(dict(it, id=uuid.uuid4().hex[:10], at=_next_time(float(it["at"]), it["repeat"])))
                if st.lock.locked() and not it.get("attachments"):
                    _queue_saved(st)
                    st.inbox.append({"text": it["text"], "t": time.time()}); st.interrupt.set()
                    return self._send(200, jdump({"ok": True, "interjected": True, "queue": _queue_view(st)}))
                it = {k: v for k, v in it.items() if k not in ("at", "repeat", "missed", "skipped")}
                st.queue.insert(0, it); st.queue_paused = False; _queue_saved(st)
            elif op in ("pause", "resume"):
                st.queue_paused = op == "pause"; _queue_saved(st)
            elif op == "clear":
                st.queue = []; st.queue_paused = False; _queue_saved(st)
            elif op != "get":
                return self._send(400, jdump({"error": f"unknown op {op}"}))
            if op in ("add", "now", "resume", "schedule", "update"): _drain()
            return self._send(200, jdump({"ok": True, "queue": _queue_view(st)}))
        if p == "/api/scheduled":
            # everything scheduled: messages waiting in any chat, and tasks
            return self._send(200, jdump({"messages": scheduled_messages(), "tasks": [
                {**j, "next_ts": q.sched_next_ts(j), "next": q.sched_next(j)} for j in q.sched_load().get("jobs", [])],
                "default_model": (q.MODELS.load(q.ROOT) or {}).get("default")}))
        if p == "/api/scheduled_sends":
            out = []
            try: idx = json.load(open(QUEUE_INDEX))
            except Exception: idx = {}
            for qsid in set(idx) | {k for k, v in STATES.items() if v.queue}:
                if qsid not in STATES and not os.path.exists(q.session_path(qsid)): continue
                stt = get_state(qsid)
                for it in stt.queue:
                    if it.get("at"):
                        out.append({"sid": qsid, "title": stt.title, "id": it["id"], "text": it.get("text", "")[:300],
                                    "at": it["at"], "repeat": it.get("repeat"), "missed": bool(it.get("missed"))})
            out.sort(key=lambda x: x["at"])
            return self._send(200, jdump({"items": out}))
        if p == "/api/interject":
            # A note for an answer that is still running: queued, and handed to
            # the model at its next step. The interrupt cuts a long generation
            # short so the note is read now, not after it finishes writing — a
            # tool that is mid-run is never killed for it.
            st = STATES.get(d.get("sid") or S.sid)
            text = (d.get("message") or "").strip()
            if not text: return self._send(400, jdump({"error": "empty note"}))
            if st is None or not st.lock.locked():
                return self._send(200, jdump({"ok": False, "running": False}))
            st.inbox.append({"text": text, "t": time.time()})
            st.interrupt.set()
            return self._send(200, jdump({"ok": True, "queued": len(st.inbox)}))
        if p == "/api/cancel":
            if d.get("sid") in JOB_RUNS:           # a scheduled run in its own chat
                JOB_RUNS[d["sid"]].set()
                return self._send(200, jdump({"ok": True, "sid": d["sid"]}))
            st = get_state(d.get("sid"), create=False)
            st.cancel.set()
            return self._send(200, jdump({"ok": True, "sid": st.sid}))
        if p == "/api/running":
            return self._send(200, jdump({"running": running_sids(),
                                          "max": (_max_parallel() if _max_parallel() < 10**6 else None)}))
        if p == "/api/prompts/save":
            pr = q.prompts_load(); pr[d.get("name","untitled")] = {"text": d.get("text",""),
                                                                   "desc": d.get("desc","")}
            q.prompts_save(pr)
            return self._send(200, jdump({"ok": True, "prompts": pr}))
        if p == "/api/prompts/delete":
            pr = q.prompts_load(); pr.pop(d.get("name",""), None); q.prompts_save(pr)
            return self._send(200, jdump({"ok": True, "prompts": pr}))
        if p == "/api/continue":
            return self._send(200, jdump({"ok": True,
                "message": "Continue from where you stopped. Check `plan` for outstanding "
                           "steps and finish them. Do not restate what you already did."}))
        if p == "/api/retry_harder":
            with LOCK:
                while S.msgs and S.msgs[-1].get("role") != "user":
                    S.msgs.pop()
                last = S.msgs.pop() if S.msgs and S.msgs[-1].get("role") == "user" else None
            if not last: return self._send(200, jdump({"ok": False}))
            c = last.get("content")
            text = c if isinstance(c, str) else " ".join(
                x.get("text","") for x in c if isinstance(x, dict))
            return self._send(200, jdump({"ok": True, "content": text}))
        if p == "/api/regenerate":
            with LOCK:
                while S.msgs and S.msgs[-1]["role"] != "user":
                    S.msgs.pop()
                last = S.msgs.pop() if S.msgs and S.msgs[-1]["role"] == "user" else None
            return self._send(200, jdump({"ok": bool(last),
                "content": last.get("content") if last else None}))
        if p == "/api/server/start":
            try:
                q.reload_settings()
                m = q.ensure_model()
                return self._send(200, jdump({"msg": f"running · {m}", "status": q.server_status()}))
            except Exception as e:
                return self._send(200, jdump({"msg": f"start failed: {e}"}))
        if p == "/api/restart_ui":
            # launchd has KeepAlive, so exiting brings us straight back on new code.
            # Never mid-answer: a restart used to cut a running answer off, so it
            # now waits for every running chat to finish (force=true to override)
            busy = running_sids()
            if busy and not d.get("force"):
                _restart_when_idle()
                return self._send(200, jdump({"ok": True, "deferred": True, "running": len(busy),
                    "msg": f"will restart as soon as {len(busy)} running answer(s) finish"}))
            threading.Timer(0.4, lambda: (q.CE.close_live(), q.CX.shutdown(), time.sleep(1), os._exit(0))).start()
            return self._send(200, jdump({"ok": True, "msg": "restarting the interface…"}))
        if p == "/api/server/stop":
            return self._send(200, jdump({"msg": q.stop_server()}))
        if p == "/api/server/restart":
            try:
                q.reload_settings()
                m = q.restart_server()
                return self._send(200, jdump({"msg": f"restarted · {m}", "status": q.server_status()}))
            except Exception as e:
                return self._send(200, jdump({"msg": f"restart failed: {e}"}))
        if p == "/api/system_preview":
            return self._send(200, jdump({"text": q.system_prompt()}))
        self._send(404, "{}")

    def _upload(self, to_knowledge=False):
        ctype = self.headers.get("Content-Type", "")
        if "multipart/form-data" not in ctype:
            return self._send(400, jdump({"error": "expected multipart"}))
        fname, raw = parse_multipart(self.rfile, ctype, self.headers.get("Content-Length"))
        if not fname or raw is None:
            return self._send(400, jdump({"error": "no file"}))
        safe = os.path.basename(fname).replace(" ", "_")
        if to_knowledge:
            path = os.path.join(q.KNOW, safe)
            open(path, "wb").write(raw)
            stats = q.know_reindex()
            return self._send(200, jdump({"kind": "knowledge", "name": safe, **stats}))
        name = f"{int(time.time())}-{safe}"
        path = os.path.join(q.UPLOADS, name)
        q.CURRENT_SID.update(sid=S.sid, title=S.title)
        open(path, "wb").write(raw)
        ext = safe.rsplit(".", 1)[-1].lower() if "." in safe else ""
        try: q.record_file(os.path.relpath(path, q.WORKSPACE), "upload")
        except Exception: pass
        if ext in ("png","jpg","jpeg","gif","webp"):
            mime = "image/jpeg" if ext in ("jpg","jpeg") else f"image/{ext}"
            return self._send(200, jdump({"kind":"image","name":safe,"path":path,
                "url": f"/api/file/{name}",
                "data_url": f"data:{mime};base64," + base64.b64encode(raw).decode()}))
        try: text = q._md(path)
        except Exception as e: text = f"(could not extract text: {e})"
        return self._send(200, jdump({"kind":"file","name":safe,"path":path,
                                      "chars":len(text),"preview":text[:400]}))

    def _chat(self):
        d = self._body()
        st = get_state(d.get("sid"))
        def _stream_once(events):
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Connection", "close"); self.end_headers()
            self.close_connection = True
            try:
                for k, pl in events:
                    self.wfile.write(f"data: {jdump({'k': k, 'p': pl})}\n\n".encode())
            except Exception: pass
        text, atts, effort = d.get("message", ""), d.get("attachments") or [], d.get("effort")
        if d.get("at"):
            # sent later: it waits in the chat's queue until its time
            try: item = _queue_add(st, text, atts, effort, at=float(d["at"]), repeat=d.get("repeat"))
            except ValueError as e: return self._send(400, jdump({"error": str(e)}))
            return _stream_once([("queued_message", {"item": item, "why": "scheduled", "queue": _queue_view(st)}),
                                 ("end", {"sid": st.sid, "queued": True, "scheduled": True})])
        busy = st.lock.locked()
        full = len(running_sids()) >= _max_parallel()
        if busy or full or _due_items(st):
            # it waits its turn: after the answer running now (and anything queued
            # before it), or for a free slot when many chats are answering
            if d.get("now") and busy and not atts:
                st.inbox.append({"text": text, "t": time.time()}); st.interrupt.set()
                return _stream_once([("interjected", {"text": text}), ("end", {"sid": st.sid, "interjected": True})])
            item = _queue_add(st, text, atts, effort)
            _drain()
            why = ("this chat is answering" if busy else
                   f"{_max_parallel()} chats are answering (your max_parallel setting)" if full
                   else "earlier messages are queued")
            return _stream_once([("queued_message", {"item": item, "why": why, "queue": _queue_view(st)}),
                                 ("end", {"sid": st.sid, "queued": True})])
        if not st.lock.acquire(blocking=False):
            item = _queue_add(st, text, atts, effort)
            return _stream_once([("queued_message", {"item": item, "why": "this chat is answering",
                                                     "queue": _queue_view(st)}), ("end", {"sid": st.sid, "queued": True})])
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "close")
        self.end_headers()
        Q = start_turn(st, text, atts, effort, queue.Queue())
        while True:
            kind, payload = Q.get()
            try:
                self.wfile.write(f"data: {jdump({'k':kind,'p':payload})}\n\n".encode())
                self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                return
            if kind == "end": return

def start_turn(st, text, atts=None, effort=None, Q=None):
    """Run one message in a chat on its own thread. The chat's lock must already be
    held (it is released when the answer ends). Events go to Q (a browser's stream)
    and always to the chat's live buffer, so any window can follow it; a message the
    queue starts has no stream, and its events go only to the live buffer."""
    Q = Q if Q is not None else _Sink()
    st.busy_since = time.time()
    st.cancel.clear()
    st.live = {"thinking": "", "content": "", "tools": [],
               "status": "", "done": False, "seq": 0, "user": str(text or "")[:4000]}
    try: text = q.expand_prompt(text)       # '/name words' runs a saved prompt
    except Exception: pass
    atts = atts or []

    def work():
        slotted = [False]
        try:
            parts, notes = [], []
            for a in atts:
                if a.get("kind") == "image":
                    parts.append({"type":"image_url","image_url":{"url":a["data_url"]}})
                else:
                    # a file already in the workspace can be named by its relative
                    # path; anything that escapes the workspace is ignored
                    path = a.get("path")
                    if not path and a.get("rel"):
                        cand = os.path.abspath(os.path.join(q.WORKSPACE, str(a["rel"])))
                        if cand.startswith(os.path.abspath(q.WORKSPACE) + os.sep): path = cand
                    if not path: continue
                    notes.append(f"[attached file: {a['name']} — read it with read_file at {path}]")
            body = text + (("\n" + "\n".join(notes)) if notes else "")
            content = ([{"type":"text","text":body}] + parts) if parts else body
            first = st.title is None
            if True:
                if first:
                    st.title = " ".join(str(text).split())[:60] or "(untitled)"
                # write immediately: a running chat must be visible in the sidebar
                st.msgs.append({"role": "user", "content": content})
                st.running = True
                save_session(st)
                st.msgs.pop()
                def _approve(fn, a, reason, info=None):
                    # info: a prompt raised by Claude Code (claude_engine) -- its
                    # "always allow" becomes a Claude permission rule, not Orbit's
                    _APPROVE_SEQ[0] += 1
                    rid = f"ap{_APPROVE_SEQ[0]}"
                    ev = threading.Event()
                    PENDING[rid] = {"event": ev, "allow": False, "fn": fn, "args": a}
                    req = {"id": rid, "name": (info or {}).get("tool") or fn, "args": a, "reason": reason,
                           "suggested_pattern": q._rule_pattern_suggestion(fn, a)}
                    if info:
                        req.update(claude=True, suggested_pattern=info.get("suggested_pattern") or req["name"],
                                   suggestions=info.get("suggestions") or [])
                    if fn in ("write_file", "edit_file"):
                        # what the change will be, so it can be judged before it's made
                        dv = q.preview_edit(fn, a)
                        if dv: req["diff"] = dv
                    Q.put(("approval_request", req))
                    # also in the live buffer, so any window that opens this chat
                    # can see the prompt and answer it — it used to exist only in
                    # the tab that sent the message, and time out unseen
                    st.live["approval"] = req
                    q.notify("Orbit needs your approval", f"{fn}: {reason}")
                    ok = ev.wait(timeout=900)
                    st.live.pop("approval", None)
                    rec = PENDING.pop(rid, {})
                    if info:
                        return {"allow": bool(rec.get("allow")) if ok else False,
                                "always": bool(ok and rec.get("always")),
                                "pattern": rec.get("pattern") or "",
                                "note": (rec.get("message") or rec.get("note") or "").strip() if ok else ""}
                    if ok and rec.get("allow") and rec.get("always"):
                        q.add_permission_rule("allow", fn,
                            rec.get("pattern") or q._rule_pattern_suggestion(fn, a),
                            rec.get("note") or "")
                    allow = bool(rec.get("allow")) if ok else False
                    # a reason typed with Deny (or a note with Allow) goes back to
                    # the model, so it can change course rather than just stop
                    note = (rec.get("message") or "").strip() if ok else ""
                    return (allow, note) if note else allow

                def _ask(question, options, multiple):
                    _APPROVE_SEQ[0] += 1
                    rid = f"qa{_APPROVE_SEQ[0]}"
                    ev = threading.Event()
                    PENDING[rid] = {"event": ev, "answer": None}
                    req = {"id": rid, "question": question, "options": options, "multiple": multiple}
                    Q.put(("question", req))
                    st.live["question"] = req          # any window can answer it
                    q.notify("Orbit has a question", question)
                    ok = ev.wait(timeout=1800)
                    st.live.pop("question", None)
                    rec = PENDING.pop(rid, {})
                    return rec.get("answer") if ok else None

                def _emit(k, p):
                    _live_record(st, k, p)            # keep a copy so you can rejoin later
                    if k == "tool_result" and q.LAST_IMAGES:
                        p = dict(p or {})
                        p["images"] = [os.path.relpath(i, q.WORKSPACE) for i in q.LAST_IMAGES]
                        q.LAST_IMAGES = []
                    if k == "tool_result" and (p or {}).get("name") in ("write_file", "edit_file") and q.LAST_DIFF:
                        p = dict(p or {}); p["diff"] = dict(q.LAST_DIFF); q.LAST_DIFF.clear()
                    Q.put((k, p))
                q.CURRENT_SID.update(sid=st.sid, title=st.title)
                q.ACTIVE_PROJECT["id"] = st.project
                if not st.model:
                    # a chat keeps the model it started on: changing the default later
                    # (or picking a model in another chat) must not move it, and its
                    # context window with it
                    try:
                        first = q.current_model(q.MODELS.load(q.ROOT).get("default") or None)
                        if first and first.get("id") and not str(first["id"]).startswith("local-dir:"):
                            st.model = first["id"]
                    except Exception:
                        pass
                q.ACTIVE_MODEL["id"] = st.model
                # this thread's own model and effort: other chats answering at the same
                # time change the shared ACTIVE_MODEL (and "retry with more effort" used
                # to change the effort setting for every chat, for good)
                q.TURN_CTX.pin_model = st.model
                q.TURN_CTX.model = st.model
                q.TURN_CTX.pin_effort = effort or None
                # one answer at a time on the local model: if another chat has
                # it, this one waits in line (and says so) rather than running
                # alongside -- two at once made both crawl
                if not q.slot_enter(_emit, st.cancel, st.sid, st.model):
                    st.msgs.append({"role": "user", "content": content, "t": time.time()})
                    st.running = False; save_session(st)
                    Q.put(("end", {"sid": st.sid, "title": st.title})); return
                slotted[0] = True
                _refresh_system(st)
                st.refresh_tools()     # a project's own tools, and any added since
                # a Claude Code chat is compacted by Claude Code itself (Orbit's copy of it
                # is only what you see); Orbit's compaction is for its own chats
                engine_chat = _is_engine_chat(st)
                st.msgs, did, pct = (st.msgs, False, 0) if engine_chat else q.maybe_autocompact(st.msgs, emit=lambda k, p: Q.put((k, p)),
                                                        sid=st.sid)
                if did: save_session(st)
                _t0 = time.time()
                n0 = len(st.msgs)
                st.interrupt.clear()
                q.TURN_CTX.ask = _ask
                q.turn(st.msgs, content, st.tools, emit=_emit, approve=_approve,
                       cancel=st.cancel, inbox=st.inbox, interrupt=st.interrupt, sid=st.sid,
                       checkpoint=lambda: save_session(st), project=st.project,
                       read_only=st.plan_mode)
                spent = dict(q.LAST_TURN.get(st.sid) or {})
                # a note that landed in the instant between the answer ending
                # and this chat being released: answer it now, in this same
                # stream, rather than leave it sitting unread
                while st.inbox and not st.cancel.is_set():
                    note = st.inbox.popleft()
                    _emit("interjection", {"text": note.get("text", "")})
                    save_session(st)
                    st.interrupt.clear()
                    q.turn(st.msgs, note.get("text", ""), st.tools, emit=_emit,
                           approve=_approve, cancel=st.cancel, inbox=st.inbox,
                           interrupt=st.interrupt, sid=st.sid,
                           checkpoint=lambda: save_session(st), project=st.project,
                           read_only=st.plan_mode)
                    # one stream, one bill: add the follow-up's time and tokens
                    more = q.LAST_TURN.get(st.sid) or {}
                    spent["secs"] = round((spent.get("secs") or 0) + (more.get("secs") or 0), 1)
                    spent["tool_runs"] = (spent.get("tool_runs") or 0) + (more.get("tool_runs") or 0)
                    spent["usage"] = {k: (spent.get("usage") or {}).get(k, 0) + (more.get("usage") or {}).get(k, 0)
                                      for k in ("prompt_tokens", "completion_tokens")}
                q.LAST_TURN[st.sid] = spent
                try:
                    u = (q.LAST_TURN.get(st.sid) or {}).get("usage") or {}
                    stats = u if any(u.values()) else (q.server_status().get("last") or {})
                    spec = q.current_model(st.model) or {}
                    q.ledger_add(st.sid, seconds=round(time.time() - _t0, 1),
                                 prompt_tokens=stats.get("prompt_tokens"),
                                 completion_tokens=stats.get("completion_tokens"),
                                 model=spec.get("label") or spec.get("model"))
                    tot = (stats.get("prompt_tokens") or 0) + (stats.get("completion_tokens") or 0)
                    if tot: q.SESSION_TOKENS[st.sid] = tot
                except Exception: pass
                st.running = False
                save_session(st)
                if not _is_engine_chat(st): _learn_later(st, n0)     # Claude keeps its own memory
            if first and not st.cancel.is_set():
                # the title is written alongside, not before the chat is free: a queued
                # message used to wait for it (16 s on a reasoning model)
                def _title(msgs=list(st.msgs), model=st.model):
                    q.TURN_CTX.pin_model = model        # this chat's model, on this thread too
                    try:
                        auto = autotitle(msgs)
                        if auto:
                            st.title = auto
                            save_session(st)
                    except Exception:
                        pass
                threading.Thread(target=_title, daemon=True).start()
            Q.put(("end", {"sid": st.sid, "title": st.title,
                           **{k: v for k, v in (q.LAST_TURN.get(st.sid) or {}).items()
                              if k in ("secs", "usage", "tool_runs", "rounds", "changes", "t")}}))
        except Exception as e:
            Q.put(("error", f"{type(e).__name__}: {e}")); Q.put(("end", {}))
        finally:
            if slotted[0]: q.slot_exit()
            st.live["done"] = True
            if st.running:
                # an answer that failed, not one Orbit was stopped during —
                # the next start must not treat it as cut off and resume it
                st.running = False
                try: save_session(st)
                except Exception: pass
            if st.temp:
                try: q.redact_server_log()
                except Exception: pass
            try: st.lock.release()
            except RuntimeError: pass
            # Stop pauses the chat's queue (the rest waits for you); otherwise the next
            # queued message starts, and chats waiting for a free slot get one
            if st.cancel.is_set() and _due_items(st): st.queue_paused = True; _queue_saved(st)
            threading.Thread(target=_drain, daemon=True).start()
    threading.Thread(target=work, daemon=True).start()
    return Q


class _Sink:
    """A stream nobody reads: a message started by the queue."""
    def put(self, item): pass


DRAIN_LOCK = threading.Lock()
INDEX_LOCK = threading.Lock()
QUEUE_INDEX = os.path.join(q.ROOT, "config", "queues.json")

REPEATS = ("daily", "weekdays", "weekly")

def _next_time(at, repeat, now=None):
    """The next time a repeating scheduled message is due after `now`, at the same
    time of day (local time, so it stays at 9:00 across daylight-saving changes)."""
    now = time.time() if now is None else now
    t = time.localtime(at)
    day = 0
    while True:
        day += 1
        cand = time.mktime((t.tm_year, t.tm_mon, t.tm_mday + day, t.tm_hour, t.tm_min, 0, 0, 0, -1))
        wd = time.localtime(cand).tm_wday
        if repeat == "weekdays" and wd >= 5: continue
        if repeat == "weekly" and wd != t.tm_wday: continue
        if cand > now: return cand
        if day > 3660: return now + 86400

def _is_due(it, now=None):
    return not it.get("at") or (float(it["at"]) <= (time.time() if now is None else now) and not it.get("missed"))

def _due_items(st, now=None):
    return [it for it in st.queue if _is_due(it, now)]

def _schedule_grace():
    """How late a scheduled message may still go out (Orbit was closed, the Mac slept)."""
    try: return float(q.S.get("schedule_send_grace_h", 6)) * 3600
    except (TypeError, ValueError): return 6 * 3600

def _catch_up_schedules(st, now=None):
    """Messages whose time passed long ago: a repeating one moves to its next time, a
    one-off is kept, marked missed, for you to send or drop. Returns True if changed."""
    now = time.time() if now is None else now
    changed = False
    for it in st.queue:
        at = it.get("at")
        if not at or it.get("missed") or now - float(at) <= _schedule_grace(): continue
        if it.get("repeat") in REPEATS:
            it["skipped"] = int(it.get("skipped") or 0) + 1
            it["at"] = _next_time(float(at), it["repeat"], now)
        else:
            it["missed"] = True
        changed = True
    return changed

def _queue_view(st):
    return {"items": [{k: v for k, v in it.items() if k != "attachments"} |
                      {"attachments": [{"name": a.get("name"), "kind": a.get("kind")} for a in it.get("attachments") or []]}
                      for it in st.queue],
            "paused": bool(st.queue_paused), "running": st.lock.locked()}

def _queue_saved(st):
    """The queue lives in the chat's file (so it survives a restart), and chats
    with one are listed in config/queues.json so a restart can find them."""
    if st.temp: return
    try: save_session(st)
    except Exception: pass
    try:
        with INDEX_LOCK:
            idx = {}
            try: idx = json.load(open(QUEUE_INDEX))
            except Exception: pass
            if st.queue: idx[st.sid] = len(st.queue)
            else: idx.pop(st.sid, None)
            tmp = QUEUE_INDEX + ".tmp"
            json.dump(idx, open(tmp, "w")); os.replace(tmp, QUEUE_INDEX)
    except Exception: pass

def scheduled_messages():
    out = []
    try: idx = json.load(open(QUEUE_INDEX))
    except Exception: idx = {}
    for qsid in set(idx) | {k for k, v in list(STATES.items()) if v.queue}:
        if qsid not in STATES and not os.path.exists(q.session_path(qsid)): continue
        stt = get_state(qsid)
        for it in list(stt.queue):
            if not it.get("at"): continue
            out.append({"sid": qsid, "title": stt.title, "id": it["id"], "text": it.get("text", ""),
                        "at": it["at"], "repeat": it.get("repeat"), "missed": bool(it.get("missed")),
                        "model": it.get("model"), "chat_model": stt.model,
                        "attachments": len(it.get("attachments") or []), "project": stt.project})
    out.sort(key=lambda x: x["at"])
    return out

def queue_update(st, iid, fields):
    """Change a waiting message: text, when (at None = back to the plain queue),
    repeat, model ("" = the chat's own). Returns (item, error)."""
    it = next((x for x in st.queue if x.get("id") == iid), None)
    if it is None: return None, "that message has already started"
    if "text" in fields:
        t = str(fields.get("text") or "").strip()
        if not t and not it.get("attachments"): return None, "the message is empty"
        it["text"] = t
    rp = fields.get("repeat", it.get("repeat")) or None
    if rp and rp not in REPEATS: return None, "repeat must be daily, weekdays or weekly"
    if "at" in fields:
        if fields["at"]:
            try: at = float(fields["at"])
            except (TypeError, ValueError): return None, "when? (a time)"
            if not rp and at < time.time() - 5: return None, "that time has passed"
            it["at"] = _next_time(at, rp) if rp and at <= time.time() else at
            it.pop("missed", None); it.pop("skipped", None)
        else:
            for k in ("at", "repeat", "missed", "skipped"): it.pop(k, None)
            rp = None
    if it.get("at"):
        if rp: it["repeat"] = rp
        else: it.pop("repeat", None)
    if "model" in fields:
        if fields["model"]: it["model"] = str(fields["model"])
        else: it.pop("model", None)
    _queue_saved(st)
    return it, None

def _queue_add(st, text, atts=None, effort=None, at=None, repeat=None, model=None):
    item = {"id": uuid.uuid4().hex[:10], "text": str(text or ""), "attachments": list(atts or []),
            "effort": effort, "t": time.time()}
    if at:
        if repeat and repeat not in REPEATS: raise ValueError(f"repeat must be one of {', '.join(REPEATS)}")
        at = float(at)
        if repeat and at <= time.time(): at = _next_time(at, repeat)
        item["at"] = at
        if repeat: item["repeat"] = repeat
    if model: item["model"] = str(model)
    st.queue.append(item)
    _queue_saved(st)
    return {k: v for k, v in item.items() if k != "attachments"}

def _drain():
    """Start the next queued message in every chat that is free, while there are
    free slots. Called when an answer ends and when something is queued."""
    started = []
    with DRAIN_LOCK:
        now = time.time()
        for st in list(STATES.values()):
            if not st.queue: continue
            if _catch_up_schedules(st, now): _queue_saved(st)
            # Stop pauses the waiting messages; one you scheduled still goes at its time
            due = [it for it in _due_items(st, now) if it.get("at") or not st.queue_paused]
            if not due: continue
            if len(running_sids()) >= _max_parallel(): break
            if not st.lock.acquire(blocking=False): continue
            due = [it for it in _due_items(st, now) if it.get("at") or not st.queue_paused]
            if not due:
                st.lock.release(); continue
            item = due[0]
            st.queue.remove(item)
            if item.get("repeat") in REPEATS:
                # the next one waits for its own time, in the same place
                nxt = dict(item, id=uuid.uuid4().hex[:10], at=_next_time(float(item["at"]), item["repeat"], now))
                nxt.pop("skipped", None)
                st.queue.append(nxt)
            if item.get("model"):
                # a message scheduled for a model: the chat moves to it, as if you had
                # picked it in the model menu and then sent the message
                st.model = item["model"]
            started.append((st, item))
    for st, item in started:
        _queue_saved(st)
        try:
            start_turn(st, item["text"], item.get("attachments") or [], item.get("effort"))
        except Exception as e:
            print(f"  ! queued message in {st.sid}: {type(e).__name__}: {e}")
            try: st.lock.release()
            except RuntimeError: pass

# stream events worth showing to a tab that rejoins an answer mid-way
_STATUS_KINDS = ("server_starting", "stagnation", "autocompact", "squeezed", "notice", "status",
                 "long_running", "interjection", "retry", "subtask", "queued", "dequeued",
                 "plan_nudge", "fail_streak", "ultrathink", "fallback")

def _status_text(k, p):
    p = p or {}
    if k == "long_running": return f"still working — {p.get('minutes')} min, {p.get('rounds')} steps"
    if k == "interjection": return "reading your note"
    if k == "squeezed":     return "trimming old tool output to make room"
    if k == "queued":       return "waiting for another chat to finish"
    if k == "dequeued":     return "its turn — starting"
    if k == "retry":        return (f"model request failed ({p.get('kind')}) — retrying"
                                    + (f" in {p.get('wait')}s" if p.get("wait") else ""))
    if k == "subtask":      return f"helper: {p.get('description')} — {p.get('tool')}"
    if k == "fallback":     return f"{p.get('from')} kept failing — continuing on {p.get('to')}"
    return p.get("msg") or k.replace("_", " ")

def _live_record(st, k, p):
    """Keep what a running answer is doing in st.live, so a window that opens
    the chat mid-answer can show it.

    Only the step in progress is kept. When the model starts writing again
    after running tools (or after reading a note), the step before is already
    in st.msgs, so the buffer starts over; "from" says where the saved part
    ends and "step" counts the restarts. The buffer used to hold every step of
    the answer, so a rejoining window showed the finished steps twice: once
    from the saved chat and again as one block of live text."""
    lv = st.live
    p = p if p is not None else {}
    if k in ("thinking_delta", "content_delta"):
        if lv.get("from") is None or lv["tools"] or lv.get("_newstep"):
            if lv.get("from") is not None:
                lv["step"] = lv.get("step", 0) + 1
            lv.update(thinking="", content="", tools=[], thinking_marks=[], _newstep=False,
                      **{"from": len(st.msgs)})
            lv.pop("_mstate", None)
        if k == "thinking_delta":
            q.para_marks(lv.setdefault("thinking_marks", []),
                         lv.setdefault("_mstate", [len(lv["thinking"]), lv["thinking"][-2:]]), p)
            lv["thinking"] += p
        else:
            lv["content"] += p
    elif k == "tool":
        lv["tools"].append({"name": p.get("name"), "args": p.get("args"),
                            "id": p.get("id"), "t": p.get("t")})
    elif k == "tool_result":
        for x in reversed(lv["tools"]):
            if x.get("id") and x.get("id") == p.get("id"):
                x.update(ok=p.get("ok"), secs=p.get("secs")); break
    elif k == "auto_approved":
        # so a tab that rejoins mid-answer still sees what ran
        # unattended, not just what is still waiting on it
        lv["tools"].append({"name": "✓ auto-approved: " + p.get("name", ""),
                            "args": p.get("args")})
    if k == "interjection" and not p.get("late"):
        lv["_newstep"] = True               # what it says after the note is a new block
    if k in _STATUS_KINDS:
        # a tab that rejoins mid-answer needs to see this too,
        # otherwise a cold start looks like a hung chat
        lv["status"] = _status_text(k, p)
    lv["seq"] = lv.get("seq", 0) + 1

GATEWAY = {"srv": None, "error": None}

def _gateway_route(provider, model):
    """The gateway's lookup: where a harness model's request goes, with its key."""
    import harness_gateway  # noqa: F401
    spec = q.HARN.resolve(q.ROOT, f"harness:{provider}/{model}", q.secrets_load(), q.local_model_name())
    if spec is None:
        # a model the registry does not list (say, a provider's small model): same
        # provider, format guessed from the name
        provs = q.HARN.providers(q.ROOT, q.local_model_name())
        p = provs.get(provider)
        if not p: return None
        low = model.lower()
        fmt = ("messages" if low.startswith(("claude", "qwen3.", "minimax")) else
               "responses" if low.startswith(("gpt", "grok", "o3", "o4")) else "chat")
        if p.get("auth") == "api_key": fmt = "messages"
        keys = q.HARN.account_keys(p, q.secrets_load(), q.ROOT, provider)
        return {"base": p.get("base") or "", "format": fmt, "api_key": keys[0]["api_key"] if keys else "",
                "accounts": [{"id": a["id"], "api_key": a["api_key"]} for a in keys],
                "proxy": q.HARN.load(q.ROOT).get("proxy") or ""}
    pc = spec["provider_cfg"]
    base = pc["base"]
    if pc.get("local"):
        base = q.CE.model_endpoint()[0] + "/v1"
    return {"base": base, "format": pc["format"], "api_key": pc["api_key"], "proxy": pc.get("proxy"),
            "accounts": pc.get("accounts") or [],
            "key_required": not pc.get("local"), "max_output": pc.get("max_output"),
            # Anthropic itself takes every field Claude Code sends; other vendors may not
            "strict": provider not in ("anthropic",) and not str(model).startswith("claude")}

_ACTIVE_ACCT = {}

def _chat_host(mk, prefs):
    """Where a chat runs: the host its session started on, the one chosen for it, or,
    for a chat that has not started, the default ("" / None = this Mac)."""
    if mk.get("session"): return mk.get("host") or None
    if "host" in prefs: return prefs.get("host") or None
    return q.CE.cfg().get("default_host") or None

def _loopback_ok(handler):
    """Acting on the Mac (opening apps, the clipboard, Terminal) is for you at the Mac,
    not for a paired phone."""
    return handler._from_loopback()

def _chat_files_ctx(sid):
    """Where a chat's file names point: (SSH host or None, folders most likely first,
    files its answers changed)."""
    st = STATES.get(sid) if sid else None
    msgs, project = [], None
    if st is not None:
        msgs, project = list(st.msgs), st.project
    elif sid and os.path.exists(q.session_path(sid)):
        try:
            d = json.load(open(q.session_path(sid)))
            msgs, project = d.get("messages") or [], d.get("project")
        except Exception: pass
    mk = q.CE.marker_of(msgs) or {} if msgs else {}
    prefs = q.CE.chat_prefs(sid) if sid else {}
    host = (mk.get("host") if mk.get("session") else prefs.get("host")) or None
    cwd = mk.get("cwd") or prefs.get("cwd")
    if host:
        return host, [cwd or q.CE.default_remote_dir(host) or "~"], []
    changed = []
    for m in msgs[-200:]:
        for c in m.get("changes") or []:
            if c.get("path"): changed.append(c["path"])
    try: pdir = q.project_folder(project) if project else None
    except Exception: pdir = None
    # a chat that works in a folder means that folder; other chats their project's, or Orbit's workspace
    roots = FL.roots_for(cwd, prefs.get("add_dirs") or ()) if cwd else FL.roots_for(None, (), pdir, q.WORKSPACE)
    return None, roots, changed[::-1]

def _usage_brief(pid, model):
    """What a model has used through Orbit, and what is left where the provider publishes an allowance."""
    try:
        hit = _ACTIVE_ACCT.get(pid)
        if not hit or time.time() - hit[0] > 3:
            pr = q.HARN.providers(q.ROOT).get(pid) or {}
            _ACTIVE_ACCT[pid] = hit = (time.time(), q.HARN.account_keys(pr, q.secrets_load()))
        keys = hit[1]
        # an allowance belongs to an account: the one in use now
        u = q.USAGE.summary(q.ROOT, pid, keys[0]["id"] if keys else None, model)
        if keys: u["account"] = keys[0]["label"]
        if not u["requests"] and not u.get("monthly"): return None
        return u
    except Exception:
        return None

def _start_gateway():
    """Orbit's translating gateway for harness models (loopback only)."""
    import harness_gateway
    port = int(q.HARN.load(q.ROOT).get("gateway_port") or 8897)
    try:
        GATEWAY["srv"] = harness_gateway.serve(port, _gateway_route,
                                               log=lambda m: print("  gateway: " + m),
                                               token=q.CE.gateway_token(),
                                               hooks={"usage": lambda pr, ac, mo, u: q.USAGE.record(q.ROOT, pr, ac, mo, u),
                                                      "exhausted": lambda pr, ac, msg, secs=None: q.USAGE.mark_exhausted(q.ROOT, pr, ac, msg, seconds=secs)})
        q.HARNESS_PORT = GATEWAY["srv"].server_address[1]
        print(f"  harness gateway on 127.0.0.1:{q.HARNESS_PORT}")
    except OSError as e:
        GATEWAY["error"] = str(e)
        print(f"  ! harness gateway could not start on {port}: {e}")

def _claude_sync(sid):
    """Opening a chat: a Claude-Qwen session from a terminal is brought in (or,
    if it was continued there since, its new part is), unless it is running."""
    st = STATES.get(sid)
    if st is not None and st.lock.locked(): return
    try:
        if q.CE.sync_session(sid) and st is not None:
            msgs, title = q.session_load(sid)
            st.msgs, st.title = msgs, title
            try: st.model = (json.load(open(q.session_path(sid))) or {}).get("model") or st.model
            except Exception: pass
    except Exception as e:
        print(f"  ! claude sync {sid}: {type(e).__name__}: {e}")

def _live_view(st):
    """st.live as sent to a browser: without the private bookkeeping."""
    return {k: v for k, v in st.live.items() if not k.startswith("_")}

def _live_emitter(st):
    """What a chat's own stream would record, for a run nobody is streaming —
    so opening that chat mid-run shows it working, like any other answer."""
    return lambda k, p: _live_record(st, k, p)

def _is_engine_chat(st, model=None):
    """Whether a chat runs through Claude Code (which has its own memory, compaction
    and instructions)."""
    try:
        spec = q.current_model(model or st.model)
        return q.CE.is_engine(spec) or q.CX.is_engine(spec)       # Codex keeps its own context too
    except Exception: return False

def _learn_later(st, n0, min_steps=3):
    """After a substantial answer (min_steps tool calls or more), pull out
    durable facts and save them as memory — in the background, after the
    chat is free, so it never holds up your next message. Never for a
    temporary chat, which must leave no trace, nor for one you stopped."""
    if st.temp or st.cancel.is_set(): return
    steps = sum(1 for m in st.msgs[n0:] if m.get("role") == "tool")
    if steps < min_steps: return
    msgs, title = list(st.msgs), st.title
    threading.Thread(target=lambda: q.auto_memory(msgs, title), daemon=True).start()

def _refresh_system(st):
    """Rebuild a chat's system prompt before each answer. It used to be fixed
    when the chat was opened, so memory written since — by you, or by the
    model itself mid-task — never reached a chat that was already open. A
    per-chat prompt added with /sysprompt is kept."""
    if not st.msgs or st.msgs[0].get("role") != "system": return
    cur = st.msgs[0].get("content") or ""
    mark = "\n\n## This chat\n"
    st.msgs[0]["content"] = (q.system_prompt_for(st.agent, st.project)
                             + ("\n\n" + q.PLAN_MODE_NOTE if getattr(st, "plan_mode", False) else "")
                             + (cur[cur.index(mark):] if mark in cur else ""))

def autotitle(msgs):
    """Ask the model for a short title once the first exchange exists."""
    convo = []
    for m in msgs[1:5]:
        c = m.get("content")
        if isinstance(c, list):
            c = " ".join(x.get("text","") for x in c if x.get("type") == "text")
        if c and m.get("role") in ("user","assistant"):
            convo.append(f"{m['role']}: {str(c)[:600]}")
    if not convo: return None
    ask = ("Give a short title for this conversation: 3-6 words, no quotes, no punctuation "
           "at the end, plain nouns. Reply with the title only.\n\n" + "\n".join(convo))
    out = q.stream_call([{"role":"system","content":"You write short, specific titles."},
                         {"role":"user","content":ask}], None, think=False)
    t = (out.get("content") or "").strip().strip('"').splitlines()[0][:60]
    return t or None

import re as _re
def _msg_text(m):
    """The text of a stored message, whether plain or a text+image list."""
    c = m.get("content")
    if isinstance(c, list):
        return " ".join(x.get("text", "") for x in c if x.get("type") == "text")
    return str(c or "")

def render(msgs):
    """Chat messages as the page draws them. Each model step is its own entry --
    what it said, then the tools that step called, with their results -- the
    same order the live stream shows. Tool rows used to be attached to the next
    message with text, so a reopened chat paired text with the wrong tools."""
    out = []
    owner = {}                         # tool call id -> the entry of the step that made it
    call_args = {}                     # tool call id -> its arguments, for the tool rows
    for m in msgs:
        if m.get("role") == "tool":
            body = str(m.get("content") or "")
            e = owner.get(m.get("tool_call_id"))
            if e is None: continue     # its step was never drawn (e.g. compacted away)
            mm = _re.search(r"\[created images: ([^\]]+)\]", body)
            if mm: e["plots"] += [f"/api/ws/{x.strip()}" for x in mm.group(1).split(",") if x.strip()]
            if m.get("name"):
                e["tools"].append(m["name"])
                e["tool_runs"].append({"name": m["name"], "id": m.get("tool_call_id"),
                                       "args": call_args.get(m.get("tool_call_id")),
                                       # a chat saved before "ok" was kept: judge it by what came back
                                       "ok": m["ok"] if "ok" in m else q._tool_ok(body),
                                       "secs": m.get("secs"),
                                       "output": body[:1500]})
            continue
        calls = m.get("tool_calls") or []
        for tc in calls:
            try: call_args[tc.get("id")] = json.loads(tc["function"].get("arguments") or "{}")
            except (ValueError, KeyError, TypeError): pass
        if m.get("role") not in ("user", "assistant"): continue
        if m.get("nudge"): continue        # Orbit's own "carry on" notes, not the user's words
        c = m.get("content")
        if isinstance(c, list):
            out.append({"role": m["role"],
                        "text": " ".join(x.get("text","") for x in c if x.get("type")=="text"),
                        "images": [x["image_url"]["url"] for x in c if x.get("type")=="image_url"],
                        "plots": [], "tools": [], "t": m.get("t")})
        # a stopped turn can have thinking with no answer text yet -- still show
        # it, and a step that only called tools gets an entry for its tool rows
        elif c or (m.get("role") == "assistant" and (m.get("reasoning_content") or calls)):
            out.append({"role": m["role"], "text": c or "", "images": [],
                        "plots": [], "tools": [],
                        # which model wrote this, so a reopened chat is honest about it
                        "model": m.get("model") if m["role"] == "assistant" else None,
                        # the thinking trace, kept from a normal answer or a stop mid-stream
                        "thinking": m.get("reasoning_content") if m["role"] == "assistant" else None,
                        # when each paragraph of the thinking began: [[offset, time], ...]
                        "thinking_marks": m.get("reasoning_marks") if m["role"] == "assistant" else None,
                        # a note sent while it was working, so a reopened chat can say so
                        "note": bool(m.get("interjection")),
                        # when it was written; None for messages from before this was kept
                        "t": m.get("t"),
                        # how long the answer took, what it cost, and each tool it ran
                        "secs": m.get("secs"), "usage": m.get("usage"),
                        # files this answer changed, so the page can offer to undo them
                        "changes": [c.get("path") for c in m.get("changes") or []],
                        "changes_undone": bool(m.get("changes_undone")),
                        "tool_runs": []})
            for tc in calls: owner[tc.get("id")] = out[-1]
    return out

JOBS_INFLIGHT = set()

def _stamp_started(job_id):
    """Claim the job before running it. last_run was only written on completion,
    so a job that was still running when the UI restarted fired all over again."""
    def stamp(cfg):
        for j in cfg.get("jobs", []):
            if j.get("id") == job_id:
                j["last_run"] = time.time()
    q.sched_update(stamp)

def schedule_save(fields):
    """Create a task, or change some of an existing one's fields (pausing sends only
    {id, enabled}). Validated and saved under the schedule lock. (cfg, error)."""
    fields = {k: v for k, v in dict(fields or {}).items() if k not in ("next", "next_ts")}
    out = {"err": None}
    def change(cfg):
        jobs = cfg.setdefault("jobs", [])
        cur = next((j for j in jobs if fields.get("id") and j.get("id") == fields["id"]), None)
        if fields.get("id") and cur is None and len(fields) <= 2 and "prompt" not in fields:
            out["err"] = "no such task"; return
        job = {**(cur or {}), **fields}
        if cur is None:
            job.setdefault("id", "job" + os.urandom(3).hex())
            job.setdefault("created", time.time()); job.setdefault("enabled", True)
            job.setdefault("created_by", "you")
        if not str(job.get("name", "")).strip(): job["name"] = str(job.get("prompt", "")).strip()[:40]
        for k in ("model", "agent", "sid", "project", "stop_at"):
            if k in fields and not fields[k]: job.pop(k, None)
        job, err = q.sched_validate(job)
        if err: out["err"] = err; return
        # a change to when it runs counts from now: a daily task moved to a time
        # earlier today must not fire at once as "missed"
        if cur is not None and any(k in fields for k in ("every", "at", "weekday", "n", "at_ts")):
            job["not_before"] = time.time()
            if job.get("every") == "once": job.pop("last_run", None)      # a finished one-off, given a new time
        elif cur is None:
            job["not_before"] = time.time()
        if cur is None: jobs.append(job)
        else: jobs[jobs.index(cur)] = job
    cfg = q.sched_update(change)
    if out["err"]:
        return None, out["err"]
    return cfg, None

def _job_model(job):
    if job.get("model"): return job["model"]
    st = STATES.get(job.get("sid") or "")
    if st is not None: return st.model
    if job.get("sid") and os.path.exists(q.session_path(job["sid"])):
        try: return json.load(open(q.session_path(job["sid"]))).get("model")
        except Exception: return None
    return None

def jobs_ready_to_start(now=None):
    """Due tasks that may start now. A task waits only when its own chat is answering,
    or when it would use the local model while that is busy -- not whenever any chat
    is answering (with many chats running at once, tasks used to wait for hours)."""
    busy = set(running_sids()) | set(JOBS_INFLIGHT)
    out = []
    for job in q.sched_load().get("jobs", []):
        if job.get("id") in busy or not q.sched_due(job, now): continue
        if job.get("sid") and job["sid"] in busy: continue
        try: local = q.model_is_local(_job_model(job))
        except Exception: local = False
        if local and q.slot_busy(): continue
        out.append(job)
    return out

def _job_minutes(job):
    """A job with stop_at ("06:00") must be done by then: its answer gets that
    long, and wraps up with a summary when time runs out."""
    return q.minutes_until(job["stop_at"]) if job.get("stop_at") else None

def _job_prompt(job):
    p = job.get("prompt", "")
    if job.get("stop_at"):
        p += (f"\n\n(You have until {job['stop_at']} — about {int(_job_minutes(job) or 0)} minutes. "
              "Pace the work to finish by then; don't start something you can't complete.)")
    return p

def run_job(job):
    """Execute one scheduled prompt — in the chat it was scheduled from, with
    that chat's history and context, or else in its own throwaway session."""
    sid = job.get("sid")
    st = get_state(sid) if sid and os.path.exists(q.session_path(sid)) else None
    if st is not None and not st.lock.acquire(blocking=False):
        # that chat is answering — you, or the previous run still going. Not
        # stamped as run, so the scheduler simply tries again next minute.
        return "skipped: that chat is busy"
    started = time.time()
    try:
        _stamp_started(job.get("id"))
    except Exception:
        # never leave the chat locked: a crash here used to hold its lock for
        # good, so the chat read as "running" forever and nothing could run in it
        if st is not None:
            try: st.lock.release()
            except RuntimeError: pass
        raise
    result_sid = None
    try:
        label = job.get("name") or job["id"]
        if st is not None:
            try:
                st.busy_since = time.time(); st.cancel.clear(); st.interrupt.clear()
                st.running = True
                st.live = {"thinking": "", "content": "", "tools": [],
                           "status": "", "done": False, "seq": 0}
                q.ACTIVE_PROJECT["id"] = st.project
                # the task's own model first: "run this in this chat on deepseek" means deepseek
                q.ACTIVE_MODEL["id"] = job.get("model") or st.model
                q.TURN_CTX.pin_model = q.TURN_CTX.model = job.get("model") or st.model
                _refresh_system(st)
                if not _is_engine_chat(st, job.get("model")):
                    st.msgs, _did, _pct = q.maybe_autocompact(st.msgs, sid=st.sid)
                n0 = len(st.msgs)
                prompt = (f"[Scheduled task “{label}”, running unattended at "
                          f"{time.strftime('%H:%M')}]\n{_job_prompt(job)}")
                st.refresh_tools()
                out = q.turn(st.msgs, prompt, st.tools, emit=_live_emitter(st),
                             approve=lambda *a: False, cancel=st.cancel,
                             inbox=st.inbox, interrupt=st.interrupt, sid=st.sid,
                             checkpoint=lambda: save_session(st), project=st.project,
                             max_minutes=_job_minutes(job), read_only=st.plan_mode)
                st.running = False
                save_session(st)
                if not _is_engine_chat(st): _learn_later(st, n0)     # Claude keeps its own memory
                result_sid = st.sid
            finally:
                st.live["done"] = True
                if st.running:
                    st.running = False
                    try: save_session(st)
                    except Exception: pass
                try: st.lock.release()
                except RuntimeError: pass
                threading.Thread(target=_drain, daemon=True).start()   # messages queued meanwhile
        else:
            pid = job.get("project") or None
            q.ACTIVE_PROJECT["id"] = pid
            # the job's own model; it used to run on whichever model the last chat had
            q.ACTIVE_MODEL["id"] = job.get("model") or None
            q.TURN_CTX.pin_model = q.TURN_CTX.model = job.get("model") or None
            msgs = [{"role": "system", "content": q.system_prompt_for(job.get("agent"), pid)}]
            specs, _ = q.active_tools(pid)
            tools = q.tools_for(job.get("agent"), specs)
            result_sid = "sched-" + time.strftime("%Y%m%d-%H%M%S")
            stop = JOB_RUNS[result_sid] = threading.Event()
            try:
                out = q.turn(msgs, _job_prompt(job), tools, approve=lambda *a: False, cancel=stop,
                             sid=result_sid, project=pid, max_minutes=_job_minutes(job),
                             checkpoint=lambda: q.session_save(result_sid, msgs, f"[scheduled] {label}",
                                                               {"project": pid} if pid else None))
            finally:
                JOB_RUNS.pop(result_sid, None)
                # filed under its project, so a project's scheduled runs sit with its chats
                q.session_save(result_sid, msgs, f"[scheduled] {label}", {"project": pid} if pid else None)
        result, ok = (out or "")[:400], True
        if not str(out or "").strip():
            # a run that ends with no answer is a failure, not a quiet success
            # (two overnight runs ended so and were recorded as "ok")
            result, ok = "The run ended without an answer — the model returned nothing. Open the chat to see how far it got.", False
    except Exception as e:
        import traceback
        _sched_log(f"job {job.get('id')} failed:\n{traceback.format_exc()}")
        result, ok = f"{type(e).__name__}: {e}", False
    def record(cfg):
        for j in cfg.get("jobs", []):
            if j.get("id") == job.get("id"):
                j["last_run"] = time.time(); j["last_ok"] = ok
                j["last_result"] = result; j["last_sid"] = result_sid
                j["seconds"] = round(time.time() - started, 1)
                # a one-off has had its run, and a repeat past its end is finished
                if j.get("every") == "once" or (j.get("until") and time.time() > float(j["until"])):
                    j["enabled"] = False
    q.sched_update(record)
    q._SESS_CACHE["key"] = None
    return result

def scheduler_loop():
    def _due_jobs():
        # a job waits only for its own chat, or for the local model when it needs it
        # (jobs_ready_to_start), plus a gap after the last answer; one start a minute
        if time.time() - q.GEN_STATE.get("ended", 0) < float(q.S.get("schedule_gap_min") or 0) * 60:
            return
        for job in jobs_ready_to_start():
            jid = job.get("id")
            # in its own thread: a scheduled job is a full model turn, and running
            # it here stalled every other chore for as long as it took
            JOBS_INFLIGHT.add(jid)
            def _go(j=job, i=jid):
                # every run leaves a line, and a crash its traceback: a pick-up run
                # once vanished with nothing to say why
                _sched_log(f"start {i} ({j.get('name')}) sid={j.get('sid')}")
                try:
                    r = run_job(j)
                    _sched_log(f"end   {i}: {str(r)[:200]}")
                except BaseException:
                    import traceback
                    _sched_log(f"CRASH {i}:\n{traceback.format_exc()}")
                finally: JOBS_INFLIGHT.discard(i)
            threading.Thread(target=_go, daemon=True).start()
            return                      # one job per minute at most; the next waits its turn

    def _watch_h2():
        if not q.S.get("watch_cluster_jobs"): return
        for f in q.cluster_poll().get("finished", []):
            q.LOG_SAFETY("h2_watch", {"job": f.get("id")}, "finished", f.get("name", ""))

    # Each chore is isolated: one blanket try meant a hiccup in the scheduler
    # silently cancelled the log redaction and the trash purge for that minute.
    chores = [("scheduled jobs", _due_jobs),
              ("cluster watch", _watch_h2),
              ("trash purge",    q.trash_purge),
              ("backup",         q.backup_auto),
              ("log redaction",  q.redact_server_log)]
    time.sleep(20)
    while True:
        for name, fn in chores:
            try: fn()
            except Exception as e:
                print(f"[maintenance] {name} failed: {type(e).__name__}: {e}", flush=True)
        time.sleep(60)

class Srv(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True

    def handle_error(self, request, client_address):
        # Browsers, health probes, and curl routinely close keep-alive sockets
        # after receiving their response. BaseServer prints a full traceback for
        # that harmless disconnect, burying real scheduler/model failures in the
        # UI log. Preserve normal tracebacks and silence only disconnect noise.
        if isinstance(sys.exc_info()[1], (BrokenPipeError, ConnectionResetError)):
            return
        super().handle_error(request, client_address)

_RESTART_WAITING = threading.Event()

def _restart_when_idle():
    """Restart once no chat is answering (checked every few seconds)."""
    if _RESTART_WAITING.is_set(): return
    _RESTART_WAITING.set()
    def wait():
        while running_sids() or JOBS_INFLIGHT:
            time.sleep(3)
        (q.CE.close_live(), q.CX.shutdown(), time.sleep(1), os._exit(0))
    threading.Thread(target=wait, daemon=True).start()

def _sched_log(msg):
    try:
        with open(os.path.join(q.LOGS, "scheduler.log"), "a") as f:
            f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n")
    except OSError:
        pass

def _already_serving(port):
    """Whether another Orbit is already listening on this port. A second copy
    (launchd's KeepAlive respawning one while another was started by hand)
    used to run the restart recovery before failing to bind -- treating every
    chat the live copy was answering as cut off, and booking a "pick up where
    it left off" run for it each time it was respawned."""
    import socket
    try:
        with socket.create_connection(("127.0.0.1", int(port)), timeout=1.5):
            return True
    except OSError:
        return False

if __name__ == "__main__":
    if _already_serving(PORT):
        print(f"Orbit is already running on port {PORT}; this copy is exiting "
              "without touching any chat.")
        time.sleep(30)          # don't let a KeepAlive respawn spin every second
        sys.exit(0)
    # This was never started: scheduled tasks only ever ran when you pressed
    # "run now", and the trash was never auto-purged.
    # before the scheduler starts, so a pick-up run it books is there to find
    try:
        for _sid, _resumed in q.recover_interrupted_sessions():
            print(f"  ! {_sid} was mid-answer when Orbit stopped — "
                  + ("picking it up again in a minute" if _resumed else "repaired, not restarted"))
    except Exception as e:
        print(f"  ! could not check for chats cut off mid-answer: {e}")
    threading.Thread(target=scheduler_loop, daemon=True).start()
    q.UI_PORT = PORT
    _start_gateway()
    # remote Claude Code sessions: any a previous run left open end now; idle ones close
    try: q.CE.end_leftover_live()
    except Exception as e: print(f"  ! leftover remote sessions: {e}")
    def _reap_remote():
        while True:
            time.sleep(60)
            try: q.CE.reap_live()
            except Exception: pass
    threading.Thread(target=_reap_remote, daemon=True).start()
    # model lists for harness providers, refreshed in the background once a day
    def _refresh_lists():
        try:
            for pid in q.HARN.providers(q.ROOT):
                if pid == "local": continue
                at = float((q.HARN.fetched(q.ROOT).get(pid) or {}).get("at") or 0)
                if time.time() - at > 86400: q.HARN.refresh_models(q.ROOT, pid, q.secrets_load())
        except Exception as e:
            print(f"  ! model list refresh: {e}")
        try:
            if time.time() - float((q.USAGE.limits_meta(q.ROOT) or {}).get("at") or 0) > 86400:
                q.USAGE.refresh_limits(q.ROOT)
        except Exception as e:
            print(f"  ! OpenCode Go usage limits: {e}")
    threading.Thread(target=_refresh_lists, daemon=True).start()
    def _resume_queues():
        # messages still queued when Orbit stopped: their chats carry on
        time.sleep(15)
        try: idx = json.load(open(QUEUE_INDEX))
        except Exception: idx = {}
        for qsid in list(idx):
            if os.path.exists(q.session_path(qsid)): get_state(qsid)
        _drain()
    threading.Thread(target=_resume_queues, daemon=True).start()
    def _schedule_ticker():
        # scheduled messages go out on time (checked every 15 s), not only when an answer ends
        time.sleep(20)
        while True:
            try:
                now = time.time()
                if any(it.get("at") and (_is_due(it, now) or now - float(it["at"]) > _schedule_grace())
                       for st in list(STATES.values()) for it in list(st.queue)):
                    _drain()
            except Exception as e:
                print(f"  ! scheduled messages: {type(e).__name__}: {e}", flush=True)
            time.sleep(15)
    threading.Thread(target=_schedule_ticker, daemon=True).start()
    threading.Thread(target=q.CE.history_items_cached, daemon=True).start()   # warm the sidebar
    mode = remote_mode()
    addrs = REMOTE.bind_addresses(mode)
    if mode != "off":
        REMOTE.load_token(q.ROOT, create=True)     # pairing needs one to exist
        REMOTE.advertise(PORT)
        atexit.register(REMOTE.stop_advertising)
        if mode == "tailscale":
            served = REMOTE.ensure_serve(PORT, root=q.ROOT)
            if served:
                print("  tailscale serve: https on " + ", ".join(f"{h}:{p}" for h, p in served))
    # One listener per address. Loopback is always first, so the desktop app is
    # never taken away by a remote-access setting.
    extra = []
    for a in addrs[1:]:
        try:
            srv = Srv((a, PORT), H)
            threading.Thread(target=srv.serve_forever, daemon=True).start()
            extra.append(a)
        except OSError as e:
            print(f"  ! could not listen on {a}: {e}")
    with Srv((addrs[0], PORT), H) as s:
        url = f"http://127.0.0.1:{PORT}"
        if mode != "off":
            print(f"  phone access: {mode} · listening on {', '.join(addrs)} "
                  f"({REMOTE.best_url(mode, PORT) or 'address pending'})")
        print(f"Orbit → {url}   ({len(S.tools)} tools)   root={q.ROOT}   Ctrl-C to stop")
        for n, e in S.tool_errors.items(): print(f"  ! MCP '{n}': {e}")
        if "--no-open" not in sys.argv: webbrowser.open(url)
        try: s.serve_forever()
        except KeyboardInterrupt: print("\nstopped")
