#!/usr/bin/env python3
"""orbit-ui — the browser front-end for Orbit: chats, models, settings, memory."""
import os, sys
# Run under the install's own venv wherever we were launched from — a bare
# `python3 bin/orbit` would otherwise miss every dependency.
_BIN = os.path.dirname(os.path.abspath(__file__))
_VENV = os.path.join(os.path.dirname(_BIN), "venv", "bin", "python")
if os.path.exists(_VENV) and os.path.realpath(sys.executable) != os.path.realpath(_VENV):
    os.execv(_VENV, [_VENV, os.path.abspath(__file__), *sys.argv[1:]])
import atexit, base64, http.server, urllib.parse as _up, json, os, queue, socketserver, sys, threading, time, uuid, webbrowser
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import qqcore as q
import file_links as FL

PORT = int(os.environ.get("ORBIT_UI_PORT") or os.environ.get("QQ_UI_PORT") or 8899)
import remote as REMOTE
import collections, re, subprocess

def remote_mode():
    return (q.S.get("remote_access") or {}).get("mode", "off")

_HOSTS = {"at": 0.0, "v": set()}

def allowed_hosts():
    """Cached for 30 s: working it out means asking `ipconfig` and `tailscale`,
    and a screenful of thumbnails is fifty requests in a second."""
    now = time.time()
    if now - _HOSTS["at"] > 30 or not _HOSTS["v"]:
        _HOSTS["v"] = REMOTE.reachable_hosts(remote_mode(), PORT)
        _HOSTS["at"] = now
    return _HOSTS["v"]

def allowed_origins():
    return {s + h for h in allowed_hosts() for s in ("http://", "https://")}
WEB  = os.path.join(q.ROOT, "web")
LOCK = threading.Lock()          # guards the registry itself
PENDING = {}                     # id -> {"event": Event, "allow": bool}
STATES = {}                      # sid -> State  (chats can run in parallel)
def _max_parallel():
    """How many chats may answer at once: no limit unless settings.json sets
    max_parallel. Remote models answer side by side; the local model is never
    shared -- its chats take turns (qqcore's slot), whatever this says."""
    try: n = int(q.S.get("max_parallel") or 0)
    except (TypeError, ValueError): n = 0
    return n if n > 0 else 10**6
_APPROVE_SEQ = [0]


def parse_multipart(rfile, ctype, length):
    """Minimal multipart/form-data parser (cgi was removed in Python 3.13).
    Returns (filename, bytes) for the first file part, or (None, None)."""
    if "boundary=" not in ctype: return None, None
    boundary = ctype.split("boundary=", 1)[1].strip().strip('"')
    data = rfile.read(int(length or 0))
    sep = ("--" + boundary).encode()
    for part in data.split(sep):
        if b"filename=" not in part: continue
        head, _, body = part.partition(b"\r\n\r\n")
        if not _: continue
        disp = head.decode("utf-8", "replace")
        fn = disp.split("filename=", 1)[1].split('"')[1] if 'filename="' in disp else "upload.bin"
        if not fn: continue
        return fn, body.rstrip(b"\r\n-")
    return None, None

def new_sid(): return time.strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:4]

class State:
    def __init__(self):
        self.sid   = new_sid()
        self.msgs  = [{"role": "system", "content": q.system_prompt()}]
        self.title = None
        self.agent = None
        self.temp = False          # temporary chat: never written to disk
        self.project = None
        self.sys_override = None   # per-chat system prompt
        self.tools, self.tool_errors = q.active_tools()
        self.lock = threading.Lock()   # one turn at a time *per chat*
        self.busy_since = 0
        self.cancel = threading.Event()
        # notes you send while it is answering, read at its next step; the
        # interrupt cuts a long generation short so a note isn't left waiting
        self.inbox = collections.deque()
        self.interrupt = threading.Event()
        # true while an answer runs, written into the chat file, so a restart
        # can tell which chats it cut off mid-answer
        self.running = False
        # live buffer: lets you switch away mid-answer and rejoin it later
        self.live = {"thinking": "", "content": "", "tools": [],
                     "status": "", "done": True, "seq": 0}
        self.flags = {}            # pin/archive/tags set before the first save
        self.model = None          # None = whatever the default model is
        self.plan_mode = False     # read-only: look and propose, change nothing
        # messages sent while it answers wait here, in order, each starting when the
        # one before it has been answered (unless sent "now", as a note mid-answer)
        self.queue = []
        self.queue_paused = False  # Stop pauses what is queued
    def reset(self):
        self.sid   = new_sid()
        self.msgs  = [{"role": "system", "content": q.system_prompt_for(self.agent, self.project)}]
        self.title = None
        self.temp = False
        self.sys_override = None
        # keep self.lock: replacing it while a turn holds it would break exclusion
        self.busy_since = 0
        self.cancel = threading.Event()
        self.inbox = collections.deque()
        self.interrupt = threading.Event()
        self.running = False
        self.live = {"thinking": "", "content": "", "tools": [],
                     "status": "", "done": True, "seq": 0}
        self.flags = {}
        self.model = None
        self.queue = []
        self.queue_paused = False
    def refresh_tools(self):
        specs, self.tool_errors = q.active_tools(self.project)
        self.tools = q.tools_for(self.agent, specs)

S = State()                        # the chat the browser is currently looking at

# Code is imported once at start, so edits to qqcore.py/qq-ui do not take effect
# until this process restarts. Record what we loaded so the UI can say so.
LOADED_AT = time.time()
# the server's own file is orbit-ui now; watching the old name "qq-ui" meant a
# change to the server was never flagged as needing a restart
CODE_FILES = [os.path.join(q.ROOT, "bin", "qqcore.py"),
              os.path.join(q.ROOT, "bin", "claude_engine.py"),
              os.path.join(q.ROOT, "bin", "orbit-ui"),
              os.path.join(q.ROOT, "web", "index.html"),
              # the other engines and helpers the server imports
              os.path.join(q.ROOT, "bin", "codex_engine.py"),
              os.path.join(q.ROOT, "bin", "responses_bridge.py"),
              os.path.join(q.ROOT, "bin", "harness_gateway.py"),
              os.path.join(q.ROOT, "bin", "file_links.py")]

def code_is_stale():
    newest, who = 0, None
    for f in CODE_FILES:
        try: m = os.path.getmtime(f)
        except OSError: continue
        if m > newest: newest, who = m, os.path.basename(f)
    # index.html is re-read per request, so only the python files force a restart
    stale = [os.path.basename(f) for f in CODE_FILES[:2] + CODE_FILES[4:]
             if os.path.exists(f) and os.path.getmtime(f) > LOADED_AT]
    try: page = os.path.getmtime(CODE_FILES[2])
    except OSError: page = 0
    return {"stale": bool(stale), "files": stale, "page_mtime": page,
            "loaded_at": LOADED_AT, "newest": newest, "newest_file": who}

def fresh_state(temp=False):
    """A new chat gets its own State object. Resetting the global one in place
    used to yank the state out from under a turn that was still generating, so
    its answer was written into the new chat -- or lost."""
    global S
    old = S
    st = State()
    st.agent, st.project = old.agent, old.project
    st.msgs = [{"role": "system", "content": q.system_prompt_for(st.agent, st.project)}]
    st.temp = temp
    if old.lock.locked():
        STATES.setdefault(old.sid, old)   # keep it reachable until it finishes
    STATES[st.sid] = st
    S = st
    prune_states()
    return st

def prune_states():
    """Drop finished chats you are no longer looking at, so STATES cannot grow
    without bound over a long session. Takes no lock: callers may hold it."""
    idle = [k for k, v in list(STATES.items())
            if v is not S and not v.lock.locked() and not v.queue]     # a queued or scheduled message keeps its chat
    for k in (idle[:-20] if len(idle) > 20 else []):
        STATES.pop(k, None)

def get_state(sid=None, create=True):
    """State for one conversation. Chats run independently, so a turn in one
    can continue while you read or ask something in another."""
    if not sid or sid == S.sid:
        STATES.setdefault(S.sid, S)
        return S
    with LOCK:
        st = STATES.get(sid)
        if st is None and create:
            st = State()
            st.sid = sid
            try:
                msgs, title = q.session_load(sid)
                st.msgs, st.title = msgs, title
                raw = json.load(open(q.session_path(sid)))
                if isinstance(raw, dict):
                    st.project = raw.get("project")
                    if raw.get("plan") and sid not in q.PLANS: q.PLANS[sid] = raw["plan"]
                    st.plan_mode = bool(raw.get("plan_mode"))
                    st.model = raw.get("model") or None
                    st.queue = list(raw.get("queue") or [])
                    st.queue_paused = bool(raw.get("queue_paused"))
            except Exception:
                pass
            STATES[sid] = st
        return st or S

JOB_RUNS = {}          # sid of a scheduled run in its own new chat -> its cancel Event

def running_sids():
    # scheduled runs in their own chat count too: they were invisible, so
    # nothing could show them running, stop them, or wait for them
    return [sid for sid, st in list(STATES.items()) if st.lock.locked()] + list(JOB_RUNS)

def jdump(o): return json.dumps(o, default=str)

def save_session(st=None):
    """No-op for temporary chats — they must leave no trace."""
    st = st or S
    if st.temp: return
    extra = {}
    try:
        old = json.load(open(q.session_path(st.sid)))
        if isinstance(old, dict):
            for k in ("pinned", "archived", "tags", "order"):
                if k in old: extra[k] = old[k]
    except Exception: pass
    extra.update(getattr(st, "flags", None) or {})   # pins set before the first save
    if getattr(st, "model", None): extra["model"] = st.model
    if st.sys_override: extra["sys_override"] = st.sys_override
    # always written, so taking a chat out of a project sticks; moving one in
    # from the sidebar updates the loaded state too (see /api/session/assign)
    extra["project"] = st.project
    if getattr(st, "running", False): extra["running_since"] = st.busy_since or time.time()
    pl = q.PLANS.get(st.sid)
    if pl and pl.get("steps"): extra["plan"] = pl       # the chat's plan survives a restart
    if getattr(st, "plan_mode", False): extra["plan_mode"] = True
    try:
        host = _chat_host(q.CE.marker_of(st.msgs) or {}, q.CE.chat_prefs(st.sid)) if q.CE.is_engine(
            q.current_model(st.model)) else None
        if host: extra["host"] = host
    except Exception:
        pass
    if getattr(st, "queue", None):
        extra["queue"] = st.queue
        if st.queue_paused: extra["queue_paused"] = True
    q.session_save(st.sid, st.msgs, st.title, extra)

class H(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def log_message(self, *a): pass

    def _send(self, code, body, ctype="application/json"):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code); self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b))); self.end_headers()
        try: self.wfile.write(b)
        except (BrokenPipeError, ConnectionResetError): pass

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        try: return json.loads(self.rfile.read(n) or "{}")
        except ValueError: return {}

    # ------------------------------------------------------------ GET
    # This server has no login, so anything a page can make your browser send here
    # runs with your full permissions. Refuse requests another site set in motion,
    # and refuse a Host we do not recognise (DNS rebinding).
    SAME_SITE = ("same-origin", "none")

    def _origin_ok(self):
        site = self.headers.get("Sec-Fetch-Site")
        if site and site not in self.SAME_SITE:
            return False
        origin = self.headers.get("Origin")
        if origin and origin not in allowed_origins():
            return False
        host = (self.headers.get("Host") or "").strip()
        if host and host not in allowed_hosts():
            return False
        return True

    def _from_loopback(self):
        peer = (self.client_address or ("",))[0]
        if peer not in ("127.0.0.1", "::1", "::ffff:127.0.0.1"):
            return False
        # Tailscale Serve hands a phone's request to us over loopback. The
        # forwarding headers say so; that phone is not you at the machine.
        return not (self.headers.get("X-Forwarded-For") or self.headers.get("Tailscale-User-Login"))

    def _token_ok(self):
        """A request off this machine must prove it was paired."""
        auth = self.headers.get("Authorization") or ""
        if auth.startswith("Bearer ") and REMOTE.token_matches(q.ROOT, auth[7:].strip()):
            return True
        if REMOTE.token_matches(q.ROOT, (self.headers.get("X-Orbit-Token") or "").strip()):
            return True
        # a phone browser keeps it in an HttpOnly cookie after one ?t= visit
        for part in (self.headers.get("Cookie") or "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == "orbit_token" and REMOTE.token_matches(q.ROOT, v.strip()):
                return True
        return False

    def _authorised(self):
        if self._from_loopback():
            return True                      # you, at the machine, as before
        if remote_mode() == "off":
            return False
        if self._token_ok():
            return True
        # the one exception: GET /?t=<token>, which is how a phone browser pairs.
        # The token is still verified — this only lets the request reach that check.
        if self.command == "GET" and self.path.startswith("/?t="):
            return True
        return False

    def _refuse_unauthorised(self):
        body = jdump({"error": "this Orbit needs pairing — scan the QR in "
                               "Settings -> Phone access"})
        b = body.encode()
        self.send_response(401)
        self.send_header("Content-Type", "application/json")
        self.send_header("WWW-Authenticate", 'Bearer realm="Orbit"')
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        try: self.wfile.write(b)
        except Exception: pass

    def _refuse_cross_site(self):
        self._send(403, jdump({"error": "cross-site request refused"}))

    def do_GET(self):
        if self.path.startswith("/fs/"):
            # a preview link: the token in it is the permission (one folder, read-only),
            # so a sandboxed page can load the images and scripts beside it
            host = (self.headers.get("Host") or "").strip()
            if host and host not in allowed_hosts(): return self._refuse_cross_site()
            return self._serve_granted()
        if not self._origin_ok(): return self._refuse_cross_site()
        if not self._authorised(): return self._refuse_unauthorised()
        try:
            return self._get(self.path.split("?")[0])
        except Exception as e:
            import traceback; traceback.print_exc()
            try: self._send(500, jdump({"error": f"{type(e).__name__}: {e}"}))
            except Exception: pass

    def _serve_granted(self):
        fp = FL.granted_file(self.path.split("?")[0])
        if not fp: return self._send(404, b"not found (or the preview link has expired)", "text/plain")
        return self._send_file(fp, FL.preview_headers(fp))

    def _send_file(self, fp, headers=None, download=False):
        try:
            size = os.path.getsize(fp)
            rng = self.headers.get("Range") or ""
            m = _re.match(r"bytes=(\d*)-(\d*)$", rng)
            start, end = 0, size - 1
            if m and (m.group(1) or m.group(2)):
                if m.group(1): start = int(m.group(1)); end = int(m.group(2)) if m.group(2) else size - 1
                else: start = max(0, size - int(m.group(2)))
                end = min(end, size - 1)
            with open(fp, "rb") as fh:
                fh.seek(start); body = fh.read(end - start + 1)
        except OSError:
            return self._send(404, b"not found", "text/plain")
        partial = bool(m and (m.group(1) or m.group(2)))
        self.send_response(206 if partial else 200)
        self.send_header("Content-Type", FL.mime_for(fp))
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Accept-Ranges", "bytes")
        if partial: self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        for k, v in (headers or {}).items(): self.send_header(k, v)
        if download:
            self.send_header("Content-Disposition", "attachment; filename*=UTF-8''" + _up.quote(os.path.basename(fp)))
        self.end_headers()
        try: self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError): pass

    def _get(self, _p):
        p = self.path.split("?")[0]
        if p == "/api/file":
            # a file a chat names, for an image in an answer, a preview or a download
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            sid = (qs.get("sid") or [""])[0]
            host, roots, changed = _chat_files_ctx(sid)
            info = FL.resolve((qs.get("path") or [""])[0], roots, changed)
            if not info.get("exists") or info.get("kind") != "file":
                return self._send(404, jdump({"error": "not found"}))
            if not info.get("servable"): return self._send(403, jdump({"error": "Orbit does not show this file in a page"}))
            return self._send_file(info["path"], FL.preview_headers(info["path"]), download=bool(qs.get("download")))
        if p == "/":
            # One visit to /?t=<token> stores it as an HttpOnly cookie, so the web
            # app works from a phone browser without the token sitting in history.
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            tok = (qs.get("t") or [""])[0]
            if tok and REMOTE.token_matches(q.ROOT, tok):
                self.send_response(303)
                self.send_header("Location", "/")
                self.send_header("Set-Cookie",
                                 f"orbit_token={tok}; Path=/; HttpOnly; SameSite=Lax; "
                                 f"Max-Age={365*24*3600}")
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            try: return self._send(200, open(os.path.join(WEB, "index.html"), "rb").read(),
                                   "text/html; charset=utf-8")
            except OSError: return self._send(500, "index.html missing", "text/plain")
        if p == "/api/info":
            return self._send(200, jdump({
                "tools": sorted(t["function"]["name"] for t in S.tools),
                "all_tools": q.all_known_tools(),
                "tool_errors": S.tool_errors, "root": q.ROOT, "sid": S.sid,
                "title": S.title, "settings": q.S, "status": q.server_status(),
                "agent": S.agent, "agents": q.agents_load()}))
        if p == "/manifest.json":
            return self._send(200, open(os.path.join(WEB, "manifest.json"), "rb").read(),
                              "application/manifest+json")
        if p.startswith("/icons/"):
            name = os.path.basename(p)          # basename: nothing escapes web/icons
            fp = os.path.join(WEB, "icons", name)
            if not name.endswith(".png") or not os.path.isfile(fp):
                return self._send(404, b"", "text/plain")
            self.send_response(200)
            self.send_header("Content-Type", "image/png")
            body = open(fp, "rb").read()
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "public, max-age=86400")
            self.end_headers()
            try: self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError): pass
            return
        if p == "/api/running":
            # chats answering now, and those waiting on you (an approval or a question)
            waiting = [sid_ for sid_, st_ in list(STATES.items())
                       if st_.lock.locked() and (st_.live.get("approval") or st_.live.get("question"))]
            return self._send(200, jdump({"running": running_sids(), "waiting": waiting,
                                          "max": (_max_parallel() if _max_parallel() < 10**6 else None)}))
        if p.startswith("/api/claude/config"):
            # your Claude setup, as Claude keeps it: settings, skills
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            cwd = (qs.get("cwd") or [None])[0]
            return self._send(200, jdump({
                "user": q.CE.read_claude_settings("user"),
                "project": q.CE.read_claude_settings("project", cwd) if cwd else {},
                "local": q.CE.read_claude_settings("local", cwd) if cwd else {},
                "paths": {"user": q.CE.claude_settings_path("user"),
                          "skills": os.path.join(q.CE.claude_dir(), "skills")},
                "skills": q.CE.skills_list()}))
        if p == "/api/claude/plugins":
            return self._send(200, jdump({**q.CE.plugins_list(), **q.CE.marketplaces_list()}))
        if p == "/api/claude/mcp":
            return self._send(200, jdump(q.CE.mcp_list()))
        if p == "/api/claude/commands":
            cat = q.CE.command_catalog()
            return self._send(200, jdump({"commands": [{"name": c.get("name"), "description": c.get("description"),
                                                        "argumentHint": c.get("argumentHint")}
                                                       for c in cat.get("commands") or []],
                                          "agents": cat.get("agents") or []}))
        if p == "/api/codex/info":
            return self._send(200, jdump(q.CX.info()))
        if p.startswith("/api/codex/models"):
            # the Codex mode picker: your ChatGPT account's models, or a provider's, as codex: ids
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            pid = (qs.get("provider") or [""])[0]
            cat = [m for m in q.model_catalogue() if m["id"].startswith("codex:")]
            models = [{"id": m["id"], "label": m.get("label") or m["model"], "context": m.get("context"),
                       "ready": m.get("ready")} for m in cat if m["model"].split("/")[0] == pid]
            label = "Your ChatGPT account (Codex)" if pid == "chatgpt" else next(
                (m.get("provider_label") for m in cat if m["model"].split("/")[0] == pid), pid)
            return self._send(200, jdump({"provider": pid, "label": label, "models": models,
                                          "ready": any(m["ready"] for m in models)}))
        if p.startswith("/api/harness/models"):
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            pid = (qs.get("provider") or [""])[0]
            provs = q.HARN.providers(q.ROOT, q.local_model_name())
            pr = provs.get(pid)
            if not pr: return self._send(404, jdump({"error": "no such provider"}))
            secrets_ = q.secrets_load()
            # a list older than a day is refreshed on the way (models.dev needs no key)
            if pid != "local" and time.time() - float(pr.get("fetched_at") or 0) > 86400:
                try:
                    q.HARN.refresh_models(q.ROOT, pid, secrets_)
                    pr = q.HARN.providers(q.ROOT, q.local_model_name()).get(pid)
                except Exception: pass
            hidden = set(q.HARN.load(q.ROOT)["hidden"])
            models = [{"id": (q.CE.BACKEND + ":default") if pid == "local" else f"harness:{pid}/{m['id']}",
                       "model": m["id"], "label": m.get("label") or m["id"], "context": m.get("context"),
                       "output": m.get("output"), "format": m.get("format"), "reasoning": m.get("reasoning"),
                       "hidden": f"harness:{pid}/{m['id']}" in hidden,
                       "usage": _usage_brief(pid, m["id"])} for m in pr["models"]]
            live = None
            if pid == "opencode-go":
                keys_ = q.HARN.account_keys(pr, secrets_, q.ROOT, pid)
                if keys_:
                    live = {"account": keys_[0]["label"],
                            **(q.USAGE.go_usage(keys_[0]["api_key"], keys_[0]["id"], q.ROOT) or {})}
            return self._send(200, jdump({"provider": pid, "label": pr["label"], "models": models, "live": live,
                                          "ready": q.HARN._ready(pid, pr, secrets_), "key": pr.get("key"),
                                          "fetched_at": pr.get("fetched_at")}))
        if p.split("?")[0] == "/api/harness":
            if "fresh=1" in self.path: q.HARN._LOGIN["at"] = 0      # "check again": ask claude now
            view = q.HARN.public_view(q.ROOT, q.secrets_load(), q.local_model_name())
            for pv in view["providers"]:
                for m in pv["models"]: m["usage"] = _usage_brief(pv["id"], m["id"])
                for a in pv.get("accounts") or []:
                    a["usage"] = q.USAGE.summary(q.ROOT, pv["id"], a["id"])
                    if pv["id"] == "opencode-go" and a.get("key_set"):
                        # the account's real allowance, from OpenCode itself
                        a["live"] = q.USAGE.go_usage(q.secrets_load().get(a["key"]) or os.environ.get(a["key"]),
                                                     a["id"], q.ROOT)
                        if a["live"] and not a["live"].get("error"):
                            a["exhausted"] = q.USAGE.exhausted(q.ROOT, pv["id"], a["id"])
            view["limits_at"] = (q.USAGE.limits_meta(q.ROOT) or {}).get("at")
            view["gateway"] = {"port": q.HARNESS_PORT, "error": GATEWAY["error"]}
            try:
                import harness_gateway
                view["gateway"]["stats"] = harness_gateway.STATS
            except Exception: pass
            return self._send(200, jdump(view))
        if p.startswith("/api/claude/memory"):
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            cwd = (qs.get("cwd") or [""])[0] or None
            sid_ = (qs.get("sid") or [""])[0]
            if not cwd and sid_:
                st_ = STATES.get(sid_)
                mk = q.CE.marker_of(st_.msgs if st_ else []) or {}
                cwd = mk.get("cwd") or q.CE.chat_prefs(sid_).get("cwd")
            cwd = cwd or q.WORKSPACE
            return self._send(200, jdump({"cwd": cwd, "instructions": q.CE.claude_instruction_files(cwd),
                                          "memory": q.CE.claude_memory(cwd), "folders": q.CE.claude_memory_folders(),
                                          "chat_instructions": q.CE.chat_prefs(sid_).get("instructions") if sid_ else None}))
        if p.split("?")[0] == "/api/claude/folders":
            # folders to start a chat in, per machine: your bookmarks, the ones you chose
            # lately, and (on this Mac) where Claude sessions ran and your projects
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            where = (qs.get("host") or [""])[0]
            marks = (q.S.get("folder_bookmarks") or {}).get(where) or []
            recent = [x for x in ((q.S.get("folder_recent") or {}).get(where) or []) if x not in marks]
            return self._send(200, jdump({"host": where, "bookmarks": marks, "recent": recent,
                                          "folders": [] if where else q.CE.recent_folders()}))
        if p.startswith("/api/claude/info"):
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            sid = (qs.get("sid") or [""])[0]
            st = STATES.get(sid)
            msgs = list(st.msgs) if st else (q.session_load(sid)[0] if os.path.exists(q.session_path(sid)) else [])
            mk = q.CE.marker_of(msgs) or {}
            spec = q.current_model((st.model if st else None) or None) or {}
            return self._send(200, jdump({
                "engine": q.CE.is_engine(spec) or q.CX.is_engine(spec), "codex": q.CX.is_engine(spec),
                "codex_thread": (q.CX.marker_of(msgs) or {}).get("thread") if q.CX.is_engine(spec) else None,
                "session": mk.get("session"), "cwd": mk.get("cwd") or ((q.CX.marker_of(msgs) or {}).get("cwd") if q.CX.is_engine(spec) else None),
                "skills": mk.get("skills") or [], "resume": q.CE.resume_command(msgs, spec),
                "transcript": q.CE.jsonl_path(mk.get("session"), mk.get("cwd")) if mk else None,
                "installed": bool(q.CE.which_claude()), "settings": q.CE.cfg(),
                "defaults": q.CE.DEFAULTS, "modes": q.CE.PERMISSION_MODES,
                "prefs": q.CE.chat_prefs(sid), "running": sid in q.CE.RUNS,
                "mode": (q.CE.RUNS.get(sid) or {}).get("mode"),
                "commands": [{"name": c.get("name"), "description": c.get("description"),
                              "argumentHint": c.get("argumentHint")} for c in (q.CE.INIT.get("commands") or [])],
                "tools": q.CE.INIT.get("tools") or [], "mcp": q.CE.INIT.get("mcp_servers") or [],
                "version": q.CE.INIT.get("claude_code_version"),
                "mcp_known": sorted(q.CE.user_mcp_servers()),
                "cwd_pref": q.CE.chat_prefs(sid).get("cwd"), "add_dirs": q.CE.chat_prefs(sid).get("add_dirs") or [],
                "host": _chat_host(mk, q.CE.chat_prefs(sid)),
                "cwd_default": (q.CE.default_remote_dir(_chat_host(mk, q.CE.chat_prefs(sid)))
                                if _chat_host(mk, q.CE.chat_prefs(sid)) else (q.CE.cfg().get("default_dir") or None)),
                "claude_default_mode": ((q.CE.read_claude_settings().get("permissions") or {}).get("defaultMode"))}))
        if p == "/api/code":
            return self._send(200, jdump(code_is_stale()))
        if p == "/api/remote/hosts":
            import ssh_remote
            saved = q.S.get("remote_hosts") or {}
            hosts = []
            for h in ssh_remote.config_hosts():
                pr = ssh_remote._PROBES.get(h)
                hosts.append({"host": h, "saved": saved.get(h) or {},
                              "probe": {k: v for k, v in (pr or {}).items() if k != "candidates"} if pr else None})
            return self._send(200, jdump({"hosts": hosts}))
        if p.startswith("/api/live/"):
            sid = p.rsplit("/", 1)[-1]
            st = STATES.get(sid)
            if not st:
                return self._send(200, jdump({"known": False, "running": False}))
            lv = _live_view(st)
            lv["known"] = True
            lv["running"] = st.lock.locked()
            lv["queue_n"] = len(st.queue)
            return self._send(200, jdump(lv))
        if p == "/api/status":
            st = q.server_status()
            st["context"] = q.context_state(S.msgs, S.sid)
            return self._send(200, jdump(st))
        if p == "/api/health":   return self._send(200, jdump(q.health_check()))
        if p == "/api/default_prompt":
            return self._send(200, jdump({"text": q.BASE_SYSTEM}))
        if p == "/api/context":
            return self._send(200, jdump(q.context_state(S.msgs, S.sid)))
        if p == "/api/sessions":
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            off = int((qs.get("offset") or [0])[0]); lim = int((qs.get("limit") or [80])[0])
            allx = q.session_list()
            return self._send(200, jdump({"items": allx[off:off+lim], "total": len(allx),
                                          "offset": off, "limit": lim}))
        if p == "/api/memory":   return self._send(200, jdump(q.memory_list()))
        if p.startswith("/api/memory/"):
            return self._send(200, jdump({"name": p.rsplit("/",1)[-1],
                                          "text": q.memory_read(p.rsplit("/",1)[-1])}))
        if p == "/api/instructions":
            return self._send(200, jdump({"text": q.read_instructions()}))
        if p == "/api/mcp":      return self._send(200, jdump(q.mcp_config()))
        if p == "/api/prompts":  return self._send(200, jdump(q.all_prompts()))
        if p == "/api/knowledge": return self._send(200, jdump(q.know_docs()))
        if p == "/api/skills":   return self._send(200, jdump(q.skills_list()))
        if p == "/api/remote":
            return self._send(200, jdump(REMOTE.status(q.ROOT, remote_mode(), PORT)))
        if p == "/api/remote/qr":
            png = REMOTE.pair_qr_png(q.ROOT, remote_mode(), PORT)
            if not png:
                return self._send(404, jdump({"error": "no reachable address yet"}))
            return self._send(200, png, "image/png")
        if p == "/api/models":
            return self._send(200, jdump({
                "models": q.model_catalogue(),
                "current": S.model or q.MODELS.load(q.ROOT).get("default") or "",
                "default": q.MODELS.load(q.ROOT).get("default") or "",
                "providers": q.MODELS.load(q.ROOT)["providers"],
                "keys": q.secrets_masked(), "harness_mode": bool(q.S.get("harness_mode")),
                "codex_mode": bool(q.S.get("codex_mode")) and not q.S.get("harness_mode"),
                "codex_recent": q.S.get("codex_recent") or [],
                "harness_recent": q.S.get("harness_recent") or []}))
        if p == "/api/projects":  return self._send(200, jdump(q.projects_load()))
        if p == "/api/stats":
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            try: days = max(1, min(int((qs.get("days") or ["7"])[0]), 36500))
            except ValueError: days = 7
            return self._send(200, jdump(q.usage_stats(days)))
        if p == "/api/about":
            return self._send(200, jdump({"version": q.VERSION, "github": q.GITHUB,
                "root": q.ROOT, "model": q.probe() or "stopped",
                "tools": sorted(t["function"]["name"] for t in S.tools),
                "counts": {"sessions": len(q.session_list()), "memories": len(q.memory_list()),
                           "skills": len(q.skills_list()), "knowledge": len(q.know_docs()),
                           "agents": len(q.agents_load()), "projects": len(q.projects_load()),
                           "files": len(q.list_files(limit=5000))}}))
        if p == "/api/trash":     return self._send(200, jdump(q.trash_list()))
        if p == "/api/backup/status": return self._send(200, jdump(q.backup_status()))
        if p == "/api/tags":      return self._send(200, jdump(q.all_tags()))
        if p == "/api/schedule":
            d = q.sched_load()
            for j in d.get("jobs", []): j["next"] = q.sched_next(j)
            return self._send(200, jdump(d))
        if p == "/api/secrets":   return self._send(200, jdump(q.secrets_masked()))
        if p == "/api/ledger":
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            sid = (qs.get("sid") or [None])[0]
            return self._send(200, jdump({"session": q.ledger_summary(sid or S.sid),
                                          "all": q.ledger_summary()}))
        if p == "/api/searchchats":
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            term = (qs.get("q") or [""])[0]
            return self._send(200, jdump(q.search_chats(term)))
        if p == "/api/state":
            return self._send(200, jdump({"sid": S.sid, "title": S.title, "temp": S.temp,
                                          "agent": S.agent, "sys_override": S.sys_override, "project": S.project}))
        if p == "/api/files":
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            off = int((qs.get("offset") or [0])[0]); lim = int((qs.get("limit") or [60])[0])
            prov = q.provenance()
            files = q.list_files(limit=5000)
            for f in files:
                pv = prov.get(f["rel"]) or {}
                f["from_sid"] = pv.get("sid"); f["from_title"] = pv.get("title")
            q.prune_thumbs()
            return self._send(200, jdump({"items": files[off:off+lim], "total": len(files),
                                          "offset": off, "limit": lim}))
        if p == "/api/checkpoints":
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            rel = (qs.get("rel") or [""])[0]
            path = os.path.join(q.WORKSPACE, rel)
            return self._send(200, jdump({"checkpoints": q.list_checkpoints(path)}))
        if p.startswith("/api/thumb/"):
            rel = _up.unquote(p[len("/api/thumb/"):])
            t = q.thumb_for(rel)
            if not t: return self._send(404, b"", "text/plain")
            return self._send(200, open(t, "rb").read(), "image/jpeg")
        if p.startswith("/api/skill/"):
            n = p.rsplit("/",1)[-1]
            return self._send(200, jdump({"name": n, "text": q.skill_read(n)}))
        if p == "/api/agents":   return self._send(200, jdump({"agents": q.agents_load(),
                                                               "active": S.agent}))
        if p.startswith("/vendor/"):
            fp = os.path.normpath(os.path.join(WEB, p.lstrip("/")))
            if not fp.startswith(os.path.join(WEB, "vendor")) or not os.path.exists(fp):
                return self._send(404, b"", "text/plain")
            ct = ("text/css" if fp.endswith(".css") else
                  "application/javascript" if fp.endswith(".js") else
                  "font/woff2" if fp.endswith(".woff2") else "application/octet-stream")
            return self._send(200, open(fp, "rb").read(), ct)
        if p == "/api/export":
            # ?id= exports that chat. Without it this always exported whatever chat
            # you happened to be viewing, so "export" on a sidebar row saved the
            # wrong conversation.
            qs = _up.parse_qs(self.path.split("?")[1]) if "?" in self.path else {}
            wanted = (qs.get("id") or [""])[0]
            msgs, title = S.msgs, S.title
            if wanted and wanted != S.sid:
                try: msgs, title = q.session_load(wanted)
                except Exception:
                    return self._send(404, jdump({"error": "no such chat"}))
            lines = []
            for m in render(msgs):
                lines.append(("## You\n\n" if m["role"]=="user" else "## Orbit\n\n") + m["text"])
            body = f"# {title or 'Chat'}\n\n" + "\n\n".join(lines)
            self.send_response(200)
            self.send_header("Content-Type","text/markdown; charset=utf-8")
            self.send_header("Content-Disposition",
                             f'attachment; filename="{(title or "chat")[:40].replace(chr(34),"")}.md"')
            b = body.encode(); self.send_header("Content-Length", str(len(b)))
            self.end_headers()
            try: self.wfile.write(b)
            except Exception: pass
            return
        if p.startswith("/api/stamp/"):
            # cheap "has anything changed?" for a client showing this chat:
            # message count, whether it is generating, and when it was last saved
            sid = p.rsplit("/", 1)[-1]
            if not sid:
                return self._send(400, jdump({"error": "which chat?"}))
            st = STATES.get(sid)
            if st is not None:
                n, running = len(st.msgs), st.lock.locked()
            else:
                try: n, running = len(q.session_load(sid)[0]), False
                except Exception: return self._send(404, jdump({"error": "no such chat"}))
            try: mtime = os.path.getmtime(q.session_path(sid))
            except OSError: mtime = 0
            return self._send(200, jdump({"sid": sid, "n": n, "running": running, "mtime": mtime,
                                          "seq": (st.live.get("seq") if st is not None else 0)}))
        if p.startswith("/api/peek/"):
            # read a chat without making it the open one — for a phone caching
            # conversations in the background, which must not move the desktop
            sid = p.rsplit("/", 1)[-1]
            if not sid:
                return self._send(400, jdump({"error": "which chat?"}))
            _claude_sync(sid)
            st = STATES.get(sid)
            if st is not None:
                msgs, title, running = list(st.msgs), st.title, st.lock.locked()
                # as /api/session: the step being written comes from the live buffer
                frm = st.live.get("from") if running else None
                if isinstance(frm, int) and 0 < frm <= len(msgs): msgs = msgs[:frm]
            else:
                try: msgs, title = q.session_load(sid)
                except Exception: return self._send(404, jdump({"error": "no such chat"}))
                running = False
            return self._send(200, jdump({"ok": True, "sid": sid, "title": title,
                                          "messages": render(msgs), "running": running}))
        if p.startswith("/api/session/"):
            sid = p.rsplit("/", 1)[-1]
            if not sid:
                return self._send(400, jdump({"error": "which chat?"}))
            _claude_sync(sid)
            if q.AGENT_SESSIONS.source_of(sid):
                st_ = STATES.get(sid)
                if not (st_ and st_.lock.locked()):
                    try: q.agent_session_open(sid)
                    except Exception as e: print(f"  ! opening {sid}: {type(e).__name__}: {e}")
            try:
                # Look the chat up by its own id. Mutating the global S here used to
                # hijack whichever chat was mid-answer, so its reply was appended to
                # — and saved over — the chat you had just clicked on.
                stt = get_state(sid)
                on_disk = os.path.exists(q.session_path(sid))
                if on_disk and not stt.lock.locked():   # never disturb a chat mid-answer
                    msgs, title = q.session_load(sid)
                    stt.sid, stt.msgs, stt.title = sid, msgs, title
                    try:
                        raw = json.load(open(q.session_path(sid)))
                        stt.project = raw.get("project") if isinstance(raw, dict) else None
                        if isinstance(raw, dict) and raw.get("plan") and sid not in q.PLANS:
                            q.PLANS[sid] = raw["plan"]
                        stt.plan_mode = bool(isinstance(raw, dict) and raw.get("plan_mode"))
                        stt.model = raw.get("model") if isinstance(raw, dict) else None
                        if isinstance(raw, dict):
                            stt.queue = list(raw.get("queue") or [])
                            stt.queue_paused = bool(raw.get("queue_paused"))
                    except Exception: stt.project, stt.model = None, None
                globals()["S"] = stt               # the chat the browser is looking at
                q.ACTIVE_PROJECT["id"] = stt.project
                msgs, title = list(stt.msgs), stt.title
                running = bool(stt and stt.lock.locked())
                live = _live_view(stt) if running else None
                # mid-answer, the step being written is drawn from the live
                # buffer, so the saved copy of it is left out here
                shown = msgs
                if live and isinstance(live.get("from"), int) and 0 < live["from"] <= len(msgs):
                    shown = msgs[:live["from"]]
                return self._send(200, jdump({"ok": True, "sid": sid, "title": title,
                                              "plan_mode": bool(getattr(stt, "plan_mode", False)),
                                              "messages": render(shown), "n": len(msgs),
                                              "context": q.context_state(msgs, sid),
                                              "running": running, "live": live,
                                              "queue": _queue_view(stt)}))
            except Exception as e:
                return self._send(404, jdump({"error": str(e)}))
        if p.startswith("/api/ws/"):
            rel = _up.unquote(p[len("/api/ws/"):])
            fp = os.path.normpath(os.path.join(q.WORKSPACE, rel))
            if not fp.startswith(os.path.abspath(q.WORKSPACE)) or not os.path.exists(fp):
                return self._send(404, b"", "text/plain")
            ext = fp.rsplit(".", 1)[-1].lower()
            ct = {"png":"image/png","jpg":"image/jpeg","jpeg":"image/jpeg","svg":"image/svg+xml",
                  "gif":"image/gif","webp":"image/webp"}.get(ext, "application/octet-stream")
            return self._send(200, open(fp, "rb").read(), ct)
        if p.startswith("/api/file/"):
            name = os.path.basename(p.rsplit("/", 1)[-1])
            fp = os.path.join(q.UPLOADS, name)
            if not os.path.exists(fp): return self._send(404, b"", "text/plain")
            ext = name.rsplit(".", 1)[-1].lower()
            ct = {"png":"image/png","jpg":"image/jpeg","jpeg":"image/jpeg",
                  "gif":"image/gif","webp":"image/webp"}.get(ext, "application/octet-stream")
            return self._send(200, open(fp, "rb").read(), ct)
        self._send(404, "{}")

    # ------------------------------------------------------------ POST
    def do_POST(self):
        if not self._origin_ok(): return self._refuse_cross_site()
        if not self._authorised(): return self._refuse_unauthorised()
        try:
            return self._post(self.path.split("?")[0])
        except Exception as e:
            import traceback; traceback.print_exc()
            try: self._send(500, jdump({"error": f"{type(e).__name__}: {e}"}))
            except Exception: pass

    def _post(self, _p):
        p = self.path.split("?")[0]
        if p == "/api/upload": return self._upload()
        if p == "/api/knowledge/upload": return self._upload(to_knowledge=True)
        if p == "/api/chat":   return self._chat()
        d = self._body()
        if p == "/api/new":
            with LOCK: q.reload_settings()
            fresh_state()
            # the project you are looking at in the sidebar, not whichever chat the
            # server last had open -- a new chat from "All chats" was landing in
            # the project of the chat you'd been in, with its rules and folder
            if "project" in d:
                with LOCK:
                    S.project = d.get("project") or None
                    q.ACTIVE_PROJECT["id"] = S.project
                    S.msgs[0]["content"] = q.system_prompt_for(S.agent, S.project)
            return self._send(200, jdump({"sid": S.sid, "project": S.project}))
        if p == "/api/compact":
            with LOCK:
                before = len(S.msgs)
                S.msgs, summary = q.compact(S.msgs)
                save_session()
            return self._send(200, jdump({"before": before, "after": len(S.msgs), "summary": summary}))
        if p == "/api/delete":
            did = d.get("id", "")
            q.CE.hide_history(did)          # a deleted Claude-Qwen chat stays out of the sidebar
            q.CE.close_live(did)            # and its remote session, if one is kept open
            q.AGENT_SESSIONS.hide(q.ROOT, did)      # and a Codex / OpenCode one
            return self._send(200, jdump({"ok": q.session_delete(did) or did.startswith("cq-")
                                          or bool(q.AGENT_SESSIONS.source_of(did))}))
        if p == "/api/claude/mode":
            # a chat's Claude Code permission mode: live if it is answering, and from now on
            return self._send(200, jdump(q.CE.set_permission_mode(d.get("sid", ""), d.get("mode", ""))))
        if p == "/api/claude/cwd":
            # the folder a chat's Claude session starts in (and extra folders it may use)
            sid_, cwd = d.get("sid", ""), (d.get("cwd") or "").strip()
            host = (d.get("host") or "").strip() or None      # a chat on another machine, over SSH ("" = this Mac)
            if host:
                import ssh_remote
                if not ssh_remote.valid_host(host):
                    return self._send(400, jdump({"error": f"not a host name: {host}"}))
                dirs = [str(x).strip() for x in (d.get("add_dirs") or []) if str(x).strip()]
            else:
                if cwd:
                    cwd = os.path.abspath(os.path.expanduser(cwd))
                    if not os.path.isdir(cwd):
                        return self._send(400, jdump({"error": f"no such folder: {cwd}"}))
                dirs = [os.path.abspath(os.path.expanduser(x)) for x in (d.get("add_dirs") or []) if str(x).strip()]
            prefs = q.CE.set_chat_pref(sid_, cwd=cwd or None, add_dirs=dirs or None)
            # "" is kept (this Mac, chosen), so a default host does not apply to this chat
            prefs = q.CE.set_chat_pref(sid_, host=host or "") if host or "host" in d else prefs
            if cwd:
                with LOCK:
                    cur = q.load_settings()
                    fr = cur.get("folder_recent") or {}
                    key = host or ""
                    fr[key] = ([cwd] + [x for x in (fr.get(key) or []) if x != cwd])[:15]
                    cur["folder_recent"] = fr
                    q.save_settings(cur); q.reload_settings()
            st = STATES.get(sid_)
            if st is not None and not st.temp and os.path.exists(q.session_path(sid_)):
                try: save_session(st)              # the sidebar shows where the chat runs
                except Exception: pass
            st = STATES.get(sid_)
            started = bool(q.CE.marker_of(st.msgs if st else []))
            return self._send(200, jdump({"ok": True, "prefs": prefs, "started": started}))
        if p == "/api/paths/resolve":
            # which names in an answer are real files, looked up where the chat works
            sid = d.get("sid") or ""
            names = [str(x) for x in (d.get("paths") or [])][:300]
            host, roots, changed = _chat_files_ctx(sid)
            if host:
                import ssh_remote
                cwd = roots[0] if roots else "~"
                found = ssh_remote.stat_paths(host, [FL.clean(n)[0] for n in names], cwd) if d.get("remote", True) else {}
                out = {}
                for n in names:
                    t, line = FL.clean(n); f = found.get(t)
                    out[n] = ({"input": n, "exists": True, "host": host, "line": line, "path": f["path"], "kind": f["kind"],
                               "size": f["size"], "mtime": f["mtime"], "name": os.path.basename(f["path"].rstrip("/")),
                               "category": FL.category(f["path"], f["kind"] == "folder"),
                               "ext": os.path.splitext(f["path"])[1].lower()} if f else
                              {"input": n, "exists": False, "host": host, "path": t})
                return self._send(200, jdump({"host": host, "cwd": cwd, "items": out}))
            items = {}
            for n in names:
                info = FL.resolve(n, roots, changed)
                if info.get("exists") and info.get("servable") and info.get("category") in ("image", "pdf", "html", "audio", "video"):
                    info["url"] = FL.grant(info["path"])
                items[n] = info
            return self._send(200, jdump({"host": None, "cwd": roots[0] if roots else None, "items": items}))
        if p == "/api/file/find":
            host, roots, _ = _chat_files_ctx(d.get("sid") or "")
            if host: return self._send(200, jdump({"items": []}))
            paths = FL.find_by_name(FL.clean(d.get("name") or "")[0], roots)
            return self._send(200, jdump({"items": [FL.describe(x) for x in paths]}))
        if p in ("/api/open_path", "/api/file/action"):
            # a file or folder named in a chat, handled on this Mac: opened in its usual
            # app (or one you pick), shown in Finder, Quick Look, copied. Anything that
            # would run (an app, a script) is only shown in Finder, never launched.
            sid = d.get("sid") or ""
            act = d.get("action") or ("reveal" if d.get("reveal") else "open")
            host, roots, changed = _chat_files_ctx(sid)
            raw = str(d.get("path") or "").strip()
            if not raw: return self._send(400, jdump({"error": "which file?"}))
            cache = os.path.join(q.ROOT, "cache", "remote-files")
            if (host or d.get("host")) and not os.path.abspath(os.path.expanduser(raw)).startswith(cache + os.sep):
                import ssh_remote
                host = d.get("host") or host
                if act in ("copy_path", "copy_scp"):
                    return self._send(200, jdump({"ok": True}))
                target = raw if raw.startswith(("/", "~")) else os.path.join(roots[0] if roots else "~", FL.clean(raw)[0])
                local, err = ssh_remote.fetch_file(host, FL.clean(target)[0], cache)
                if err: return self._send(200, jdump({"ok": False, "error": err}))
                raw, roots = local, []
            info = FL.resolve(raw, roots, changed)
            if not info.get("exists"):
                return self._send(404, jdump({"error": f"not found: {FL.clean(raw)[0][:200]}", "path": info.get("path")}))
            path = info["path"]
            if not _loopback_ok(self) and act not in ("preview", "info"):
                return self._send(403, jdump({"error": "that works only at the Mac itself"}))
            ok, why = True, ""
            if act in ("open", "reveal"):
                ok, why = FL.open_path(path, reveal=act == "reveal", line=d.get("line") or info.get("line"))
            elif act == "open_with":
                ok, why = FL.open_path(path, app=d.get("app"))
            elif act == "apps":
                return self._send(200, jdump({"ok": True, "apps": FL.open_with_apps(path), "info": info,
                                              "editor": bool(FL.editor_cli())}))
            elif act == "quicklook":
                ok = FL.quick_look(path); why = "Quick Look"
            elif act == "copy_file":
                ok, why = FL.copy_file(path)
            elif act == "terminal":
                ok = FL.open_terminal_at(path); why = "Terminal opened there"
            elif act == "preview":
                if not info.get("servable"): return self._send(200, jdump({"ok": False, "error": "Orbit does not show this file in a page"}))
                return self._send(200, jdump({"ok": True, "info": info, "url": FL.grant(path),
                                              "local_copy": path if host else None}))
            elif act == "render":
                # a document, spreadsheet, HEIC photo, archive… as something a page can show
                kind, out = FL.render_preview(path, os.path.join(q.ROOT, "cache", "previews"))
                if not kind: return self._send(200, jdump({"ok": False, "error": out}))
                return self._send(200, jdump({"ok": True, "kind": kind, "url": FL.grant(out), "info": info}))
            elif act == "info":
                return self._send(200, jdump({"ok": True, "info": info}))
            else:
                return self._send(400, jdump({"error": f"unknown action {act}"}))
            if not ok: return self._send(200, jdump({"ok": False, "error": why or "could not do that"}))
            return self._send(200, jdump({"ok": True, "path": path, "why": why, "revealed": act == "reveal" or "Finder" in why}))
        if p == "/api/run_in_terminal":
            if not _loopback_ok(self): return self._send(403, jdump({"error": "that works only at the Mac itself"}))
            host, roots, _ = _chat_files_ctx(d.get("sid") or "")
            cmd = str(d.get("command") or "")
            if host:
                import ssh_remote, shlex
                cwd = roots[0] if roots else "~"
                cmd = "ssh -t " + shlex.quote(host) + " " + shlex.quote(f"cd {cwd} && {cmd}; exec $SHELL -l")
                ok, why = FL.run_in_terminal(cmd)
            else:
                ok, why = FL.run_in_terminal(cmd, roots[0] if roots else None)
            return self._send(200, jdump({"ok": ok, "why": why, "error": None if ok else why}))
        if p == "/api/folders/bookmark":
            where, path = str(d.get("host") or ""), str(d.get("path") or "").strip()
            if not path: return self._send(400, jdump({"error": "which folder?"}))
            with LOCK:
                cur = q.load_settings()
                bm = cur.get("folder_bookmarks") or {}
                lst = [x for x in (bm.get(where) or []) if x != path]
                if d.get("on", True): lst.insert(0, path)
                if lst: bm[where] = lst[:40]
                else: bm.pop(where, None)
                cur["folder_bookmarks"] = bm
                q.save_settings(cur); q.reload_settings()
            return self._send(200, jdump({"ok": True, "bookmarks": bm.get(where) or []}))
        if p == "/api/remote/probe":
            import ssh_remote
            host = str(d.get("host") or "")
            if not ssh_remote.valid_host(host): return self._send(400, jdump({"error": "not a host name"}))
            return self._send(200, jdump(ssh_remote.probe(host, refresh=bool(d.get("refresh")))))
        if p == "/api/remote/ls":
            import ssh_remote
            host = str(d.get("host") or "")
            if not ssh_remote.valid_host(host): return self._send(400, jdump({"error": "not a host name"}))
            return self._send(200, jdump(ssh_remote.list_dir(host, str(d.get("path") or "~"))))
        if p == "/api/remote/save":
            # a host's defaults in Orbit: the folder new chats there start in
            with LOCK:
                cur = q.load_settings()
                rh = cur.get("remote_hosts") or {}
                h = str(d.get("host") or "")
                if d.get("remove"): rh.pop(h, None)
                else: rh[h] = {**(rh.get(h) or {}), **{k: d[k] for k in ("default_dir", "label") if k in d}}
                cur["remote_hosts"] = rh
                q.save_settings(cur); q.reload_settings()
            return self._send(200, jdump({"ok": True, "remote_hosts": rh}))
        if p == "/api/pick_folder":
            # the Mac's own folder chooser, on this Mac's screen (a phone gets the text field)
            start = os.path.expanduser(str(d.get("start") or "~"))
            if not os.path.isdir(start): start = os.path.expanduser("~")
            prompt = str(d.get("prompt") or "Choose a folder")[:120].replace('"', "'")
            script = ["-e", "set startAt to POSIX file " + json.dumps(start),
                      "-e", "tell current application to activate",
                      "-e", f'set f to choose folder with prompt "{prompt}" default location startAt',
                      "-e", "POSIX path of f"]
            try:
                r = subprocess.run(["osascript"] + script, capture_output=True, text=True, timeout=600)
            except subprocess.TimeoutExpired:
                return self._send(200, jdump({"cancelled": True}))
            path = (r.stdout or "").strip()
            if r.returncode != 0 or not path:
                return self._send(200, jdump({"cancelled": True, "error": (r.stderr or "").strip()[-200:]
                                              if "-128" not in (r.stderr or "") else ""}))
            return self._send(200, jdump({"path": path.rstrip("/") or "/"}))
        if p == "/api/harness/refresh":
            ids = [d["provider"]] if d.get("provider") else [k for k in q.HARN.providers(q.ROOT) if k != "local"]
            out = {}
            for pid in ids:
                try: out[pid] = q.HARN.refresh_models(q.ROOT, pid, q.secrets_load())
                except Exception as e: out[pid] = (0, f"{type(e).__name__}: {e}")
            return self._send(200, jdump({"ok": True, "results": out}))
        if p == "/api/harness/mode":
            # the mode: Orbit's own agent, Claude Code, or Codex. New chats, the model picker
            # and Settings follow it; each mode remembers the model you last used in it.
            engine = d.get("engine") or ("claude" if d.get("on") else "orbit")
            if engine not in ("orbit", "claude", "codex"): return self._send(400, jdump({"error": "unknown mode"}))
            with LOCK:
                cur = q.load_settings()
                reg = q.MODELS.load(q.ROOT)
                default = reg.get("default") or ""
                was = "codex" if default.startswith("codex:") else "claude" if default.startswith(("harness:", q.CE.BACKEND)) else "orbit"
                cur[{"orbit": "orbit_default", "claude": "harness_default", "codex": "codex_default"}[was]] = default
                if engine == "claude":
                    reg["default"] = cur.get("harness_default") or q.CE.BACKEND + ":default"
                elif engine == "codex":
                    reg["default"] = cur.get("codex_default") or next(
                        (m["id"] for m in q.CX.catalogue([]) if m.get("ready")), "codex:chatgpt/gpt-5.6-sol")
                else:
                    local = q.local_model_name()
                    reg["default"] = cur.get("orbit_default") or (q.MODELS.model_id("local", local) if local else "")
                cur["harness_mode"], cur["codex_mode"] = engine == "claude", engine == "codex"
                q.save_settings(cur); q.reload_settings()
                q.MODELS.save(q.ROOT, reg)
            q.CE._HIST["at"] = 0          # the sidebar's terminal sessions follow the mode (all of them in Claude Code mode)
            return self._send(200, jdump({"ok": True, "harness_mode": engine == "claude", "codex_mode": engine == "codex",
                                          "engine": engine, "default": reg["default"]}))
        if p == "/api/harness/save":
            # the registry: provider base URLs, custom providers, hidden models, contexts, proxy.
            # Keys are saved through /api/secrets/save, never here.
            cfg = q.HARN.load(q.ROOT)
            for k in ("providers", "contexts"):          # per-provider entries merge
                for pid, v in (d.get(k) or {}).items():
                    if v is None: cfg[k].pop(pid, None)
                    elif isinstance(v, dict): cfg[k][pid] = {**(cfg[k].get(pid) or {}), **v}
                    else: cfg[k][pid] = v
            for k in ("custom", "hidden", "proxy", "gateway_port"):
                if k in d: cfg[k] = d[k]
            return self._send(200, jdump({"ok": True, "saved": q.HARN.save(q.ROOT, cfg)}))
        if p == "/api/harness/account":
            # accounts are key names; their values are saved through /api/secrets/save
            pid, op = d.get("provider", ""), d.get("op", "")
            provs = q.HARN.providers(q.ROOT)
            pr = provs.get(pid)
            if not pr or pr.get("auth") in ("local", "subscription"):
                return self._send(404, jdump({"error": "no such provider"}))
            cfg = q.HARN.load(q.ROOT)
            over = cfg["providers"].setdefault(pid, {})
            accts = [dict(a) for a in (over.get("accounts") or q.HARN.accounts(pr))]
            aid = str(d.get("id") or "")
            if op == "add":
                label = str(d.get("label") or "").strip() or f"Account {len(accts) + 1}"
                base = pr.get("key") or pid.upper().replace("-", "_") + "_API_KEY"
                n = 2
                taken = {a["key"] for a in accts}
                while f"{base}_{n}" in taken: n += 1
                aid = f"a{int(time.time() * 1000) % 10**9}"
                accts.append({"id": aid, "label": label[:60], "key": f"{base}_{n}"})
            elif op == "remove":
                gone = next((a for a in accts if a["id"] == aid), None)
                if not gone: return self._send(404, jdump({"error": "no such account"}))
                accts = [a for a in accts if a["id"] != aid]
                # a key used by no other account or provider is removed from Orbit's secrets
                used = {a2["key"] for a2 in accts} | {pv.get("key") for pv in provs.values()}
                for pv_id, pv in provs.items():
                    if pv_id != pid: used |= {a2["key"] for a2 in q.HARN.accounts(pv)}
                if gone["key"] not in used:
                    merged = dict(q.secrets_load())          # merged: secrets_save writes the whole file
                    if merged.pop(gone["key"], None) is not None: q.secrets_save(merged)
                    os.environ.pop(gone["key"], None)
                if over.get("active") == aid: over.pop("active", None)
            elif op == "rename":
                for a in accts:
                    if a["id"] == aid: a["label"] = str(d.get("label") or a["label"])[:60]
            elif op == "activate":
                if not any(a["id"] == aid for a in accts): return self._send(404, jdump({"error": "no such account"}))
                over["active"] = aid
                q.USAGE.clear_exhausted(q.ROOT, pid, aid)
            elif op == "clear":
                q.USAGE.clear_exhausted(q.ROOT, pid, aid)
            else:
                return self._send(400, jdump({"error": f"unknown op {op}"}))
            over["accounts"] = accts
            q.HARN.save(q.ROOT, cfg)
            return self._send(200, jdump({"ok": True, "accounts": accts, "id": aid}))
        if p == "/api/harness/test":
            # one tiny request to a model, through the same route a chat uses
            spec = q.HARN.resolve(q.ROOT, d.get("id", ""), q.secrets_load(), q.local_model_name())
            if not spec: return self._send(404, jdump({"error": "no such model"}))
            t0 = time.time()
            try:
                out = q.stream_call([{"role": "user", "content": "Reply with the single word: ready"}], None,
                                    think=False, model="harness-direct:" + spec["model"]) \
                    if not spec["provider_cfg"].get("local") else \
                    q.stream_call([{"role": "user", "content": "Reply with the single word: ready"}], None,
                                  think=False, model=q.MODELS.model_id("local", q.local_model_name()))
                return self._send(200, jdump({"ok": True, "secs": round(time.time() - t0, 1),
                                              "reply": (out.get("content") or "")[:200]}))
            except Exception as e:
                return self._send(200, jdump({"ok": False, "error": f"{type(e).__name__}: {str(e)[:500]}"}))
        if p == "/api/claude/memory":
            op, cwd = d.get("op", ""), d.get("cwd") or None
            if op == "instructions": r = q.CE.save_claude_instructions(d.get("scope", "user"), d.get("text") or "", cwd)
            elif op == "save": r = q.CE.save_claude_memory(cwd, d.get("file"), d.get("text") or "")
            elif op == "delete": r = q.CE.delete_claude_memory(cwd, d.get("file"))
            elif op == "chat":
                r = {"ok": True, "prefs": q.CE.set_chat_pref(d.get("sid") or S.sid,
                                                             instructions=(d.get("text") or "").strip() or None)}
            else: r = {"error": f"unknown op {op}"}
            return self._send(200 if not r.get("error") else 400, jdump(r))
        if p == "/api/claude/claude_settings":
            return self._send(200, jdump({"ok": True, "settings": q.CE.write_claude_settings(
                d.get("patch") or {}, d.get("scope") or "user", d.get("cwd"))}))
        if p == "/api/claude/skills":
            op = d.get("op")
            if op == "toggle": r = q.CE.skill_set_enabled(d.get("name", ""), bool(d.get("on")))
            elif op == "install": r = q.CE.skill_install(d.get("source", ""), bool(d.get("overwrite")))
            elif op == "remove": r = q.CE.skill_remove(d.get("name", ""))
