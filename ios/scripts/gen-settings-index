#!/usr/bin/env python3
"""Write Orbit/Views/Settings/SettingsIndex+Generated.swift: Settings search's list of
pages and the words on each, read from the settings screens themselves.

Run on every build (project.yml, preBuildScripts), so a setting added to any page is
findable the day it is added -- the list used to be written by hand, and forgot.
Only writes the file when its content changes, so builds stay incremental.
"""
import os, re, sys

HERE = os.path.dirname(os.path.abspath(__file__))
APP = os.path.join(os.path.dirname(HERE), "Orbit")
VIEWS = os.path.join(APP, "Views")
OUT = os.path.join(VIEWS, "Settings", "SettingsIndex+Generated.swift")

LINK = re.compile(r'NavigationLink\s*\{\s*(\w+)\(\)\s*\}\s*label:\s*\{\s*Label\("([^"\\]+)"')
WORDS = re.compile(r'\b(?:Toggle|Picker|Text|LabeledContent|Section|Button|TextField|Stepper|Label|'
                   r'NavigationLink|DisclosureGroup|SecureField|DatePicker)\(\s*"([^"\\]{3,90})"')

def swift_files():
    for d, _, fs in os.walk(VIEWS):
        for f in fs:
            if f.endswith(".swift") and not f.startswith("SettingsIndex"):
                yield os.path.join(d, f)

def main():
    sources = {p: open(p, encoding="utf-8").read() for p in swift_files()}
    defined = {}                                   # struct name -> its file's text
    for p, src in sources.items():
        for name in re.findall(r"\bstruct\s+(\w+)\s*:\s*View\b", src):
            defined[name] = src
    mac = open(os.path.join(VIEWS, "Settings", "MacSettingsSection.swift"), encoding="utf-8").read()
    rows = []
    for view, title in LINK.findall(mac):
        src = defined.get(view, "")
        # the page's own words, and those of the settings views it shows (one level)
        seen_views = {view}
        texts = WORDS.findall(src)
        for sub in re.findall(r"\b([A-Z]\w+)\(", src):
            if sub in defined and sub not in seen_views and sub.endswith(("View", "Section", "Row", "Editor")):
                seen_views.add(sub)
                texts += WORDS.findall(defined[sub])
        words, keep = [], set()
        for t in texts:
            t = t.strip().lower()
            if t and t not in keep and "\\(" not in t:
                keep.add(t); words.append(t)
        blob = " · ".join(words)[:3000].replace('"', "'")
        rows.append(f'        .init(title: "{title}", place: "Settings on the Mac", words: "{blob}",\n'
                    f'              target: page({view}())),')
    out = ("// Generated by scripts/gen-settings-index on every build -- do not edit by hand.\n"
           "// Each page of the Mac's settings, and the words on it, for Settings search.\n\n"
           "import SwiftUI\n\nextension SettingsIndex {\n"
           "    static let generated: [SettingsSearchEntry] = [\n" + "\n".join(rows) + "\n    ]\n}\n")
    try:
        if open(OUT, encoding="utf-8").read() == out: return 0
    except OSError:
        pass
    with open(OUT, "w", encoding="utf-8") as f: f.write(out)
    print(f"settings index: {len(rows)} pages", file=sys.stderr)
    return 0

if __name__ == "__main__":
    sys.exit(main())
